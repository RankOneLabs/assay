diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..330d42c8dd0db3fd7b630ae3e4643c927875d6c3
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,90 @@
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { insertBrief } from "../../db/briefs";
+import { recordStageRun } from "../../db/stage-runs";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+let dispatchCalls: string[];
+let dispatcher: Dispatcher;
+
+function buildApp() {
+  const app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher });
+  return app;
+}
+
+function addBrief(id: string, cohortId: string, status: "pending_approval" | "approved" = "approved") {
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES (?, ?, ?)").run(`p-${id}`, "project", `/tmp/${id}`);
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES (?, ?, ?)").run(`s-${id}`, `p-${id}`, "spec");
+  db.prepare("INSERT INTO plans (id, spec_id) VALUES (?, ?)").run(`pl-${id}`, `s-${id}`);
+  const cohortExists = db.prepare("SELECT 1 FROM cohorts WHERE id = ?").get(cohortId);
+  if (!cohortExists) {
+    db.prepare("INSERT INTO cohorts (id, plan_id, title, position) VALUES (?, ?, ?, 0)").run(cohortId, `pl-${id}`, "cohort");
+  }
+  const brief = insertBrief(db, {
+    id,
+    cohort_id: cohortId,
+    goal: "goal",
+    files_in_scope: [],
+    decisions_made: [],
+    approaches_rejected: [],
+    next_action: "next",
+  });
+  if (status === "approved") db.prepare("UPDATE briefs SET status = 'approved' WHERE id = ?").run(id);
+  return brief;
+}
+
+beforeEach(() => {
+  db = openTestDb();
+  dispatchCalls = [];
+  dispatcher = {
+    dispatch: async (_stage, inputId) => {
+      dispatchCalls.push(inputId);
+      return `session-${inputId}`;
+    },
+    status: async () => "running",
+  };
+});
+
+afterEach(() => db.close());
+
+describe("POST /briefs/:id/build", () => {
+  test("returns 404 when the brief does not exist", async () => {
+    const res = await buildApp().request("/briefs/missing/build", { method: "POST" });
+    expect(res.status).toBe(404);
+    expect(dispatchCalls).toEqual([]);
+  });
+
+  test("requires an approved brief", async () => {
+    addBrief("brief-pending", "cohort-pending", "pending_approval");
+    const res = await buildApp().request("/briefs/brief-pending/build", { method: "POST" });
+    expect(res.status).toBe(409);
+    expect(dispatchCalls).toEqual([]);
+  });
+
+  test("dispatches an approved brief and returns the session reference", async () => {
+    addBrief("brief-approved", "cohort-approved");
+    const res = await buildApp().request("/briefs/brief-approved/build", { method: "POST" });
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "session-brief-approved" });
+    expect(dispatchCalls).toEqual(["brief-approved"]);
+  });
+
+  test("rejects a second build while one for the cohort is running", async () => {
+    addBrief("brief-existing", "cohort-shared");
+    addBrief("brief-current", "cohort-shared");
+    recordStageRun(db, {
+      stage: "build",
+      input_artifact_type: "brief",
+      input_artifact_id: "brief-existing",
+      session_ref: "existing-session",
+    });
+    const res = await buildApp().request("/briefs/brief-current/build", { method: "POST" });
+    expect(res.status).toBe(409);
+    expect(dispatchCalls).toEqual([]);
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2116a79043d35edd01edeafcb105bf00ce34d6ee
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,74 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+
+interface BuildsRouteDeps {
+  dispatcher: Dispatcher;
+  db: Database;
+}
+
+interface BuildRunRow {
+  session_ref: string;
+}
+
+/** Routes for explicitly starting a build from an approved brief. */
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Stage-run rows are persisted after the asynchronous dispatch completes;
+  // this reservation closes the small same-process window before that row is
+  // visible to another request.
+  const dispatchingCohorts = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    if (dispatchingCohorts.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    const existingRuns = db
+      .prepare<BuildRunRow, [string]>(
+        `SELECT sr.session_ref
+           FROM stage_runs sr
+           JOIN briefs b ON b.id = sr.input_artifact_id
+          WHERE sr.stage = 'build'
+            AND sr.input_artifact_type = 'brief'
+            AND b.cohort_id = ?
+          ORDER BY sr.id DESC`,
+      )
+      .all(brief.cohort_id);
+
+    // A prior completed/failed run does not prevent an explicit retry. The
+    // dispatcher checks the owning backend's live session state. If a custom
+    // dispatcher has no status method, conservatively block duplicate runs.
+    for (const run of existingRuns) {
+      const status = dispatcher.status
+        ? await dispatcher.status("build", run.session_ref)
+        : "running";
+      if (status === "running") {
+        return c.json({ error: "a build is already running for this cohort" }, 409);
+      }
+    }
+
+    // Another request may have completed an asynchronous status lookup while
+    // this request was awaiting one, so recheck before reserving the cohort.
+    if (dispatchingCohorts.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+    dispatchingCohorts.add(brief.cohort_id);
+    try {
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to dispatch build" }, 500);
+    } finally {
+      dispatchingCohorts.delete(brief.cohort_id);
+    }
+  });
+}
