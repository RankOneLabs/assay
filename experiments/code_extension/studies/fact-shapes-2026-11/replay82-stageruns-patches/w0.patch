index 0000000000000000000000000000000000000000..3957dd41ed2b6230df2ae198d2f9a1ef46d12dcc
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,68 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+
+function setup(lifecycleRunning = false) {
+  const db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES (?, ?, ?)").run("p", "project", "/tmp/project");
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES (?, ?, ?)").run("s", "p", "Spec");
+  db.prepare("INSERT INTO plans (id, spec_id, status) VALUES (?, ?, 'approved')").run("pl", "s");
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position, status) VALUES (?, ?, ?, ?, 'building')").run("c", "pl", "Cohort", 1);
+  db.prepare(`INSERT INTO briefs
+    (id, cohort_id, status, goal, files_in_scope, decisions_made, approaches_rejected, next_action)
+    VALUES ('b', 'c', 'approved', 'goal', '[]', '[]', '[]', 'start')`).run();
+  let dispatched: [string, string] | null = null;
+  const app = new Hono();
+  mountBuildsRoutes(app, {
+    db,
+    dispatcher: {
+      dispatch: async (stage, inputId) => {
+        dispatched = [stage, inputId];
+        return "session-ref";
+      },
+      isBuildRunning: async () => lifecycleRunning,
+    },
+  });
+  return { app, db, getDispatched: () => dispatched };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("returns 404 for missing brief", async () => {
+    const { app, db } = setup();
+    const response = await app.request("/briefs/missing/build", { method: "POST" });
+    expect(response.status).toBe(404);
+    db.close();
+  });
+
+  test("requires an approved brief", async () => {
+    const { app, db } = setup();
+    db.prepare("UPDATE briefs SET status = 'pending_approval' WHERE id = 'b'").run();
+    const response = await app.request("/briefs/b/build", { method: "POST" });
+    expect(response.status).toBe(409);
+    db.close();
+  });
+
+  test("rejects another active build for the cohort", async () => {
+    const { app, db } = setup();
+    void app;
+    // Lifecycle says there is an active session for the previous run.
+    const runningApp = new Hono();
+    mountBuildsRoutes(runningApp, {
+      db,
+      dispatcher: { dispatch: async () => "unused", isBuildRunning: async () => true },
+    });
+    const response = await runningApp.request("/briefs/b/build", { method: "POST" });
+    expect(response.status).toBe(409);
+    db.close();
+  });
+
+  test("dispatches build and returns session_ref", async () => {
+    const { app, db, getDispatched } = setup();
+    const response = await app.request("/briefs/b/build", { method: "POST" });
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ session_ref: "session-ref" });
+    expect(getDispatched()).toEqual(["build", "b"]);
+    db.close();
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
