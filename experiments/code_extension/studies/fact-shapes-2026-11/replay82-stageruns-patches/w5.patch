diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6b1108a5891161902b0e9a45b17bbfba4acab40a
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,50 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { insertProject } from "../../db/projects";
+import { insertSpec } from "../../db/specs";
+import { insertPlan } from "../../db/plans";
+import { insertCohort } from "../../db/cohorts";
+import { insertBrief } from "../../db/briefs";
+import { recordStageRun } from "../../db/stage-runs";
+import { mountBuildsRoutes } from "./builds";
+
+describe("POST /briefs/:id/build", () => {
+  test("validates brief and duplicate live cohort runs", async () => {
+    const db = openTestDb();
+    try {
+      insertProject(db, { id: "p", name: "P", repo_path: "/tmp" });
+      insertSpec(db, { id: "s", project_id: "p", title: "S", notes: null });
+      insertPlan(db, { id: "pl", spec_id: "s" });
+      insertCohort(db, { id: "c", plan_id: "pl", title: "C", position: 0 });
+      insertBrief(db, { id: "b", cohort_id: "c", goal: "G", files_in_scope: [], decisions_made: [], approaches_rejected: [], next_action: "N" });
+      db.prepare("UPDATE briefs SET status = 'approved' WHERE id = 'b'").run();
+
+      let running = true;
+      const calls: string[] = [];
+      const app = new Hono();
+      mountBuildsRoutes(app, {
+        db,
+        dispatcher: {
+          dispatch: async (stage, id) => { calls.push(`${stage}:${id}`); return "session-1"; },
+          isRunning: async () => running,
+        },
+      });
+
+      expect((await app.request("/briefs/no/build", { method: "POST" })).status).toBe(404);
+      db.prepare("UPDATE briefs SET status = 'pending_approval' WHERE id = 'b'").run();
+      expect((await app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+      db.prepare("UPDATE briefs SET status = 'approved' WHERE id = 'b'").run();
+
+      recordStageRun(db, { stage: "build", input_artifact_type: "brief", input_artifact_id: "b", session_ref: "session-old" });
+      expect((await app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+      running = false;
+      const result = await app.request("/briefs/b/build", { method: "POST" });
+      expect(result.status).toBe(200);
+      expect(await result.json()).toEqual({ session_ref: "session-1" });
+      expect(calls).toEqual(["build:b"]);
+    } finally {
+      db.close();
+    }
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..53be85959f188ccfd100cdd03d3666e10d8e324b
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,52 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import type { createDispatcher } from "../../orchestrator/backends/dispatcher";
+import { getBrief } from "../../db/briefs";
+
+type Dispatcher = Pick<ReturnType<typeof createDispatcher>, "dispatch"> & {
+  isRunning?: (stageName: string, inputId: string) => Promise<boolean>;
+};
+
+interface BuildsRouteDeps {
+  dispatcher: Dispatcher;
+  db: Database;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief is not approved" }, 409);
+    }
+
+    const runs = db.prepare<{ input_artifact_id: string }, [string]>(
+      `SELECT sr.input_artifact_id
+         FROM stage_runs sr
+         JOIN briefs b ON b.id = sr.input_artifact_id
+        WHERE sr.stage = 'build' AND sr.input_artifact_type = 'brief' AND b.cohort_id = ?`,
+    ).all(brief.cohort_id);
+
+    let alreadyRunning = false;
+    if (dispatcher.isRunning) {
+      for (const run of runs) {
+        if (await dispatcher.isRunning("build", run.input_artifact_id)) {
+          alreadyRunning = true;
+          break;
+        }
+      }
+    }
+    if (alreadyRunning) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    try {
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    }
+  });
+}
