diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3697b787de90a4f49821ecde33b298c30b1cf6a6
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,67 @@
+import { afterEach, describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { recordStageRun } from "../../db/stage-runs";
+import { mountBuildsRoutes, type BuildDispatcher } from "./builds";
+import type { Database } from "bun:sqlite";
+
+let db: Database;
+const cohortId = "cohort-1";
+const briefId = "brief-1";
+
+function setup(status?: () => Promise<"running" | "completed" | "failed">) {
+  db = openTestDb();
+  db.exec(`
+    INSERT INTO projects (id, name, repo_path) VALUES ('project-1', 'Project', '/tmp/project');
+    INSERT INTO specs (id, project_id, title) VALUES ('spec-1', 'project-1', 'Spec');
+    INSERT INTO plans (id, spec_id, status) VALUES ('plan-1', 'spec-1', 'approved');
+    INSERT INTO cohorts (id, plan_id, title, position, status)
+      VALUES ('${cohortId}', 'plan-1', 'Cohort', 0, 'building');
+    INSERT INTO briefs (id, cohort_id, status, goal)
+      VALUES ('${briefId}', '${cohortId}', 'approved', 'Build it');
+  `);
+  const calls: Array<[string, string]> = [];
+  const dispatcher: BuildDispatcher = {
+    dispatch: async (stage, id) => {
+      calls.push([stage, id]);
+      return "session-1";
+    },
+    ...(status ? { status } : {}),
+  };
+  const app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher });
+  return { app, calls };
+}
+
+afterEach(() => db?.close());
+
+describe("POST /briefs/:id/build", () => {
+  test("404s a missing brief and rejects briefs that are not approved", async () => {
+    const { app, calls } = setup();
+    expect((await app.request("/briefs/missing/build", { method: "POST" })).status).toBe(404);
+    db.prepare("UPDATE briefs SET status = 'pending_approval' WHERE id = ?").run(briefId);
+    expect((await app.request(`/briefs/${briefId}/build`, { method: "POST" })).status).toBe(409);
+    expect(calls).toEqual([]);
+  });
+
+  test("dispatches an approved brief and returns its session reference", async () => {
+    const { app, calls } = setup();
+    const response = await app.request(`/briefs/${briefId}/build`, { method: "POST" });
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ session_ref: "session-1" });
+    expect(calls).toEqual([["build", briefId]]);
+  });
+
+  test("blocks a build when another build for the cohort is running", async () => {
+    const { app, calls } = setup(async () => "running");
+    recordStageRun(db, {
+      stage: "build",
+      input_artifact_type: "brief",
+      input_artifact_id: briefId,
+      session_ref: "old-session",
+    });
+    const response = await app.request(`/briefs/${briefId}/build`, { method: "POST" });
+    expect(response.status).toBe(409);
+    expect(calls).toEqual([]);
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ddd8b3547eab3206fa4cf71a2025bd8a5e751852
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,77 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+
+export interface BuildDispatcher {
+  dispatch(stageName: string, inputId: string): Promise<string>;
+  /** Optional lifecycle query, provided by the production dispatcher. */
+  status?(sessionRef: string): Promise<"running" | "completed" | "failed">;
+}
+
+interface BuildsRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+interface ExistingBuildRow {
+  session_ref: string;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Protect the gap between checking prior runs and recording the new run,
+  // since dispatch() is asynchronous and two HTTP requests can overlap.
+  const startingCohorts = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    // Stage runs are keyed by brief, but builds are serialized at cohort
+    // level: another approved/reopened brief for the same cohort must not
+    // start a second build while an earlier one is still running.
+    if (startingCohorts.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    // Claim before any asynchronous lifecycle checks so concurrent requests
+    // cannot both pass the check and launch a session.
+    startingCohorts.add(brief.cohort_id);
+    try {
+      const priorRuns = db
+        .prepare<ExistingBuildRow, [string]>(
+          `SELECT sr.session_ref
+             FROM stage_runs sr
+             JOIN briefs b ON b.id = sr.input_artifact_id
+            WHERE sr.stage = 'build' AND sr.input_artifact_type = 'brief'
+              AND b.cohort_id = ?
+            ORDER BY sr.id DESC`,
+        )
+        .all(brief.cohort_id);
+
+      for (const run of priorRuns) {
+        // Production can distinguish an active run from a completed historical
+        // run. A minimal injected dispatcher without status support treats an
+        // existing run as active, which is also the conservative behavior for
+        // callers that cannot report lifecycle state.
+        const status = dispatcher.status
+          ? await dispatcher.status(run.session_ref)
+          : "running";
+        if (status === "running") {
+          return c.json({ error: "a build is already running for this cohort" }, 409);
+        }
+      }
+
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    } finally {
+      startingCohorts.delete(brief.cohort_id);
+    }
+  });
+}
