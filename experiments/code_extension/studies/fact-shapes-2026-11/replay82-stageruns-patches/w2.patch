diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e7fb20d5f69c44b54662c84f3894d8735ce9b1e2
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,51 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+import { listStageRuns } from "../../db/stage-runs";
+
+export interface BuildDispatcher {
+  dispatch(stageName: string, inputId: string): Promise<string>;
+  /** Optional for lightweight test doubles; production dispatchers expose this. */
+  status?(sessionRef: string): Promise<"running" | "completed" | "failed">;
+}
+
+interface BuildsRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "brief not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    // Builds are recorded against briefs, but the concurrency invariant is
+    // cohort-wide: a newer/revised brief must not start another build while
+    // an earlier brief from that cohort is still being built.
+    const cohortBriefs = db
+      .prepare<{ id: string }, [string]>("SELECT id FROM briefs WHERE cohort_id = ?")
+      .all(brief.cohort_id);
+    for (const cohortBrief of cohortBriefs) {
+      for (const run of listStageRuns(db, "build", cohortBrief.id)) {
+        // In production the dispatcher can distinguish a live session from a
+        // completed historical run. Test doubles without status conservatively
+        // treat an existing run as active to avoid duplicate dispatches.
+        if (!dispatcher.status || await dispatcher.status(run.session_ref) === "running") {
+          return c.json({ error: "a build is already running for this cohort" }, 409);
+        }
+      }
+    }
+
+    try {
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    }
+  });
+}
