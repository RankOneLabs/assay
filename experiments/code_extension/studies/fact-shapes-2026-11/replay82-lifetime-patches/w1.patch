diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1d11a4b361242e4bd23dd1e6b72fc9fd55a4f012
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,78 @@
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { insertProject } from "../../db/projects";
+import { insertSpec } from "../../db/specs";
+import { insertPlan } from "../../db/plans";
+import { insertCohort } from "../../db/cohorts";
+import { insertBrief } from "../../db/briefs";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+let app: Hono;
+let dispatchCalls: string[][];
+let buildRunning: boolean;
+const briefId = "brief-test";
+
+beforeEach(() => {
+  db = openTestDb();
+  dispatchCalls = [];
+  buildRunning = false;
+  const project = insertProject(db, { id: "project-test", name: "test", repo_path: "/tmp/test" });
+  const spec = insertSpec(db, { id: "spec-test", project_id: project.id, title: "spec" });
+  const plan = insertPlan(db, { id: "plan-test", spec_id: spec.id });
+  const cohort = insertCohort(db, { id: "cohort-test", plan_id: plan.id, title: "cohort", position: 1 });
+  insertBrief(db, {
+    id: briefId,
+    cohort_id: cohort.id,
+    goal: "goal",
+    files_in_scope: [],
+    decisions_made: [],
+    approaches_rejected: [],
+    next_action: "next",
+  });
+  db.prepare("UPDATE briefs SET status = 'approved' WHERE id = ?").run(briefId);
+  app = new Hono();
+  mountBuildsRoutes(app, {
+    db,
+    dispatcher: {
+      dispatch: async (stage, id) => {
+        dispatchCalls.push([stage, id]);
+        return "session-123";
+      },
+      isBuildRunning: async () => buildRunning,
+    },
+  });
+});
+
+afterEach(() => db.close());
+
+const build = (id = briefId) => app.request(`/briefs/${id}/build`, { method: "POST" });
+
+describe("POST /briefs/:id/build", () => {
+  test("returns 404 for a missing brief", async () => {
+    const response = await build("missing");
+    expect(response.status).toBe(404);
+    expect(dispatchCalls).toHaveLength(0);
+  });
+
+  test("requires an approved brief", async () => {
+    db.prepare("UPDATE briefs SET status = 'pending_approval' WHERE id = ?").run(briefId);
+    const response = await build();
+    expect(response.status).toBe(409);
+    expect(dispatchCalls).toHaveLength(0);
+  });
+
+  test("rejects an existing active build and otherwise returns its session ref", async () => {
+    buildRunning = true;
+    expect((await build()).status).toBe(409);
+    expect(dispatchCalls).toHaveLength(0);
+
+    buildRunning = false;
+    const response = await build();
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ session_ref: "session-123" });
+    expect(dispatchCalls).toEqual([["build", briefId]]);
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
