diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2cb43e60742fdc925319750fe5d8f2d137d55bbf
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,64 @@
+import { afterEach, describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+
+const db = openTestDb();
+
+afterEach(() => {
+  db.exec("DELETE FROM briefs; DELETE FROM cohorts; DELETE FROM plans; DELETE FROM specs; DELETE FROM projects;");
+});
+
+function setup(status = "approved", currentSessionRef: string | null = null) {
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES ('p', 'project', '/tmp/project')").run();
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES ('s', 'p', 'spec')").run();
+  db.prepare("INSERT INTO plans (id, spec_id) VALUES ('pl', 's')").run();
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position, status, current_session_ref) VALUES ('c', 'pl', 'cohort', 1, 'building', ?)").run(currentSessionRef);
+  db.prepare("INSERT INTO briefs (id, cohort_id, status, goal) VALUES ('b', 'c', ?, 'goal')").run(status);
+}
+
+function makeApp(dispatcher: {
+  dispatch: (stage: string, id: string) => Promise<string>;
+  isBuildRunning?: (cohortId: string) => Promise<boolean>;
+}) {
+  const app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher: dispatcher as never });
+  return app;
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("returns 404 when the brief is missing", async () => {
+    const app = makeApp({ dispatch: async () => "unused" });
+    const res = await app.request("/briefs/missing/build", { method: "POST" });
+    expect(res.status).toBe(404);
+  });
+
+  test("requires an approved brief", async () => {
+    setup("pending_approval");
+    const app = makeApp({ dispatch: async () => "unused" });
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(409);
+  });
+
+  test("rejects a cohort with a running build", async () => {
+    setup("approved", "build-session");
+    const app = makeApp({
+      dispatch: async () => "unused",
+      isBuildRunning: async () => true,
+    });
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(409);
+  });
+
+  test("dispatches the approved brief and returns its session ref", async () => {
+    setup();
+    const calls: string[][] = [];
+    const app = makeApp({
+      dispatch: async (stage, id) => { calls.push([stage, id]); return "build-session"; },
+    });
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "build-session" });
+    expect(calls).toEqual([["build", "b"]]);
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d1467bf1e9041d6bbbad0ec6d4ed1ad52795fea7
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,66 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import type { createDispatcher } from "../../orchestrator/backends/dispatcher";
+
+type Dispatcher = ReturnType<typeof createDispatcher>;
+
+interface BuildsRouteDeps {
+  dispatcher: Pick<Dispatcher, "dispatch"> & Partial<Pick<Dispatcher, "isBuildRunning">>;
+  db: Database;
+}
+
+/** Routes for explicitly starting an approved brief's build stage. */
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Prevent two requests handled by this process from both passing the
+  // running check before either one has persisted its session reference.
+  const dispatching = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = db
+      .prepare<{ id: string; cohort_id: string; status: string }, [string]>(
+        "SELECT id, cohort_id, status FROM briefs WHERE id = ?",
+      )
+      .get(briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    if (dispatching.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    const cohort = db
+      .prepare<{ current_session_ref: string | null }, [string]>(
+        "SELECT current_session_ref FROM cohorts WHERE id = ?",
+      )
+      .get(brief.cohort_id);
+    if (cohort?.current_session_ref) {
+      let alreadyRunning = true;
+      if (dispatcher.isBuildRunning) {
+        try {
+          alreadyRunning = await dispatcher.isBuildRunning(brief.cohort_id);
+        } catch (err) {
+          console.error("builds: failed to check active build", err);
+          // Fail closed if the session status cannot be determined.
+          alreadyRunning = true;
+        }
+      }
+      if (alreadyRunning) {
+        return c.json({ error: "a build is already running for this cohort" }, 409);
+      }
+    }
+
+    dispatching.add(brief.cohort_id);
+    try {
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds: dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    } finally {
+      dispatching.delete(brief.cohort_id);
+    }
+  });
+}
