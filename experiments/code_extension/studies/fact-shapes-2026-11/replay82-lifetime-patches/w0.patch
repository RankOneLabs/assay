diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a20970bf142c2e3a8997e045f13d9016bb9e511f
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,61 @@
+import { afterEach, describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes, type BuildDispatcher } from "./builds";
+
+const db = openTestDb();
+
+afterEach(() => {
+  db.exec("DELETE FROM briefs");
+  db.exec("DELETE FROM cohorts");
+  db.exec("DELETE FROM plans");
+  db.exec("DELETE FROM specs");
+  db.exec("DELETE FROM projects");
+});
+
+function setup(status = "approved") {
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES ('p', 'project', '/tmp')").run();
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES ('s', 'p', 'spec')").run();
+  db.prepare("INSERT INTO plans (id, spec_id) VALUES ('pl', 's')").run();
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position) VALUES ('c', 'pl', 'cohort', 0)").run();
+  db.prepare("INSERT INTO briefs (id, cohort_id, status, goal) VALUES ('b', 'c', ?, 'goal')").run(status);
+  const calls: string[][] = [];
+  let running = false;
+  const dispatcher: BuildDispatcher = {
+    async dispatch(stageName, inputId) { calls.push([stageName, inputId]); return "session-ref"; },
+    async isRunning() { return running; },
+  };
+  const app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher });
+  return { app, calls, setRunning: (value: boolean) => { running = value; } };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("dispatches a build for an approved brief", async () => {
+    const { app, calls } = setup();
+    const response = await app.request("/briefs/b/build", { method: "POST" });
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ session_ref: "session-ref" });
+    expect(calls).toEqual([["build", "b"]]);
+  });
+
+  test("returns 404 when the brief is missing", async () => {
+    const { app, calls } = setup();
+    expect((await app.request("/briefs/missing/build", { method: "POST" })).status).toBe(404);
+    expect(calls).toHaveLength(0);
+  });
+
+  test("returns 409 unless the brief is approved", async () => {
+    const { app, calls } = setup("pending_approval");
+    expect((await app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+    expect(calls).toHaveLength(0);
+  });
+
+  test("returns 409 while a build session for the cohort is live", async () => {
+    const { app, calls, setRunning } = setup();
+    db.prepare("UPDATE cohorts SET current_session_ref = 'previous-build' WHERE id = 'c'").run();
+    setRunning(true);
+    expect((await app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+    expect(calls).toHaveLength(0);
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a061eaca391c40e082eeb66812f0c14cd83c0b05
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,65 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+
+export interface BuildDispatcher {
+  dispatch(stageName: string, inputId: string): Promise<string>;
+  /** True only when this ref was launched for the named stage and is live. */
+  isRunning?(stageName: string, sessionRef: string): Promise<boolean>;
+}
+
+interface BuildsRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+/** Mounts the explicit operator action for starting a build from an approved brief. */
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Keep a short-lived reservation around the asynchronous dispatch itself so
+  // concurrent operator requests cannot both pass the cohort-level check.
+  const dispatching = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = db
+      .prepare<{ id: string; cohort_id: string; status: string }, [string]>(
+        "SELECT id, cohort_id, status FROM briefs WHERE id = ?",
+      )
+      .get(briefId);
+    if (!brief) return c.json({ error: "brief not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    if (dispatching.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+    dispatching.add(brief.cohort_id);
+
+    try {
+      const cohort = db
+        .prepare<{ current_session_ref: string | null }, [string]>(
+          "SELECT current_session_ref FROM cohorts WHERE id = ?",
+        )
+        .get(brief.cohort_id);
+      const previousRef = cohort?.current_session_ref;
+      if (previousRef && dispatcher.isRunning) {
+        try {
+          if (await dispatcher.isRunning("build", previousRef)) {
+            return c.json({ error: "a build is already running for this cohort" }, 409);
+          }
+        } catch (err) {
+          console.error("builds:status failed", err);
+          return c.json({ error: "could not determine whether a build is running" }, 503);
+        }
+      }
+
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to dispatch build" }, 500);
+    } finally {
+      dispatching.delete(brief.cohort_id);
+    }
+  });
+}
