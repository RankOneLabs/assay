+        if (!cancelled && session) setSessionStatus(session.status);
+      } catch {
+        // The status can be refreshed on the next interval.
+      }
+    };
+    void poll();
+    const timer = setInterval(() => void poll(), 2000);
+    return () => { cancelled = true; clearInterval(timer); };
