@@ -0,0 +1,42 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+
+interface BuildsRouteDeps {
+  dispatcher: Dispatcher;
+  db: Database;
+}
+
+/** Registers the operator-triggered build endpoint for an approved brief. */
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief is not approved" }, 409);
+    }
+
+    try {
+      const currentRef = db.prepare<{ current_session_ref: string | null }, [string]>("SELECT current_session_ref FROM cohorts WHERE id = ?").get(brief.cohort_id)?.current_session_ref;
+      if (currentRef) {
+        const running = dispatcher.isBuildRunning
+          ? await dispatcher.isBuildRunning(brief.cohort_id)
+          : false;
+        if (running) return c.json({ error: "a build is already running for this cohort" }, 409);
+      }
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      // A parallel dispatch may have claimed this cohort between the status
+      // check and dispatch. Treat that conflict like the check above.
+      const message = err instanceof Error ? err.message : String(err);
+      if (message === "build already running for cohort") {
+        return c.json({ error: "a build is already running for this cohort" }, 409);
+      }
+      console.error("builds:post failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    }
+  });
+}
