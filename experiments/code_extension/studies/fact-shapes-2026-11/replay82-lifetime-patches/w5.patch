diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..06c1f6c2c13a2c00bef941c387531447f014ebd1
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,64 @@
+import { afterEach, describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import type { Database } from "bun:sqlite";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+
+function setup(status = "approved", isRunning = false) {
+  db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES (?, ?, ?)").run("p", "project", "/tmp/project");
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES (?, ?, ?)").run("s", "p", "spec");
+  db.prepare("INSERT INTO plans (id, spec_id, status) VALUES (?, ?, 'approved')").run("pl", "s");
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position, status) VALUES (?, ?, ?, ?, 'building')").run("c", "pl", "cohort", 0);
+  db.prepare("INSERT INTO briefs (id, cohort_id, status, goal) VALUES (?, ?, ?, ?)").run("b", "c", status, "goal");
+  let calls = 0;
+  const app = new Hono();
+  mountBuildsRoutes(app, {
+    db,
+    dispatcher: {
+      dispatch: async (stageName, inputId) => {
+        calls++;
+        expect(stageName).toBe("build");
+        expect(inputId).toBe("b");
+        return "session-123";
+      },
+      isBuildRunning: () => isRunning,
+    },
+  });
+  return { app, calls: () => calls };
+}
+
+afterEach(() => db?.close());
+
+describe("POST /briefs/:id/build", () => {
+  test("returns 404 when brief is missing", async () => {
+    const { app, calls } = setup();
+    const res = await app.request("/briefs/missing/build", { method: "POST" });
+    expect(res.status).toBe(404);
+    expect(calls()).toBe(0);
+  });
+
+  test("requires an approved brief", async () => {
+    const { app, calls } = setup("pending_approval");
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(409);
+    expect(calls()).toBe(0);
+  });
+
+  test("rejects a second active build", async () => {
+    const { app, calls } = setup("approved", true);
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(409);
+    expect(calls()).toBe(0);
+  });
+
+  test("dispatches the build and returns its session reference", async () => {
+    const { app, calls } = setup();
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "session-123" });
+    expect(calls()).toBe(1);
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f1cbacea1f8277902049e036b01f8ce3266e38c4
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,64 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+
+export interface BuildDispatcher {
+  dispatch(stageName: string, inputId: string): Promise<string>;
+  /** True only while a build dispatch for this cohort is known to be running. */
+  isBuildRunning?(cohortId: string): Promise<boolean> | boolean;
+}
+
+interface BuildsRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Also guards simultaneous HTTP requests while dispatch() is awaiting backend startup.
+  const dispatching = new Set<string>();
+  // Fallback for lightweight dispatchers without lifecycle status support:
+  // do not permit a second launch in this server process.
+  const buildsStarted = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    const cohort = db
+      .prepare<{ id: string; current_session_ref: string | null }, [string]>(
+        "SELECT id, current_session_ref FROM cohorts WHERE id = ?",
+      )
+      .get(brief.cohort_id);
+    if (!cohort) return c.json({ error: "cohort not found" }, 404);
+
+    if (dispatching.has(cohort.id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+    // Reserve before awaiting a backend status check so simultaneous requests
+    // cannot both pass the check and start competing builds.
+    dispatching.add(cohort.id);
+    try {
+      let alreadyRunning: boolean;
+      if (dispatcher.isBuildRunning) {
+        alreadyRunning = await dispatcher.isBuildRunning(cohort.id);
+      } else {
+        alreadyRunning = cohort.current_session_ref !== null || buildsStarted.has(cohort.id);
+      }
+      if (alreadyRunning) {
+        return c.json({ error: "a build is already running for this cohort" }, 409);
+      }
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      buildsStarted.add(cohort.id);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to dispatch build" }, 500);
+    } finally {
+      dispatching.delete(cohort.id);
+    }
+  });
+}
