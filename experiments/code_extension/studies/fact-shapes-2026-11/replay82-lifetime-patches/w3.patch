diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dd89e69db2668b29a683aeeea49dd1bc709acd2d
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+
+function setup(status: string, dispatcher: { dispatch: (stage: string, id: string) => Promise<string>; isRunning?: (stage: string, id: string) => Promise<boolean> }) {
+  const db = openTestDb();
+  db.exec(`
+    INSERT INTO projects (id, name, repo_path) VALUES ('project', 'Project', '/tmp');
+    INSERT INTO specs (id, project_id, title) VALUES ('spec', 'project', 'Spec');
+    INSERT INTO plans (id, spec_id, status) VALUES ('plan', 'spec', 'approved');
+    INSERT INTO cohorts (id, plan_id, title, position, status) VALUES ('cohort', 'plan', 'Cohort', 0, 'building');
+  `);
+  db.prepare("INSERT INTO briefs (id, cohort_id, status, goal, files_in_scope, decisions_made, approaches_rejected, next_action) VALUES ('brief', 'cohort', ?, 'goal', '[]', '[]', '[]', 'next')").run(status);
+  const app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher });
+  return { app, db };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("requires an existing approved brief and dispatches a build", async () => {
+    let call: [string, string] | null = null;
+    const { app, db } = setup("approved", {
+      dispatch: async (stage, id) => { call = [stage, id]; return "session-1"; },
+      isRunning: async () => false,
+    });
+    try {
+      expect((await app.request("/briefs/missing/build", { method: "POST" })).status).toBe(404);
+      const response = await app.request("/briefs/brief/build", { method: "POST" });
+      expect(response.status).toBe(200);
+      expect(await response.json()).toEqual({ session_ref: "session-1" });
+      expect(call).toEqual(["build", "brief"]);
+    } finally { db.close(); }
+  });
+
+  test("rejects unapproved briefs and already running builds", async () => {
+    const pending = setup("pending_approval", { dispatch: async () => "unused" });
+    try { expect((await pending.app.request("/briefs/brief/build", { method: "POST" })).status).toBe(409); }
+    finally { pending.db.close(); }
+
+    const running = setup("approved", { dispatch: async () => "unused", isRunning: async () => true });
+    try { expect((await running.app.request("/briefs/brief/build", { method: "POST" })).status).toBe(409); }
+    finally { running.db.close(); }
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7c890736d2a87e611a3e1fb0c4412ba4ecc8ea46
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,39 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+
+interface BuildRouteDeps {
+  dispatcher: Dispatcher;
+  db: Database;
+}
+
+interface BriefBuildRow {
+  id: string;
+  cohort_id: string;
+  status: string;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildRouteDeps): void {
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = db
+      .prepare<BriefBuildRow, [string]>("SELECT id, cohort_id, status FROM briefs WHERE id = ?")
+      .get(briefId);
+
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    try {
+      if (dispatcher.isRunning && await dispatcher.isRunning("build", briefId)) {
+        return c.json({ error: "a build is already running for this cohort" }, 409);
+      }
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    }
+  });
+}
