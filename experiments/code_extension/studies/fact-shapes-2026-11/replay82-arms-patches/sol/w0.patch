+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+async function showView() {
+  render(<BriefReviewView id={brief.id} theme="dark" onToggleTheme={() => {}} onBack={() => {}} />);
+  return screen.findByRole("button", { name: "Run build" });
+}
+
+describe("Run build", () => {
+  it("POSTs the brief route, prevents duplicate clicks, and displays the returned session", async () => {
+    let finish!: (res: Response) => void;
+    fetchMock.mockImplementationOnce(() => new Promise<Response>((resolve) => { finish = resolve; }));
+    const button = await showView();
+    expect((button as HTMLButtonElement).disabled).toBe(false);
+    fireEvent.click(button);
+    expect(fetchMock).toHaveBeenLastCalledWith("/briefs/brief%2F1/build", { method: "POST" });
+    expect((screen.getByRole("button", { name: "Starting build…" }) as HTMLButtonElement).disabled).toBe(true);
+    await act(async () => { finish(new Response(JSON.stringify({ session_ref: "build-session" }))); });
+    expect((await screen.findByRole("status")).textContent).toContain("build-session");
+    expect((screen.getByRole("button", { name: "Run build" }) as HTMLButtonElement).disabled).toBe(true);
+    expect(fetchMock).toHaveBeenCalledTimes(2);
+  });
+
+  it("shows server conflicts and allows retry after failure", async () => {
+    fetchMock.mockResolvedValueOnce(new Response(JSON.stringify({ error: "a build is already running" }), { status: 409 }));
+    const button = await showView();
+    fireEvent.click(button);
+    expect((await screen.findByRole("alert")).textContent).toContain("already running");
+    await waitFor(() => expect((button as HTMLButtonElement).disabled).toBe(false));
+    fetchMock.mockResolvedValueOnce(new Response(JSON.stringify({ session_ref: "retry-session" })));
+    fireEvent.click(button);
+    expect((await screen.findByRole("status")).textContent).toContain("retry-session");
+    expect(screen.queryByRole("alert")).toBeNull();
+  });
+
+  it("shows network errors without leaving the button disabled", async () => {
