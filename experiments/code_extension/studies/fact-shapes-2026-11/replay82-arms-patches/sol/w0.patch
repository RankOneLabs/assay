@@ -0,0 +1,117 @@
+import { afterEach, beforeEach, expect, mock, test } from "bun:test";
+import type { Database } from "bun:sqlite";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+import { createDispatcher } from "../../orchestrator/backends/dispatcher";
+import type { ExecutionBackend } from "../../orchestrator/backends/interface";
+
+let db: Database;
+let app: Hono;
+let dispatch: ReturnType<typeof mock<(stage: string, id: string) => Promise<string>>>;
+
+beforeEach(() => {
+  db = openTestDb();
+  db.exec(`
+    INSERT INTO projects (id, name, repo_path) VALUES ('project', 'Project', '/tmp');
+    INSERT INTO specs (id, project_id, title) VALUES ('spec', 'project', 'Spec');
+    INSERT INTO plans (id, spec_id) VALUES ('plan', 'spec');
+    INSERT INTO cohorts (id, plan_id, title, position, status)
+      VALUES ('cohort', 'plan', 'Cohort', 0, 'building');
+    INSERT INTO briefs (id, cohort_id, goal, status)
+      VALUES ('brief', 'cohort', 'Build it', 'approved');
+  `);
+  dispatch = mock(async () => {
+    db.prepare("UPDATE cohorts SET current_session_ref = ? WHERE id = ?").run("build-session", "cohort");
+    return "build-session";
+  });
+  app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher: { dispatch } });
+});
+
+afterEach(() => db.close());
+
+function build(id = "brief") {
+  return app.request(`/briefs/${id}/build`, { method: "POST" });
+}
+
+test("missing brief returns 404 without dispatch", async () => {
+  expect((await build("missing")).status).toBe(404);
+  expect(dispatch).not.toHaveBeenCalled();
+});
+
+test("every non-approved status returns 409 without dispatch", async () => {
+  for (const status of ["pending_approval", "rejected", "superseded"]) {
+    db.prepare("UPDATE briefs SET status = ? WHERE id = 'brief'").run(status);
+    expect((await build()).status).toBe(409);
+  }
+  expect(dispatch).not.toHaveBeenCalled();
+});
+
+test("approved brief dispatches build and returns the session ref", async () => {
+  const res = await build();
+  expect(res.status).toBe(200);
+  expect(await res.json()).toEqual({ session_ref: "build-session" });
+  expect(dispatch).toHaveBeenCalledWith("build", "brief");
+  expect((await build()).status).toBe(409);
+  expect(dispatch).toHaveBeenCalledTimes(1);
+});
+
+test("checks the parent cohort for a running build, including another brief", async () => {
+  db.exec(`
+    UPDATE cohorts SET current_session_ref = 'existing-session' WHERE id = 'cohort';
+    INSERT INTO briefs (id, cohort_id, goal, status)
+      VALUES ('other-brief', 'cohort', 'Another brief', 'approved');
+  `);
+  expect((await build("other-brief")).status).toBe(409);
+  expect(dispatch).not.toHaveBeenCalled();
+});
+
+test("a previous planner session is not a build when the cohort is in brief_review", async () => {
+  db.exec("UPDATE cohorts SET status = 'brief_review', current_session_ref = 'planner-session'");
+  expect((await build()).status).toBe(200);
+});
+
+test("concurrent requests for the same cohort dispatch only once", async () => {
+  let finish!: (ref: string) => void;
+  dispatch.mockImplementation(() => new Promise<string>((resolve) => { finish = resolve; }));
+  const first = build();
+  expect((await build()).status).toBe(409);
+  finish("build-session");
+  expect((await first).status).toBe(200);
+  expect(dispatch).toHaveBeenCalledTimes(1);
+});
+
+test("dispatch failure returns 500 and releases the pending guard for a retry", async () => {
+  const log = console.error;
+  console.error = () => {};
+  try {
+    dispatch.mockRejectedValueOnce(new Error("backend unavailable"));
+    const res = await build();
+    expect(res.status).toBe(500);
+    expect(await res.json()).toEqual({ error: "failed to dispatch build" });
+    expect((await build()).status).toBe(200);
+  } finally {
+    console.error = log;
+  }
+});
+
+test("real dispatcher persists the build ref on the cohort, not the brief", async () => {
+  const backend: ExecutionBackend = {
+    id: "kbbl_chat",
+    dispatch: mock(async () => ({ session_ref: "real-dispatch-session" })),
+    status: async () => "running",
+  };
+  const dispatcher = createDispatcher({ db, backends: { kbbl_chat: backend }, kbblUrl: "http://localhost:8788" });
+  app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher });
+  expect(await (await build()).json()).toEqual({ session_ref: "real-dispatch-session" });
+  expect(db.prepare("SELECT current_session_ref FROM cohorts WHERE id = 'cohort'").get())
+    .toEqual({ current_session_ref: "real-dispatch-session" });
+  expect((await build()).status).toBe(409);
+});
+
+test("a completed cohort's old session ref does not count as a running build", async () => {
+  db.exec("UPDATE cohorts SET status = 'done', current_session_ref = 'old-session'");
+  expect((await build()).status).toBe(200);
+});
