+import { JSDOM } from "jsdom";
+import type { Brief } from "../core/pwa/review/brief/types";
+
+const dom = new JSDOM("<!doctype html><html><body></body></html>", { url: "http://kbbl.test" });
+Object.assign(globalThis, {
+  window: dom.window,
+  document: dom.window.document,
+  HTMLElement: dom.window.HTMLElement,
+  MutationObserver: dom.window.MutationObserver,
+  IS_REACT_ACT_ENVIRONMENT: true,
+  EventSource: class { addEventListener() {} close() {} },
+});
+
+const { render, screen, fireEvent, waitFor, cleanup } = await import("@testing-library/react");
+const { BriefReviewView } = await import("../core/pwa/review/brief/BriefReviewView");
+
+const originalFetch = globalThis.fetch;
+let buildRequest: ReturnType<typeof mock<() => Promise<Response>>>;
+let brief: Brief;
+
+beforeEach(() => {
+  brief = {
+    id: "brief-1", cohort_id: "cohort-1", status: "approved",
+    predecessor_brief_id: null, model: null, goal: "Ship the build",
+    files_in_scope: [], decisions_made: [], approaches_rejected: [],
+    next_action: "Start", debrief: null, rejection_reason: null, created_at: "2026-01-01",
+  };
+  buildRequest = mock(async () => Response.json({ session_ref: "session-123" }));
+  globalThis.fetch = mock(async (input: RequestInfo | URL, init?: RequestInit) => {
+    const url = String(input);
+    if (url.endsWith("/build")) {
+      expect(url).toBe("/briefs/brief-1/build");
+      expect(init?.method).toBe("POST");
+      return buildRequest();
+    }
+    if (url.startsWith("/briefs/")) return Response.json(brief);
+    if (url.startsWith("/review/frozen")) return Response.json({ frozen: true });
+    return Response.json([]);
+  }) as typeof fetch;
+});
+
+afterEach(() => {
+  cleanup();
+  globalThis.fetch = originalFetch;
+});
+
+function view() {
+  return render(<BriefReviewView id={brief.id} theme="dark" onToggleTheme={() => {}} onBack={() => {}} />);
+}
+
+describe("brief review run build", () => {
+  test("POSTs the build route and shows the returned session ref", async () => {
+    view();
+    const button = await screen.findByRole("button", { name: "Run build" });
+    expect((button as HTMLButtonElement).disabled).toBe(false);
+    fireEvent.click(button);
+    expect((await screen.findByRole("status")).textContent).toContain("session-123");
+    expect((button as HTMLButtonElement).disabled).toBe(true);
+    expect(buildRequest).toHaveBeenCalledTimes(1);
+  });
+
