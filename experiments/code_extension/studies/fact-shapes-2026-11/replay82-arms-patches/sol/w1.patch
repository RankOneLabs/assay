index 0000000000000000000000000000000000000000..cddc246422d02535ec99fdb9970d0f91d151a005
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,156 @@
+import { afterEach, beforeEach, describe, expect, mock, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { insertProject } from "../../db/projects";
+import { insertSpec } from "../../db/specs";
+import { insertPlan } from "../../db/plans";
+import { insertCohort, getCohort } from "../../db/cohorts";
+import { insertBrief } from "../../db/briefs";
+import { mountBuildsRoutes } from "./builds";
+import { mountBriefStatusRoutes } from "./brief-status";
+import { bootstrap } from "../../orchestrator/bootstrap";
+import { reviewRegistry } from "../../review/registry";
+import { reviewEvents } from "../../review/events";
+import { taskTrackerEvents } from "../../db/events";
+import { createDispatcher } from "../../orchestrator/backends/dispatcher";
+
+let db: Database;
+let app: Hono;
+let dispatch: ReturnType<typeof mock<(stage: string, id: string) => Promise<string>>>;
+
+function addBrief(id: string, cohort_id = "c1") {
+  insertBrief(db, {
+    id, cohort_id, goal: "Build it", files_in_scope: [], decisions_made: [],
+    approaches_rejected: [], next_action: "Start",
+  });
+  db.prepare("UPDATE briefs SET status = 'approved' WHERE id = ?").run(id);
+}
+
+beforeEach(() => {
+  db = openTestDb();
+  insertProject(db, { id: "p1", name: "P", repo_path: "/tmp/p" });
+  insertSpec(db, { id: "s1", project_id: "p1", title: "S" });
+  insertPlan(db, { id: "plan1", spec_id: "s1" });
+  insertCohort(db, { id: "c1", plan_id: "plan1", title: "C", position: 1 });
+  db.prepare("UPDATE cohorts SET status = 'building' WHERE id = 'c1'").run();
+  addBrief("b1");
+  dispatch = mock(async (_stage: string, _id: string) => {
+    db.prepare("UPDATE cohorts SET current_session_ref = 'build-session' WHERE id = 'c1'").run();
+    return "build-session";
+  });
+  app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher: { dispatch } });
+});
+
+afterEach(() => db.close());
+
+function run(id = "b1") {
+  return app.request(`/briefs/${id}/build`, { method: "POST" });
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("404 for a missing brief, without dispatch", async () => {
+    expect((await run("missing")).status).toBe(404);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  for (const status of ["pending_approval", "rejected", "superseded"]) {
+    test(`409 for a ${status} brief`, async () => {
+      db.prepare("UPDATE briefs SET status = ? WHERE id = 'b1'").run(status);
+      expect((await run()).status).toBe(409);
+      expect(dispatch).not.toHaveBeenCalled();
+    });
+  }
+
+  test("dispatches the brief (not the cohort) and returns the session ref", async () => {
+    const res = await run();
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "build-session" });
+    expect(dispatch).toHaveBeenCalledWith("build", "b1");
+    expect(getCohort(db, "c1")!.current_session_ref).toBe("build-session");
+    expect((await run()).status).toBe(409);
+    expect(dispatch).toHaveBeenCalledTimes(1);
+  });
+
+  test("rejects a build already running for another brief of the same cohort", async () => {
+    addBrief("b2");
+    db.prepare("UPDATE cohorts SET current_session_ref = 'existing-build' WHERE id = 'c1'").run();
+    expect((await run("b2")).status).toBe(409);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  test("blocking a building cohort does not make a second build safe", async () => {
+    db.prepare("UPDATE cohorts SET status = 'blocked', pre_block_status = 'building', current_session_ref = 'existing-build' WHERE id = 'c1'").run();
+    expect((await run()).status).toBe(409);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  test("a reference left on a done cohort is not a running build", async () => {
+    db.prepare("UPDATE cohorts SET status = 'done', current_session_ref = 'ended-build' WHERE id = 'c1'").run();
+    expect((await run()).status).toBe(200);
+  });
+
+  test("reserves the cohort until async dispatch finishes", async () => {
+    addBrief("b2");
+    let resolve!: (value: string) => void;
+    const started = new Promise<void>((notify) => {
+      dispatch.mockImplementation(() => {
+        notify();
+        return new Promise<string>((r) => { resolve = r; });
+      });
+    });
+    const first = run();
+    await started;
+    expect((await run("b2")).status).toBe(409);
+    resolve("slow-session");
+    expect((await first).status).toBe(200);
+    expect(dispatch).toHaveBeenCalledTimes(1);
+  });
+
+  test("dispatch errors return JSON and release the reservation for a retry", async () => {
+    const log = mock(() => {});
+    const original = console.error;
+    console.error = log;
+    try {
+      dispatch.mockRejectedValueOnce(new Error("backend unavailable"));
+      const failed = await run();
+      expect(failed.status).toBe(500);
+      expect(await failed.json()).toEqual({ error: "failed to dispatch build" });
+      expect(log).toHaveBeenCalledTimes(1);
+      expect((await run()).status).toBe(200);
+    } finally {
+      console.error = original;
+    }
+  });
+
+  test("approval clears the planning ref so the real dispatcher can start a build", async () => {
+    const cleanup = bootstrap({ db, registry: reviewRegistry, reviewEvents, taskTrackerEvents });
+    try {
+      db.prepare("UPDATE cohorts SET status = 'brief_review', current_session_ref = 'planner-session' WHERE id = 'c1'").run();
+      db.prepare("UPDATE briefs SET status = 'pending_approval' WHERE id = 'b1'").run();
+      app = new Hono();
+      mountBriefStatusRoutes(app, { db });
+      const backendDispatch = mock(async () => ({ session_ref: "real-build-ref" }));
+      const dispatcher = createDispatcher({
+        db, kbblUrl: "http://kbbl.test",
+        backends: { kbbl_chat: { id: "kbbl_chat", dispatch: backendDispatch, status: async () => "running" } },
+      });
+      mountBuildsRoutes(app, { db, dispatcher });
+      const approved = await app.request("/briefs/b1/status", {
+        method: "PATCH", headers: { "content-type": "application/json" },
+        body: JSON.stringify({ status: "approved" }),
+      });
+      expect(approved.status).toBe(200);
+      expect(getCohort(db, "c1")!.current_session_ref).toBeNull();
+      const built = await run();
+      expect(built.status).toBe(200);
+      expect(await built.json()).toEqual({ session_ref: "real-build-ref" });
+      expect(getCohort(db, "c1")!.current_session_ref).toBe("real-build-ref");
+      expect((await run()).status).toBe(409);
+      expect(backendDispatch).toHaveBeenCalledTimes(1);
+    } finally {
+      cleanup();
+    }
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4d3d72920c2a9cf0909ff077be636a8e33d54ebd
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,43 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+import { getCohort } from "../../db/cohorts";
+import type { createDispatcher } from "../../orchestrator/backends/dispatcher";
+
+interface BuildsRouteDeps {
+  dispatcher: ReturnType<typeof createDispatcher>;
+  db: Database;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // A session ref is only persisted after dispatch resolves. Reserve the cohort
+  // in the meantime, including requests against different briefs of that cohort.
+  const dispatching = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const brief = getBrief(db, c.req.param("id"));
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved to run a build" }, 409);
+    }
+
+    const cohort = getCohort(db, brief.cohort_id);
+    if (!cohort) return c.json({ error: "cohort not found" }, 404);
+    const building = cohort.status === "building" ||
+      (cohort.status === "blocked" && cohort.pre_block_status === "building");
+    if (dispatching.has(cohort.id) || (building && cohort.current_session_ref)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    dispatching.add(cohort.id);
+    try {
+      const session_ref = await dispatcher.dispatch("build", brief.id);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:post failed", err);
+      return c.json({ error: "failed to dispatch build" }, 500);
+    } finally {
+      dispatching.delete(cohort.id);
+    }
+  });
+}
