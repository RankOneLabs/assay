@@ -0,0 +1,63 @@
+import { afterEach, describe, expect, mock, test } from "bun:test";
+import { JSDOM } from "jsdom";
+
+// These small HTTP-wiring checks need only a DOM, not a browser or Vite.
+const dom = new JSDOM("<!doctype html><html><body></body></html>", { url: "http://localhost" });
+Object.assign(globalThis, {
+  window: dom.window,
+  document: dom.window.document,
+  HTMLElement: dom.window.HTMLElement,
+  MutationObserver: dom.window.MutationObserver,
+  IS_REACT_ACT_ENVIRONMENT: true,
+});
+
+const { render, fireEvent, waitFor, cleanup } = await import("@testing-library/react");
+const { RunBuildButton } = await import("../../core/pwa/review/brief/BriefReviewView");
+const originalFetch = globalThis.fetch;
+
+afterEach(() => {
+  cleanup();
+  globalThis.fetch = originalFetch;
+});
+
+describe("RunBuildButton", () => {
+  test("POSTs the encoded brief URL, disables while pending, and displays the session ref", async () => {
+    let finish!: (response: Response) => void;
+    const fetchMock = mock(() => new Promise<Response>((resolve) => { finish = resolve; }));
+    globalThis.fetch = fetchMock as unknown as typeof fetch;
+    const view = render(<RunBuildButton briefId="brief/id" />);
+    const button = view.getByRole("button", { name: "Run build" }) as HTMLButtonElement;
+    expect(button.disabled).toBe(false);
+    fireEvent.click(button);
+    expect(fetchMock).toHaveBeenCalledWith("/briefs/brief%2Fid/build", { method: "POST" });
+    expect(button.disabled).toBe(true);
+    expect(button.textContent).toBe("Starting build…");
+    finish(Response.json({ session_ref: "session-123" }));
+    await waitFor(() => expect(view.getByRole("status").textContent).toContain("session-123"));
+    expect(button.disabled).toBe(true);
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+  });
+
+  test("renders a conflict error and allows retry", async () => {
+    const fetchMock = mock(async () => Response.json({ error: "a build is already running" }, { status: 409 }));
+    globalThis.fetch = fetchMock as unknown as typeof fetch;
+    const view = render(<RunBuildButton briefId="brief" />);
+    const button = view.getByRole("button") as HTMLButtonElement;
+    fireEvent.click(button);
+    await waitFor(() => expect(view.getByRole("alert").textContent).toBe("a build is already running"));
+    expect(button.disabled).toBe(false);
+    fetchMock.mockImplementation(async () => Response.json({ session_ref: "retry-session" }));
+    fireEvent.click(button);
+    await waitFor(() => expect(view.getByRole("status").textContent).toContain("retry-session"));
+    expect(view.queryByRole("alert")).toBeNull();
+  });
+
+  test("network errors do not leave the button disabled", async () => {
+    globalThis.fetch = mock(async () => { throw new Error("Network unavailable"); }) as unknown as typeof fetch;
+    const view = render(<RunBuildButton briefId="brief" />);
+    const button = view.getByRole("button") as HTMLButtonElement;
+    fireEvent.click(button);
+    await waitFor(() => expect(view.getByRole("alert").textContent).toBe("Network unavailable"));
+    expect(button.disabled).toBe(false);
+  });
+});
