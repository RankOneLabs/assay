index 0000000000000000000000000000000000000000..042c97eda007e124dc68a342c2b2a69428848bd1
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,109 @@
+import { afterEach, beforeEach, describe, expect, mock, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { insertProject } from "../../db/projects";
+import { insertSpec } from "../../db/specs";
+import { insertPlan } from "../../db/plans";
+import { insertCohort } from "../../db/cohorts";
+import { insertBrief } from "../../db/briefs";
+import { createDispatcher } from "../../orchestrator/backends/dispatcher";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+let app: Hono;
+let dispatch: ReturnType<typeof mock<(stage: string, id: string) => Promise<string>>>;
+
+beforeEach(() => {
+  db = openTestDb();
+  insertProject(db, { id: "project", name: "Project", repo_path: "/tmp/project" });
+  insertSpec(db, { id: "spec", project_id: "project", title: "Spec" });
+  insertPlan(db, { id: "plan", spec_id: "spec" });
+  insertCohort(db, { id: "cohort", plan_id: "plan", title: "Cohort", position: 1 });
+  insertBrief(db, {
+    id: "brief", cohort_id: "cohort", goal: "Ship it", files_in_scope: [],
+    decisions_made: [], approaches_rejected: [], next_action: "Build it",
+  });
+  db.exec("UPDATE briefs SET status = 'approved'; UPDATE cohorts SET status = 'building'");
+  dispatch = mock(async (_stage: string, _id: string) => "build-session");
+  app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher: { dispatch } });
+});
+
+afterEach(() => db.close());
+
+function build(id = "brief") {
+  return app.request(`/briefs/${id}/build`, { method: "POST" });
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("missing brief returns 404 without dispatching", async () => {
+    expect((await build("missing")).status).toBe(404);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  for (const status of ["pending_approval", "rejected", "superseded"]) {
+    test(`${status} brief returns 409 without dispatching`, async () => {
+      db.prepare("UPDATE briefs SET status = ?").run(status);
+      expect((await build()).status).toBe(409);
+      expect(dispatch).not.toHaveBeenCalled();
+    });
+  }
+
+  test("approved brief dispatches build and returns session_ref", async () => {
+    const res = await build();
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "build-session" });
+    expect(dispatch).toHaveBeenCalledWith("build", "brief");
+  });
+
+  test("building cohort with a session ref returns 409", async () => {
+    db.exec("UPDATE cohorts SET current_session_ref = 'existing-session'");
+    expect((await build()).status).toBe(409);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  test("planner ref on a non-building cohort does not block build", async () => {
+    db.exec("UPDATE cohorts SET status = 'brief_review', current_session_ref = 'planner-session'");
+    expect((await build()).status).toBe(200);
+  });
+
+  test("lock is shared by different briefs belonging to the same cohort", async () => {
+    db.exec("INSERT INTO briefs (id, cohort_id, status, goal, next_action) VALUES ('other', 'cohort', 'approved', 'Goal', 'Build')");
+    let finish!: (ref: string) => void;
+    dispatch.mockImplementation(() => new Promise((resolve) => { finish = resolve; }));
+    const first = build();
+    // Let the first request enter the async dispatcher.
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    expect((await build("other")).status).toBe(409);
+    finish("build-session");
+    expect((await first).status).toBe(200);
+    expect(dispatch).toHaveBeenCalledTimes(1);
+  });
+
+  test("dispatch failure returns JSON 500 and releases reservation for retry", async () => {
+    dispatch.mockRejectedValueOnce(new Error("backend unavailable"));
+    const failed = await build();
+    expect(failed.status).toBe(500);
+    expect(await failed.json()).toEqual({ error: "failed to start build" });
+    expect((await build()).status).toBe(200);
+    expect(dispatch).toHaveBeenCalledTimes(2);
+  });
+
+  test("real dispatcher persists cohort ref and subsequent build is blocked", async () => {
+    const backendDispatch = mock(async () => ({ session_ref: "real-build-session" }));
+    const dispatcher = createDispatcher({
+      db, kbblUrl: "http://localhost:8788",
+      backends: { kbbl_chat: { id: "kbbl_chat", dispatch: backendDispatch, status: async () => "running" } },
+    });
+    app = new Hono();
+    mountBuildsRoutes(app, { dispatcher, db });
+    const res = await build();
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "real-build-session" });
+    expect(db.prepare("SELECT current_session_ref FROM cohorts WHERE id = 'cohort'").get())
+      .toEqual({ current_session_ref: "real-build-session" });
+    expect((await build()).status).toBe(409);
+    expect(backendDispatch).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ab0fc102d17999764cde6e7561a4df18d36c10b7
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,47 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import type { createDispatcher } from "../../orchestrator/backends/dispatcher";
+
+interface BuildsRouteDeps {
+  dispatcher: ReturnType<typeof createDispatcher>;
+  db: Database;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // dispatch is asynchronous: reserve the cohort until its session ref has
+  // been persisted so simultaneous requests cannot spawn duplicate builders.
+  const dispatching = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = db.prepare<{ status: string; cohort_id: string }, [string]>(
+      "SELECT status, cohort_id FROM briefs WHERE id = ?",
+    ).get(briefId);
+    if (!brief) return c.json({ error: "brief not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    const cohort = db.prepare<{ status: string; current_session_ref: string | null }, [string]>(
+      "SELECT status, current_session_ref FROM cohorts WHERE id = ?",
+    ).get(brief.cohort_id);
+    // The ref is shared with planner-2; only treat it as a build ref while
+    // the cohort is in the building state (approval alone may set that state
+    // before any builder has been dispatched).
+    if (dispatching.has(brief.cohort_id) ||
+        (cohort?.status === "building" && cohort.current_session_ref)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    dispatching.add(brief.cohort_id);
+    try {
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    } finally {
+      dispatching.delete(brief.cohort_id);
+    }
+  });
+}
