index 0000000000000000000000000000000000000000..1b8f801fbf7b6609f77ba8768e2d6f3f03f81bff
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,134 @@
+import { afterEach, beforeEach, describe, expect, mock, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { insertProject } from "../../db/projects";
+import { insertSpec } from "../../db/specs";
+import { insertPlan } from "../../db/plans";
+import { insertCohort } from "../../db/cohorts";
+import { insertBrief } from "../../db/briefs";
+import { createDispatcher } from "../../orchestrator/backends/dispatcher";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+let app: Hono;
+const dispatch = mock(async (_stage: string, _id: string) => "build-session");
+
+function addBrief(id: string, cohort_id = "cohort") {
+  insertBrief(db, {
+    id, cohort_id, goal: "Ship it", files_in_scope: [], decisions_made: [],
+    approaches_rejected: [], next_action: "Build",
+  });
+  db.prepare("UPDATE briefs SET status = 'approved' WHERE id = ?").run(id);
+}
+
+beforeEach(() => {
+  db = openTestDb();
+  insertProject(db, { id: "project", name: "P", repo_path: "/tmp" });
+  insertSpec(db, { id: "spec", project_id: "project", title: "S" });
+  insertPlan(db, { id: "plan", spec_id: "spec" });
+  insertCohort(db, { id: "cohort", plan_id: "plan", title: "C", position: 1 });
+  addBrief("brief");
+  dispatch.mockClear();
+  app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher: { dispatch } });
+});
+afterEach(() => db.close());
+
+const build = (id = "brief") => app.request(`/briefs/${id}/build`, { method: "POST" });
+
+describe("POST /briefs/:id/build", () => {
+  test("missing brief returns 404 without dispatch", async () => {
+    expect((await build("missing")).status).toBe(404);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  for (const status of ["pending_approval", "rejected", "superseded"]) {
+    test(`${status} brief returns 409 without dispatch`, async () => {
+      db.prepare("UPDATE briefs SET status = ? WHERE id = 'brief'").run(status);
+      expect((await build()).status).toBe(409);
+      expect(dispatch).not.toHaveBeenCalled();
+    });
+  }
+
+  test("approved brief dispatches build and returns its session_ref", async () => {
+    const res = await build();
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "build-session" });
+    expect(dispatch).toHaveBeenCalledWith("build", "brief");
+  });
+
+  test("approval's building status without a session does not block first run", async () => {
+    db.exec("UPDATE cohorts SET status = 'building' WHERE id = 'cohort'");
+    expect((await build()).status).toBe(200);
+  });
+
+  test("running build on parent cohort blocks any of its briefs", async () => {
+    addBrief("another-brief");
+    db.exec("UPDATE cohorts SET status = 'building', current_session_ref = 'existing' WHERE id = 'cohort'");
+    expect((await build("another-brief")).status).toBe(409);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  test("planner session ref on a non-building cohort does not block", async () => {
+    db.exec("UPDATE cohorts SET status = 'brief_review', current_session_ref = 'planner' WHERE id = 'cohort'");
+    expect((await build()).status).toBe(200);
+  });
+
+  test("concurrent requests for the same cohort dispatch only once", async () => {
+    let resolve!: (ref: string) => void;
+    const slowDispatch = mock(() => new Promise<string>((r) => { resolve = r; }));
+    app = new Hono();
+    mountBuildsRoutes(app, { db, dispatcher: { dispatch: slowDispatch } });
+    addBrief("another-brief");
+    const first = build();
+    expect((await build("another-brief")).status).toBe(409);
+    resolve("slow-session");
+    expect((await first).status).toBe(200);
+    expect(slowDispatch).toHaveBeenCalledTimes(1);
+  });
+
+  test("a running build on a different cohort does not block dispatch", async () => {
+    insertCohort(db, { id: "other", plan_id: "plan", title: "Other", position: 2 });
+    addBrief("other-brief", "other");
+    db.exec("UPDATE cohorts SET status = 'building', current_session_ref = 'existing' WHERE id = 'cohort'");
+    expect((await build("other-brief")).status).toBe(200);
+    expect(dispatch).toHaveBeenCalledWith("build", "other-brief");
+  });
+
+  test("dispatch failure returns 500 and releases the in-flight guard for retry", async () => {
+    const failing = mock(async () => { throw new Error("backend unavailable"); });
+    app = new Hono();
+    mountBuildsRoutes(app, { db, dispatcher: { dispatch: failing } });
+    expect((await build()).status).toBe(500);
+    expect((await build()).status).toBe(500);
+    expect(failing).toHaveBeenCalledTimes(2);
+  });
+
+  for (const status of ["running", "completed", "failed"] as const) {
+    test(`backend lifecycle ${status} determines whether a stored ref blocks`, async () => {
+      const lifecycle = mock(async () => status);
+      app = new Hono();
+      mountBuildsRoutes(app, { db, dispatcher: { dispatch, status: lifecycle } });
+      db.exec("UPDATE cohorts SET status = 'building', current_session_ref = 'existing' WHERE id = 'cohort'");
+      expect((await build()).status).toBe(status === "running" ? 409 : 200);
+      expect(lifecycle).toHaveBeenCalledWith("build", "existing");
+      expect(dispatch).toHaveBeenCalledTimes(status === "running" ? 0 : 1);
+    });
+  }
+
+  test("real dispatcher persists ref on cohort and rejects a repeat run", async () => {
+    const backendDispatch = mock(async () => ({ session_ref: "backend-session" }));
+    const dispatcher = createDispatcher({
+      db, kbblUrl: "http://localhost:8788",
+      backends: { kbbl_chat: { id: "kbbl_chat", dispatch: backendDispatch, status: async () => "running" } },
+    });
+    app = new Hono();
+    mountBuildsRoutes(app, { db, dispatcher });
+    db.exec("UPDATE cohorts SET status = 'building' WHERE id = 'cohort'");
+    expect(await (await build()).json()).toEqual({ session_ref: "backend-session" });
+    expect(db.prepare<{ current_session_ref: string }, []>("SELECT current_session_ref FROM cohorts WHERE id = 'cohort'").get()?.current_session_ref).toBe("backend-session");
+    expect((await build()).status).toBe(409);
+    expect(backendDispatch).toHaveBeenCalledTimes(1);
+  });
+});
