+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+import type { createDispatcher } from "../../orchestrator/backends/dispatcher";
+
+interface BuildsRouteDeps {
+  dispatcher: ReturnType<typeof createDispatcher>;
+  db: Database;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // A dispatch is asynchronous: protect the gap before it persists the ref,
+  // including requests for different briefs belonging to the same cohort.
+  const dispatching = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const brief = getBrief(db, c.req.param("id"));
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved to build" }, 409);
+    }
+
+    const cohort = db.prepare<{ status: string; current_session_ref: string | null }, [string]>(
+      "SELECT status, current_session_ref FROM cohorts WHERE id = ?",
+    ).get(brief.cohort_id);
+    // Approval enters 'building' before dispatch, so status alone is not
+    // evidence of a running build. A persisted ref is also required.
+    if (dispatching.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    dispatching.add(brief.cohort_id);
+    try {
+      if (cohort?.status === "building" && cohort.current_session_ref) {
+        // A ref outlives its session. Production checks lifecycle so a failed
+        // or completed run can be retried; dispatch-only adapters conservatively
+        // treat a building cohort with a ref as active.
+        const running = dispatcher.status
+          ? await dispatcher.status("build", cohort.current_session_ref) === "running"
+          : true;
+        if (running) {
+          return c.json({ error: "a build is already running for this cohort" }, 409);
+        }
+      }
+      const session_ref = await dispatcher.dispatch("build", brief.id);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to dispatch build" }, 500);
+    } finally {
+      dispatching.delete(brief.cohort_id);
+    }
+  });
+}
