+import { afterEach, beforeEach, describe, expect, vi, test } from "vitest";
+import { cleanup, fireEvent, render, waitFor } from "@testing-library/react";
+import { BriefReviewView } from "./BriefReviewView";
+import type { Brief } from "./types";
+
+// Review-stream behavior is covered separately; isolate the build controls.
+vi.mock("../shared/useArtifactStream", () => ({
+  useArtifactStream: () => ({ edits: [], threads: [], frozen: true }),
+}));
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+let brief: Brief;
+let buildResponse: () => Promise<Response>;
+const fetchMock = vi.fn(async (url: string | URL | Request) => {
+  const path = String(url);
+  if (path.endsWith("/build")) return buildResponse();
+  if (path.startsWith("/briefs/")) return Response.json(brief);
+  if (path.startsWith("/review/frozen")) return Response.json({ frozen: true });
+  return Response.json([]);
+});
+
+beforeEach(() => {
+  brief = {
+    id: "brief/1", cohort_id: "cohort", status: "approved", predecessor_brief_id: null,
+    model: null, goal: "Ship", files_in_scope: [], decisions_made: [],
+    approaches_rejected: [], next_action: "Build", debrief: null, rejection_reason: null,
+    created_at: "2026-01-01",
+  };
+  buildResponse = async () => Response.json({ session_ref: "session-123" });
+  fetchMock.mockClear();
+  vi.stubGlobal("fetch", fetchMock);
+});
+
+const view = () => render(<BriefReviewView id={brief.id} theme="dark" onToggleTheme={() => {}} onBack={() => {}} />);
+
+describe("Brief review Run build", () => {
+  test("POSTs the encoded brief route, renders session_ref, and disables repeat clicks", async () => {
+    const ui = view();
+    const button = await ui.findByRole("button", { name: "Run build" });
+    expect((button as HTMLButtonElement).disabled).toBe(false);
+    fireEvent.click(button);
+    await waitFor(() => expect(ui.getByRole("status").textContent).toContain("session-123"));
+    expect(fetchMock).toHaveBeenCalledWith("/briefs/brief%2F1/build", { method: "POST" });
+    expect((ui.getByRole("button", { name: "Build started" }) as HTMLButtonElement).disabled).toBe(true);
+  });
+
+  test("disables the button while dispatch is pending", async () => {
+    let finish!: (response: Response) => void;
+    buildResponse = () => new Promise((resolve) => { finish = resolve; });
+    const ui = view();
+    fireEvent.click(await ui.findByRole("button", { name: "Run build" }));
+    expect((ui.getByRole("button", { name: "Starting build…" }) as HTMLButtonElement).disabled).toBe(true);
+    finish(Response.json({ session_ref: "slow-session" }));
+    await ui.findByRole("status");
+  });
+
+  for (const status of [404, 409, 500]) {
+    test(`displays HTTP ${status} error and permits retry`, async () => {
+      buildResponse = async () => Response.json({ error: "Cannot start build" }, { status });
+      const ui = view();
+      fireEvent.click(await ui.findByRole("button", { name: "Run build" }));
+      expect((await ui.findByRole("alert")).textContent).toBe("Cannot start build");
+      expect((ui.getByRole("button", { name: "Run build" }) as HTMLButtonElement).disabled).toBe(false);
+      buildResponse = async () => Response.json({ session_ref: "retry-session" });
+      fireEvent.click(ui.getByRole("button", { name: "Run build" }));
+      expect((await ui.findByRole("status")).textContent).toContain("retry-session");
+      expect(ui.queryByRole("alert")).toBeNull();
+    });
+  }
+
+  test("displays network errors", async () => {
+    buildResponse = async () => { throw new Error("Network unavailable"); };
+    const ui = view();
+    fireEvent.click(await ui.findByRole("button", { name: "Run build" }));
+    expect((await ui.findByRole("alert")).textContent).toBe("Network unavailable");
+  });
+
+  test("does not show Run build for an unapproved brief", async () => {
+    brief.status = "pending_approval";
+    const ui = view();
+    await ui.findByRole("button", { name: "Approve" });
+    expect(ui.queryByRole("button", { name: "Run build" })).toBeNull();
+  });
+});
