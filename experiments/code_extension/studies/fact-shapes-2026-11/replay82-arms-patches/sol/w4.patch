+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,51 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+import type { BuildDispatcher } from "../../orchestrator/backends/dispatcher";
+
+interface BuildsRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Hold the guard across asynchronous status/dispatch calls. A second POST
+  // must not slip through before the dispatcher persists current_session_ref.
+  const pendingCohorts = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    const conflict = () => c.json({ error: "a build is already running for this cohort" }, 409);
+    if (pendingCohorts.has(brief.cohort_id)) return conflict();
+    pendingCohorts.add(brief.cohort_id);
+    try {
+      const cohort = db.prepare<{ current_session_ref: string | null }, [string]>(
+        "SELECT current_session_ref FROM cohorts WHERE id = ?",
+      ).get(brief.cohort_id);
+      if (!cohort) return c.json({ error: "cohort not found" }, 404);
+
+      // current_session_ref is stored on the cohort, not the brief. Check
+      // lifecycle rather than cohort.status (approval already sets building).
+      if (cohort.current_session_ref) {
+        const status = dispatcher.status
+          ? await dispatcher.status("build", cohort.current_session_ref)
+          : "running";
+        if (status === "running") return conflict();
+      }
+
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to dispatch build" }, 500);
+    } finally {
+      pendingCohorts.delete(brief.cohort_id);
+    }
+  });
+}
