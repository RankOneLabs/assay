index 0000000000000000000000000000000000000000..3527e90e3dbff18b487d6e0379b00a055c2d442d
--- /dev/null
+++ b/kbbl/core/server/builds-button.test.tsx
@@ -0,0 +1,58 @@
+// Bun/jsdom component checks live outside the PWA Vitest suite.
+import { afterEach, describe, expect, mock, test } from "bun:test";
+// @ts-expect-error jsdom is available for tests but this repo has no @types/jsdom.
+import { JSDOM } from "jsdom";
+
+const dom = new JSDOM("<!doctype html><html><body></body></html>", { url: "http://localhost" });
+Object.assign(globalThis, {
+  window: dom.window,
+  document: dom.window.document,
+  HTMLElement: dom.window.HTMLElement,
+  MutationObserver: dom.window.MutationObserver,
+});
+const { render, screen, fireEvent, waitFor, cleanup } = await import("@testing-library/react");
+const { RunBuildButton } = await import("../pwa/review/brief/BriefReviewView");
+const originalFetch = globalThis.fetch;
+
+afterEach(() => {
+  cleanup();
+  globalThis.fetch = originalFetch;
+});
+
+describe("RunBuildButton", () => {
+  test("POSTs the encoded brief route, prevents duplicate clicks, and shows the session ref", async () => {
+    let finish!: (response: Response) => void;
+    const fetchMock = mock(() => new Promise<Response>((resolve) => { finish = resolve; }));
+    globalThis.fetch = fetchMock as unknown as typeof fetch;
+    render(<RunBuildButton briefId="brief/id" />);
+    fireEvent.click(screen.getByRole("button", { name: "Run build" }));
+    expect(fetchMock).toHaveBeenCalledWith("/briefs/brief%2Fid/build", { method: "POST" });
+    const button = screen.getByRole("button", { name: "Starting build…" }) as HTMLButtonElement;
+    expect(button.disabled).toBe(true);
+    fireEvent.click(button);
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+    finish(Response.json({ session_ref: "builder-123" }));
+    await waitFor(() => expect(screen.getByRole("status").textContent).toContain("builder-123"));
+    expect((screen.getByRole("button") as HTMLButtonElement).disabled).toBe(true);
+  });
+
+  test("renders a conflict and permits a retry", async () => {
+    const fetchMock = mock(async () => Response.json({ error: "a build is already running for this cohort" }, { status: 409 }));
+    globalThis.fetch = fetchMock as unknown as typeof fetch;
+    render(<RunBuildButton briefId="brief" />);
+    fireEvent.click(screen.getByRole("button"));
+    await waitFor(() => expect(screen.getByRole("alert").textContent).toContain("already running"));
+    expect((screen.getByRole("button") as HTMLButtonElement).disabled).toBe(false);
+    fireEvent.click(screen.getByRole("button"));
+    expect(fetchMock).toHaveBeenCalledTimes(2);
+    await waitFor(() => expect(screen.getByRole("alert").textContent).toContain("already running"));
+  });
+
+  test("surfaces network failure without leaving the button disabled", async () => {
+    globalThis.fetch = mock(async () => { throw new Error("offline"); }) as unknown as typeof fetch;
+    render(<RunBuildButton briefId="brief" />);
+    fireEvent.click(screen.getByRole("button"));
+    await waitFor(() => expect(screen.getByRole("alert").textContent).toBe("offline"));
+    expect((screen.getByRole("button") as HTMLButtonElement).disabled).toBe(false);
+  });
+});
