@@ -0,0 +1,137 @@
+import { afterEach, beforeEach, describe, expect, mock, spyOn, test } from "bun:test";
+import type { Database } from "bun:sqlite";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { createDispatcher, type BuildDispatcher } from "../../orchestrator/backends/dispatcher";
+import { createApp } from "../app";
+import { KbblConfigSchema } from "../../config";
+import type { SessionManager } from "../../session/session-manager";
+import type { SafirClient } from "../../safir/client";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+const request = (app: Hono, id = "brief") => app.request(`/briefs/${id}/build`, { method: "POST" });
+const dispatch = mock(async (_stage: string, _id: string) => "build-session");
+
+function appFor(dispatcher: BuildDispatcher = { dispatch }): Hono {
+  const app = new Hono();
+  mountBuildsRoutes(app, { dispatcher, db });
+  return app;
+}
+
+beforeEach(() => {
+  dispatch.mockClear();
+  db = openTestDb();
+  db.exec(`
+    INSERT INTO projects (id, name, repo_path) VALUES ('project', 'Project', '/tmp/repo');
+    INSERT INTO specs (id, project_id, title) VALUES ('spec', 'project', 'Spec');
+    INSERT INTO plans (id, spec_id) VALUES ('plan', 'spec');
+    INSERT INTO cohorts (id, plan_id, title, position, status) VALUES ('cohort', 'plan', 'Cohort', 0, 'building');
+    INSERT INTO briefs (id, cohort_id, goal, status) VALUES ('brief', 'cohort', 'Goal', 'approved');
+  `);
+});
+afterEach(() => db.close());
+
+describe("POST /briefs/:id/build", () => {
+  test("404 for missing brief without dispatching", async () => {
+    expect((await request(appFor(), "missing")).status).toBe(404);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  for (const status of ["pending_approval", "rejected", "superseded"]) {
+    test(`409 for ${status} brief without dispatching`, async () => {
+      db.prepare("UPDATE briefs SET status = ?").run(status);
+      expect((await request(appFor())).status).toBe(409);
+      expect(dispatch).not.toHaveBeenCalled();
+    });
+  }
+
+  test("dispatches build with the brief id and returns session_ref", async () => {
+    const res = await request(appFor());
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "build-session" });
+    expect(dispatch).toHaveBeenCalledWith("build", "brief");
+  });
+
+  test("409 for an active cohort session, including another brief of the same cohort", async () => {
+    db.exec(`
+      UPDATE cohorts SET current_session_ref = 'active';
+      INSERT INTO briefs (id, cohort_id, goal, status) VALUES ('other', 'cohort', 'Other', 'approved');
+    `);
+    const status = mock(async () => "running" as const);
+    const app = appFor({ dispatch, status });
+    expect((await request(app, "other")).status).toBe(409);
+    expect(status).toHaveBeenCalledWith("build", "active");
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  test("dispatch-only substitutes conservatively block a persisted cohort ref", async () => {
+    db.exec("UPDATE cohorts SET current_session_ref = 'active'");
+    expect((await request(appFor())).status).toBe(409);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  for (const lifecycle of ["completed", "failed"] as const) {
+    test(`allows retry after a ${lifecycle} session`, async () => {
+      db.exec("UPDATE cohorts SET current_session_ref = 'old-session'");
+      const res = await request(appFor({ dispatch, status: async () => lifecycle }));
+      expect(res.status).toBe(200);
+      expect(dispatch).toHaveBeenCalledTimes(1);
+    });
+  }
+
+  test("guards simultaneous POSTs until dispatch persists its ref", async () => {
+    let finish!: (ref: string) => void;
+    const pending = mock(() => new Promise<string>((resolve) => { finish = resolve; }));
+    const app = appFor({ dispatch: pending });
+    const first = request(app);
+    // Hono enters the handler synchronously, but allow dispatch to be reached.
+    await Promise.resolve();
+    expect((await request(app)).status).toBe(409);
+    expect(pending).toHaveBeenCalledTimes(1);
+    finish("session");
+    expect((await first).status).toBe(200);
+  });
+
+  test("dispatch errors return JSON and release the in-flight guard", async () => {
+    const log = spyOn(console, "error").mockImplementation(() => {});
+    try {
+      let fail = true;
+      const app = appFor({ dispatch: async () => {
+        if (fail) throw new Error("backend unavailable");
+        return "retry-session";
+      } });
+      const res = await request(app);
+      expect(res.status).toBe(500);
+      expect(await res.json()).toEqual({ error: "failed to dispatch build" });
+      fail = false;
+      expect((await request(app)).status).toBe(200);
+    } finally {
+      log.mockRestore();
+    }
+  });
+
+  test("createApp mounts the route; real dispatcher persists and checks backend lifecycle", async () => {
+    let lifecycle: "running" | "completed" = "running";
+    const backendDispatch = mock(async () => ({ session_ref: "real-session" }));
+    const dispatcher = createDispatcher({ db, kbblUrl: "http://localhost:8788", backends: {
+      kbbl_chat: { id: "kbbl_chat", dispatch: backendDispatch, status: async () => lifecycle },
+    } });
+    const app = createApp({
+      db, dispatcher,
+      manager: {} as SessionManager,
+      runtime: { id: "test", mountRoutes: () => {}, buildSpawnCmd: async () => { throw new Error("unused"); } },
+      defaultWorkdir: "/tmp", sessionsDir: "/tmp", handoffsDir: "/tmp", pwaDistDir: "/tmp",
+      safirClient: {} as SafirClient, getBunServer: () => null,
+      config: KbblConfigSchema.parse({}), configPath: "/tmp/unused-config.json",
+    });
+    const res = await request(app);
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "real-session" });
+    expect(db.query("SELECT current_session_ref FROM cohorts WHERE id = 'cohort'").get()).toEqual({ current_session_ref: "real-session" });
+    expect((await request(app)).status).toBe(409);
+    lifecycle = "completed";
+    expect((await request(app)).status).toBe(200);
+    expect(backendDispatch).toHaveBeenCalledTimes(2);
+  });
+});
