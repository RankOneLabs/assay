new file mode 100644
index 0000000000000000000000000000000000000000..1b12c0ad3c1e6ec3c18204d1917a688e7add5ace
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,123 @@
+import { afterEach, beforeEach, describe, expect, mock, test } from "bun:test";
+import type { Database } from "bun:sqlite";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+import { createDispatcher } from "../../orchestrator/backends/dispatcher";
+
+let db: Database;
+
+beforeEach(() => {
+  db = openTestDb();
+  db.exec(`
+    INSERT INTO projects (id, name, repo_path) VALUES ('project', 'Project', '/repo');
+    INSERT INTO specs (id, project_id, title) VALUES ('spec', 'project', 'Spec');
+    INSERT INTO plans (id, spec_id) VALUES ('plan', 'spec');
+    INSERT INTO cohorts (id, plan_id, title, position) VALUES ('cohort', 'plan', 'Cohort', 0);
+    INSERT INTO briefs (id, cohort_id, goal, next_action, status)
+      VALUES ('brief', 'cohort', 'Build the feature', 'Start here', 'approved');
+  `);
+});
+
+afterEach(() => db.close());
+
+function buildApp(dispatch = mock(async (_stage: string, _id: string) => "session-1")) {
+  const app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher: { dispatch } });
+  return { app, dispatch };
+}
+
+function post(app: Hono, id = "brief") {
+  return app.request(`/briefs/${id}/build`, { method: "POST" });
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("missing brief is 404 without dispatching", async () => {
+    const { app, dispatch } = buildApp();
+    expect((await post(app, "missing")).status).toBe(404);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  for (const status of ["pending_approval", "rejected", "superseded"]) {
+    test(`${status} brief is 409 without dispatching`, async () => {
+      db.prepare("UPDATE briefs SET status = ? WHERE id = 'brief'").run(status);
+      const { app, dispatch } = buildApp();
+      expect((await post(app)).status).toBe(409);
+      expect(dispatch).not.toHaveBeenCalled();
+    });
+  }
+
+  test("approved brief dispatches build and returns its session ref", async () => {
+    // Approval has already moved the cohort to building, but a missing ref
+    // means no session has started yet (e.g. the automatic dispatch failed).
+    db.exec("UPDATE cohorts SET status = 'building'");
+    const { app, dispatch } = buildApp();
+    const res = await post(app);
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "session-1" });
+    expect(dispatch).toHaveBeenCalledTimes(1);
+    expect(dispatch).toHaveBeenCalledWith("build", "brief");
+  });
+
+  test("running build on the parent cohort is 409", async () => {
+    db.exec("UPDATE cohorts SET status = 'building', current_session_ref = 'running-session'");
+    const { app, dispatch } = buildApp();
+    expect((await post(app)).status).toBe(409);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  test("a previous planner ref does not block a cohort outside building", async () => {
+    db.exec("UPDATE cohorts SET status = 'brief_review', current_session_ref = 'planner-session'");
+    const { app, dispatch } = buildApp();
+    expect((await post(app)).status).toBe(200);
+    expect(dispatch).toHaveBeenCalledTimes(1);
+  });
+
+  test("a completed cohort's retained session ref does not block a new run", async () => {
+    db.exec("UPDATE cohorts SET status = 'done', current_session_ref = 'old-session'");
+    const { app } = buildApp();
+    expect((await post(app)).status).toBe(200);
+  });
+
+  test("blocks concurrent dispatches for all briefs of the same cohort", async () => {
+    db.exec(`INSERT INTO briefs (id, cohort_id, goal, next_action, status)
+      VALUES ('other-brief', 'cohort', 'Other brief', '', 'approved')`);
+    let resolve!: (ref: string) => void;
+    const dispatch = mock((_stage: string, _id: string) => new Promise<string>((r) => { resolve = r; }));
+    const { app } = buildApp(dispatch);
+    const first = post(app);
+    expect((await post(app, "other-brief")).status).toBe(409);
+    resolve("session-1");
+    expect((await first).status).toBe(200);
+    expect(dispatch).toHaveBeenCalledTimes(1);
+  });
+
+  test("dispatch errors return 500 and release the in-flight guard for retry", async () => {
+    const dispatch = mock(async (_stage: string, _id: string): Promise<string> => { throw new Error("spawn failed"); });
+    const { app } = buildApp(dispatch);
+    expect((await post(app)).status).toBe(500);
+    dispatch.mockImplementation(async () => "retry-session");
+    const retry = await post(app);
+    expect(retry.status).toBe(200);
+    expect(await retry.json()).toEqual({ session_ref: "retry-session" });
+  });
+
+  test("real dispatcher persists the build ref on the cohort, not the brief", async () => {
+    const dispatch = mock(async () => ({ session_ref: "backend-session" }));
+    const dispatcher = createDispatcher({
+      db,
+      kbblUrl: "http://localhost:8788",
+      backends: { kbbl_chat: { id: "kbbl_chat", dispatch, status: async () => "running" } },
+    });
+    db.exec("UPDATE cohorts SET status = 'building'");
+    const app = new Hono();
+    mountBuildsRoutes(app, { db, dispatcher });
+    const res = await post(app);
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "backend-session" });
+    expect(db.query("SELECT current_session_ref FROM cohorts WHERE id = 'cohort'").get())
+      .toEqual({ current_session_ref: "backend-session" });
+    expect((await post(app)).status).toBe(409);
+    expect(dispatch).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
