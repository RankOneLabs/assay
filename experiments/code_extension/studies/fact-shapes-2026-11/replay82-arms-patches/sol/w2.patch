@@ -0,0 +1,138 @@
+import { afterEach, beforeEach, expect, spyOn, test } from "bun:test";
+import { JSDOM } from "jsdom";
+import { act, cleanup, fireEvent, render, waitFor } from "@testing-library/react";
+import { BriefReviewView } from "../core/pwa/review/brief/BriefReviewView";
+import type { Brief } from "../core/pwa/review/brief/types";
+
+// These tests use Bun + jsdom so the route and PWA wiring can be checked with
+// the same offline test runner as the server. Kept outside core/pwa so the
+// separate Vitest suite does not collect Bun-specific tests.
+const originalGlobals = new Map<string, PropertyDescriptor | undefined>();
+let dom: JSDOM;
+let fetchSpy: ReturnType<typeof spyOn<typeof globalThis, "fetch">>;
+let brief: Brief;
+let buildResponse: () => Promise<Response>;
+let buildRequests: { url: string; method?: string }[];
+
+beforeEach(() => {
+  dom = new JSDOM("<!doctype html><html><body></body></html>", { url: "http://localhost" });
+  const globals = {
+    window: dom.window,
+    document: dom.window.document,
+    navigator: dom.window.navigator,
+    HTMLElement: dom.window.HTMLElement,
+    IS_REACT_ACT_ENVIRONMENT: true,
+    EventSource: class {
+      addEventListener() {}
+      close() {}
+    },
+  };
+  for (const [key, value] of Object.entries(globals)) {
+    originalGlobals.set(key, Object.getOwnPropertyDescriptor(globalThis, key));
+    Object.defineProperty(globalThis, key, { configurable: true, writable: true, value });
+  }
+  brief = {
+    id: "brief-1", cohort_id: "cohort-1", status: "approved",
+    predecessor_brief_id: null, model: null, goal: "Build a feature",
+    files_in_scope: [], decisions_made: [], approaches_rejected: [],
+    next_action: "Start here", debrief: null, rejection_reason: null,
+    created_at: "2026-01-01",
+  };
+  buildRequests = [];
+  buildResponse = async () => Response.json({ session_ref: "session-1" });
+  fetchSpy = spyOn(globalThis, "fetch").mockImplementation(async (input, init) => {
+    const url = String(input);
+    if (url.endsWith("/build")) {
+      buildRequests.push({ url, method: init?.method });
+      return buildResponse();
+    }
+    if (url.startsWith("/briefs/")) return Response.json(brief);
+    if (url.startsWith("/review/frozen")) return Response.json({ frozen: true });
+    return Response.json([]);
+  });
+});
+
+afterEach(() => {
+  cleanup();
+  fetchSpy.mockRestore();
+  dom.window.close();
+  for (const [key, descriptor] of originalGlobals) {
+    if (descriptor) Object.defineProperty(globalThis, key, descriptor);
+    else Reflect.deleteProperty(globalThis, key);
+  }
+  originalGlobals.clear();
+});
+
+function view(id = "brief-1") {
+  return <BriefReviewView id={id} theme="dark" onToggleTheme={() => {}} onBack={() => {}} />;
+}
+
+test("approved brief can POST a build and shows the returned session", async () => {
+  brief.id = "brief/encoded";
+  const ui = render(view(brief.id));
+  const button = await ui.findByRole("button", { name: "Run build" });
+  expect((button as HTMLButtonElement).disabled).toBe(false);
+  fireEvent.click(button);
+  const status = await ui.findByRole("status");
+  expect(status.textContent).toContain("Build started");
+  expect(status.textContent).toContain("session-1");
+  expect(ui.getByRole("link", { name: "Session session-1" }).getAttribute("href"))
+    .toBe("#sid=session-1");
+  expect(buildRequests).toEqual([{ url: "/briefs/brief%2Fencoded/build", method: "POST" }]);
+  expect((button as HTMLButtonElement).disabled).toBe(true);
+});
+
+for (const status of ["pending_approval", "rejected", "superseded"] as const) {
+  test(`${status} brief does not offer Run build`, async () => {
+    brief.status = status;
+    const ui = render(view());
+    await ui.findByText(`Brief review — ${status}`);
+    expect(ui.queryByRole("button", { name: "Run build" })).toBeNull();
+    expect(buildRequests).toHaveLength(0);
+  });
+}
+
+test("pending build disables the button and prevents duplicate POSTs", async () => {
+  let resolve!: (res: Response) => void;
+  buildResponse = () => new Promise((r) => { resolve = r; });
+  const ui = render(view());
+  fireEvent.click(await ui.findByRole("button", { name: "Run build" }));
+  const pending = ui.getByRole("button", { name: "Starting build…" });
+  expect((pending as HTMLButtonElement).disabled).toBe(true);
+  fireEvent.click(pending);
+  expect(buildRequests).toHaveLength(1);
+  await act(async () => { resolve(Response.json({ session_ref: "session-1" })); });
+  await ui.findByRole("status");
+});
+
+test("conflict is shown to the operator and allows a retry", async () => {
+  buildResponse = async () => Response.json({ error: "a build is already running for this cohort" }, { status: 409 });
+  const ui = render(view());
+  fireEvent.click(await ui.findByRole("button", { name: "Run build" }));
+  expect((await ui.findByRole("alert")).textContent).toContain("already running");
+  expect((ui.getByRole("button", { name: "Run build" }) as HTMLButtonElement).disabled).toBe(false);
+  buildResponse = async () => Response.json({ session_ref: "retry-session" });
+  fireEvent.click(ui.getByRole("button", { name: "Run build" }));
+  expect((await ui.findByRole("status")).textContent).toContain("retry-session");
+  expect(ui.queryByRole("alert")).toBeNull();
+});
+
+test("network failure is rendered and does not leave the button pending", async () => {
+  buildResponse = async () => { throw new Error("Network unavailable"); };
+  const ui = render(view());
+  fireEvent.click(await ui.findByRole("button", { name: "Run build" }));
+  expect((await ui.findByRole("alert")).textContent).toContain("Network unavailable");
+  expect((ui.getByRole("button", { name: "Run build" }) as HTMLButtonElement).disabled).toBe(false);
+});
+
+test("switching briefs resets the returned-session status", async () => {
+  const ui = render(view());
+  fireEvent.click(await ui.findByRole("button", { name: "Run build" }));
+  await ui.findByRole("status");
+  brief = { ...brief, id: "brief-2" };
+  ui.rerender(view("brief-2"));
+  await waitFor(() => {
+    expect((ui.getByRole("button", { name: "Run build" }) as HTMLButtonElement).disabled).toBe(false);
+    expect(ui.queryByRole("status")).toBeNull();
+  });
+});
