index 0000000000000000000000000000000000000000..b1868da1b3b673ec3bf5d4c029a42e7e2504a932
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,72 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+
+function setup(status?: "running" | "completed" | "failed") {
+  const db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES (?, ?, ?)").run(
+    "project-1", "test", "/tmp/test",
+  );
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES (?, ?, ?)").run(
+    "spec-1", "project-1", "test spec",
+  );
+  db.prepare("INSERT INTO plans (id, spec_id) VALUES (?, ?)").run("plan-1", "spec-1");
+  db.prepare(
+    "INSERT INTO cohorts (id, plan_id, title, position, status) VALUES (?, ?, ?, ?, ?)",
+  ).run("cohort-1", "plan-1", "test cohort", 0, "building");
+  db.prepare(
+    "INSERT INTO briefs (id, cohort_id, status, goal) VALUES (?, ?, ?, ?)",
+  ).run("brief-1", "cohort-1", "approved", "test build");
+
+  const calls: [string, string][] = [];
+  const dispatcher = {
+    async dispatch(stage: string, id: string) {
+      calls.push([stage, id]);
+      return "session-1";
+    },
+    ...(status ? { async status() { return status; } } : {}),
+  };
+  const app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher });
+  return { app, db, calls };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("returns 404 when the brief does not exist", async () => {
+    const { app, db, calls } = setup();
+    const res = await app.request("/briefs/missing/build", { method: "POST" });
+    expect(res.status).toBe(404);
+    expect(calls).toHaveLength(0);
+    db.close();
+  });
+
+  test("requires an approved brief", async () => {
+    const { app, db, calls } = setup();
+    db.prepare("UPDATE briefs SET status = 'pending_approval' WHERE id = ?").run("brief-1");
+    const res = await app.request("/briefs/brief-1/build", { method: "POST" });
+    expect(res.status).toBe(409);
+    expect(calls).toHaveLength(0);
+    db.close();
+  });
+
+  test("dispatches approved briefs and returns the session reference", async () => {
+    const { app, db, calls } = setup();
+    const res = await app.request("/briefs/brief-1/build", { method: "POST" });
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "session-1" });
+    expect(calls).toEqual([["build", "brief-1"]]);
+    db.close();
+  });
+
+  test("rejects a second build while the cohort session is running", async () => {
+    const { app, db, calls } = setup("running");
+    db.prepare("UPDATE cohorts SET current_session_ref = ? WHERE id = ?").run(
+      "active-session", "cohort-1",
+    );
+    const res = await app.request("/briefs/brief-1/build", { method: "POST" });
+    expect(res.status).toBe(409);
+    expect(calls).toHaveLength(0);
+    db.close();
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..178c4e58bacd6d2ab67f9d13347d5059b24e315a
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,75 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+
+export interface BuildDispatcher {
+  dispatch(stageName: string, inputId: string): Promise<string>;
+  /** Optional for lightweight test dispatchers; production dispatchers expose it. */
+  status?(sessionRef: string): Promise<"running" | "completed" | "failed">;
+}
+
+interface BuildsRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+interface BriefBuildRow {
+  id: string;
+  cohort_id: string;
+  status: string;
+}
+
+interface CohortSessionRow {
+  current_session_ref: string | null;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Covers overlapping requests during the async dispatch call, before the
+  // dispatcher has persisted its session reference on the cohort.
+  const dispatchingCohorts = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = db
+      .prepare<BriefBuildRow, [string]>(
+        "SELECT id, cohort_id, status FROM briefs WHERE id = ?",
+      )
+      .get(briefId);
+
+    if (!brief) return c.json({ error: "brief not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+    if (dispatchingCohorts.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    dispatchingCohorts.add(brief.cohort_id);
+    try {
+      const cohort = db
+        .prepare<CohortSessionRow, [string]>(
+          "SELECT current_session_ref FROM cohorts WHERE id = ?",
+        )
+        .get(brief.cohort_id);
+
+      if (cohort?.current_session_ref) {
+        // The cohort ref may belong to planner2 or an earlier build. Use the
+        // backend lifecycle state when available rather than treating any
+        // historical ref as an active build.
+        const state = dispatcher.status
+          ? await dispatcher.status(cohort.current_session_ref)
+          : "running";
+        if (state === "running") {
+          return c.json({ error: "a build is already running for this cohort" }, 409);
+        }
+      }
+
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    } finally {
+      dispatchingCohorts.delete(brief.cohort_id);
+    }
+  });
+}
