index 0000000000000000000000000000000000000000..fa55bbd6b1f23c14bda8c19d66554230ecead8cc
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,56 @@
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { insertProject } from "../../db/projects";
+import { insertSpec } from "../../db/specs";
+import { insertPlan } from "../../db/plans";
+import { insertCohort } from "../../db/cohorts";
+import { insertBrief } from "../../db/briefs";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+let app: Hono;
+let calls: Array<[string, string]>;
+let running = false;
+
+beforeEach(() => {
+  db = openTestDb();
+  insertProject(db, { id: "p", name: "P", repo_path: "/repo" });
+  insertSpec(db, { id: "s", project_id: "p", title: "Spec" });
+  insertPlan(db, { id: "pl", spec_id: "s" });
+  insertCohort(db, { id: "c", plan_id: "pl", title: "Cohort", position: 1 });
+  calls = [];
+  running = false;
+  app = new Hono();
+  mountBuildsRoutes(app, {
+    db,
+    dispatcher: {
+      dispatch: async (stage, id) => { calls.push([stage, id]); db.prepare("UPDATE cohorts SET current_session_ref = 'sid-1' WHERE id = 'c'").run(); return "sid-1"; },
+      status: async () => running ? "running" : "failed",
+    },
+  });
+});
+
+afterEach(() => db.close());
+
+describe("POST /briefs/:id/build", () => {
+  test("404s missing briefs and rejects unapproved briefs", async () => {
+    expect((await app.request("/briefs/missing/build", { method: "POST" })).status).toBe(404);
+    insertBrief(db, { id: "b", cohort_id: "c", goal: "G", files_in_scope: [], decisions_made: [], approaches_rejected: [], next_action: "N" });
+    expect((await app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+    expect(calls).toHaveLength(0);
+  });
+
+  test("dispatches approved brief and refuses an already running cohort build", async () => {
+    insertBrief(db, { id: "b", cohort_id: "c", goal: "G", files_in_scope: [], decisions_made: [], approaches_rejected: [], next_action: "N" });
+    db.prepare("UPDATE briefs SET status = 'approved' WHERE id = 'b'").run();
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "sid-1" });
+    expect(calls).toEqual([["build", "b"]]);
+    running = true;
+    expect((await app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+    expect(calls).toHaveLength(1);
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..75fac7df81627c297a3569a6740df9641ed6b9d4
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,66 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+
+export interface BuildDispatcher {
+  dispatch(stageName: string, inputId: string): Promise<string>;
+  /** Lifecycle lookup for a session ref currently stored on the cohort. */
+  status?(sessionRef: string): Promise<"running" | "completed" | "failed">;
+}
+
+interface BuildsRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // In-process reservation closes the gap before dispatch has persisted its
+  // session ref on the cohort, including while the status lookup is pending.
+  const dispatching = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    const cohort = db.prepare<{ id: string; current_session_ref: string | null }, [string]>(
+      "SELECT id, current_session_ref FROM cohorts WHERE id = ?",
+    ).get(brief.cohort_id);
+    if (!cohort) return c.json({ error: "cohort not found" }, 404);
+
+    if (dispatching.has(cohort.id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+    dispatching.add(cohort.id);
+
+    try {
+      if (cohort.current_session_ref) {
+        if (!dispatcher.status) {
+          // Never launch a duplicate if an active session cannot be ruled out.
+          return c.json({ error: "unable to determine whether a build is running" }, 503);
+        }
+        let state: "running" | "completed" | "failed";
+        try {
+          state = await dispatcher.status(cohort.current_session_ref);
+        } catch (err) {
+          console.error("builds:status lookup failed", err);
+          return c.json({ error: "unable to determine whether a build is running" }, 503);
+        }
+        if (state === "running") {
+          return c.json({ error: "a build is already running for this cohort" }, 409);
+        }
+      }
+
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    } finally {
+      dispatching.delete(cohort.id);
+    }
+  });
+}
