index 0000000000000000000000000000000000000000..50d8553d193dc71528f2a1f90393794b6a9cea58
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,57 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { insertBrief } from "../../db/briefs";
+import { mountBuildsRoutes } from "./builds";
+
+function fixture() {
+  const db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES (?, ?, ?)").run("p", "project", "/tmp/project");
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES (?, ?, ?)").run("s", "p", "spec");
+  db.prepare("INSERT INTO plans (id, spec_id, status) VALUES (?, ?, ?)").run("pl", "s", "approved");
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position) VALUES (?, ?, ?, ?)").run("c", "pl", "cohort", 0);
+  const brief = insertBrief(db, {
+    id: "b", cohort_id: "c", goal: "goal", files_in_scope: [],
+    decisions_made: [], approaches_rejected: [], next_action: "next",
+  });
+  return { db, brief };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("returns 404 for a missing brief and 409 unless approved", async () => {
+    const { db } = fixture();
+    const app = new Hono();
+    mountBuildsRoutes(app, { db, dispatcher: { dispatch: async () => "sid", status: async () => "failed" } });
+
+    expect((await app.request("/briefs/missing/build", { method: "POST" })).status).toBe(404);
+    expect((await app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+    db.close();
+  });
+
+  test("dispatches an approved brief and refuses a running cohort build", async () => {
+    const { db } = fixture();
+    db.prepare("UPDATE briefs SET status = 'approved' WHERE id = 'b'").run();
+    const calls: string[] = [];
+    let status: "running" | "completed" | "failed" = "failed";
+    const app = new Hono();
+    mountBuildsRoutes(app, {
+      db,
+      dispatcher: {
+        dispatch: async (stage, id) => { calls.push(`${stage}:${id}`); return "new-session"; },
+        status: async () => status,
+      },
+    });
+
+    const first = await app.request("/briefs/b/build", { method: "POST" });
+    expect(first.status).toBe(200);
+    expect(await first.json()).toEqual({ session_ref: "new-session" });
+    expect(calls).toEqual(["build:b"]);
+
+    db.prepare("UPDATE cohorts SET current_session_ref = 'existing' WHERE id = 'c'").run();
+    status = "running";
+    const second = await app.request("/briefs/b/build", { method: "POST" });
+    expect(second.status).toBe(409);
+    expect(calls).toHaveLength(1);
+    db.close();
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..10f64ebe663b65816102442b63264c38f354a5d5
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,53 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+
+interface BuildsRouteDeps {
+  dispatcher: Dispatcher;
+  db: Database;
+}
+
+/** Registers the explicit operator-triggered build endpoint. */
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Protect against duplicate requests while dispatch is still spawning and
+  // before the dispatcher has persisted the session ref on the cohort.
+  const dispatchingCohorts = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    const cohort = db
+      .prepare<{ id: string; current_session_ref: string | null }, [string]>(
+        "SELECT id, current_session_ref FROM cohorts WHERE id = ?",
+      )
+      .get(brief.cohort_id);
+    if (!cohort) return c.json({ error: "cohort not found" }, 404);
+
+    if (dispatchingCohorts.has(cohort.id)) {
+      return c.json({ error: "build already running for cohort" }, 409);
+    }
+    // Reserve synchronously before the first await to serialize simultaneous
+    // requests for the same cohort in this process.
+    dispatchingCohorts.add(cohort.id);
+    try {
+      if (cohort.current_session_ref) {
+        if (await dispatcher.status(cohort.current_session_ref) === "running") {
+          return c.json({ error: "build already running for cohort" }, 409);
+        }
+      }
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to dispatch build" }, 500);
+    } finally {
+      dispatchingCohorts.delete(cohort.id);
+    }
+  });
+}
