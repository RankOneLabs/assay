diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..985c28ef8d41ae7c26ab0088111988a321226d71
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+
+function setup(status: "running" | "completed" | "failed" = "failed") {
+  const db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES (?, ?, ?)").run("p", "project", "/repo");
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES (?, ?, ?)").run("s", "p", "spec");
+  db.prepare("INSERT INTO plans (id, spec_id, status) VALUES (?, ?, ?)").run("pl", "s", "approved");
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position) VALUES (?, ?, ?, ?)").run("c", "pl", "cohort", 0);
+  db.prepare(`INSERT INTO briefs (id, cohort_id, status, goal) VALUES (?, ?, ?, ?)`)
+    .run("b", "c", "approved", "goal");
+  let calls = 0;
+  const dispatcher = {
+    dispatch: async (stage: string, id: string) => {
+      calls++;
+      expect(stage).toBe("build");
+      expect(id).toBe("b");
+      return "session-1";
+    },
+    status: async () => status,
+  };
+  const app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher });
+  return { db, app, get calls() { return calls; } };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("404 for a missing brief", async () => {
+    const { db, app } = setup();
+    const response = await app.request("/briefs/missing/build", { method: "POST" });
+    expect(response.status).toBe(404);
+    db.close();
+  });
+
+  test("409 unless the brief is approved", async () => {
+    const { db, app, calls } = setup();
+    db.prepare("UPDATE briefs SET status = 'pending_approval' WHERE id = 'b'").run();
+    const response = await app.request("/briefs/b/build", { method: "POST" });
+    expect(response.status).toBe(409);
+    expect(calls).toBe(0);
+    db.close();
+  });
+
+  test("dispatches approved brief and returns session reference", async () => {
+    const context = setup();
+    const response = await context.app.request("/briefs/b/build", { method: "POST" });
+    expect(response.status).toBe(202);
+    expect(await response.json()).toEqual({ session_ref: "session-1" });
+    expect(context.calls).toBe(1);
+    const { db } = context;
+    db.close();
+  });
+
+  test("409 when the cohort build session is running", async () => {
+    const { db, app, calls } = setup("running");
+    db.prepare("UPDATE cohorts SET current_session_ref = 'active' WHERE id = 'c'").run();
+    const response = await app.request("/briefs/b/build", { method: "POST" });
+    expect(response.status).toBe(409);
+    expect(calls).toBe(0);
+    db.close();
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fd314d1a557111d177d0f5c460c6b43f1a9883f8
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,69 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import type { createDispatcher } from "../../orchestrator/backends/dispatcher";
+
+export type BuildDispatcher = Pick<ReturnType<typeof createDispatcher>, "dispatch"> &
+  Partial<Pick<ReturnType<typeof createDispatcher>, "status">>;
+
+interface BuildRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+interface BriefBuildRow {
+  id: string;
+  cohort_id: string;
+  status: string;
+}
+
+interface CohortBuildRow {
+  current_session_ref: string | null;
+}
+
+/** Routes an approved brief to the build stage. */
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildRouteDeps): void {
+  const buildsStarting = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = db
+      .prepare<BriefBuildRow, [string]>(
+        "SELECT id, cohort_id, status FROM briefs WHERE id = ?",
+      )
+      .get(briefId);
+
+    if (!brief) return c.json({ error: "brief not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    const cohort = db
+      .prepare<CohortBuildRow, [string]>(
+        "SELECT current_session_ref FROM cohorts WHERE id = ?",
+      )
+      .get(brief.cohort_id);
+    if (!cohort) return c.json({ error: "cohort not found" }, 404);
+    if (buildsStarting.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already starting for this cohort" }, 409);
+    }
+    if (cohort.current_session_ref) {
+      const status = dispatcher.status
+        ? await dispatcher.status(cohort.current_session_ref)
+        : "running";
+      if (status === "running") {
+        return c.json({ error: "a build is already running for this cohort" }, 409);
+      }
+    }
+
+    buildsStarting.add(brief.cohort_id);
+    try {
+      const session_ref = await dispatcher.dispatch("build", brief.id);
+      return c.json({ session_ref }, 202);
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    } finally {
+      buildsStarting.delete(brief.cohort_id);
+    }
+  });
+}
