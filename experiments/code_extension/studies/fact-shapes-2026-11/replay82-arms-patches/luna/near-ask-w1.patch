index 0000000000000000000000000000000000000000..347ca9ab948604bcfcbcbfe49e5c27fa99c0d734
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,51 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+
+function fixture() {
+  const db = openTestDb();
+  db.exec(`
+    INSERT INTO projects (id, name, repo_path) VALUES ('p', 'project', '/repo');
+    INSERT INTO specs (id, project_id, title) VALUES ('s', 'p', 'spec');
+    INSERT INTO plans (id, spec_id) VALUES ('pl', 's');
+    INSERT INTO cohorts (id, plan_id, title, position, status) VALUES ('c', 'pl', 'cohort', 0, 'building');
+    INSERT INTO briefs (id, cohort_id, goal, files_in_scope, decisions_made, approaches_rejected, next_action, status)
+      VALUES ('b', 'c', 'goal', '[]', '[]', '[]', 'next', 'approved');
+  `);
+  const calls: string[] = [];
+  const dispatcher = {
+    dispatch: async (stageName: string, inputId: string) => {
+      calls.push(`${stageName}:${inputId}`);
+      db.prepare("UPDATE cohorts SET current_session_ref = 'session' WHERE id = 'c'").run();
+      return "session";
+    },
+    status: async () => "running" as const,
+  };
+  const app = new Hono();
+  mountBuildsRoutes(app, { dispatcher, db });
+  return { db, app, calls };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("dispatches approved brief and returns session_ref", async () => {
+    const { db, app, calls } = fixture();
+    const response = await app.request("/briefs/b/build", { method: "POST" });
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ session_ref: "session" });
+    expect(calls).toEqual(["build:b"]);
+    db.close();
+  });
+
+  test("checks missing, unapproved, and already-running cases", async () => {
+    const { db, app, calls } = fixture();
+    expect((await app.request("/briefs/missing/build", { method: "POST" })).status).toBe(404);
+    db.prepare("UPDATE briefs SET status = 'pending_approval' WHERE id = 'b'").run();
+    expect((await app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+    db.prepare("UPDATE briefs SET status = 'approved' WHERE id = 'b'").run();
+    db.prepare("UPDATE cohorts SET current_session_ref = 'old' WHERE id = 'c'").run();
+    expect((await app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+    expect(calls).toEqual([]);
+    db.close();
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7183646a5e2f909155bdc96efa5f9f68b53e20d1
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,66 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+
+export interface BuildDispatcher {
+  dispatch(stageName: string, inputId: string): Promise<string>;
+  isBuildRunningForCohort?(cohortId: string): Promise<boolean>;
+  status?(sessionRef: string): Promise<"running" | "completed" | "failed">;
+}
+
+interface BuildRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+interface BriefRow {
+  id: string;
+  status: string;
+  cohort_id: string;
+}
+
+interface CohortRow {
+  current_session_ref: string | null;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildRouteDeps): void {
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = db
+      .prepare<BriefRow, [string]>("SELECT id, status, cohort_id FROM briefs WHERE id = ?")
+      .get(briefId);
+    if (!brief) return c.json({ error: "brief not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    if (dispatcher.isBuildRunningForCohort) {
+      if (await dispatcher.isBuildRunningForCohort(brief.cohort_id)) {
+        return c.json({ error: "a build is already running for this cohort" }, 409);
+      }
+    } else {
+      const cohort = db
+        .prepare<CohortRow, [string]>("SELECT current_session_ref FROM cohorts WHERE id = ?")
+        .get(brief.cohort_id);
+      if (cohort?.current_session_ref) {
+        let running = true;
+        if (dispatcher.status) {
+          try {
+            running = (await dispatcher.status(cohort.current_session_ref)) === "running";
+          } catch (err) {
+            console.error("builds: session status lookup failed", err);
+            running = true;
+          }
+        }
+        if (running) return c.json({ error: "a build is already running for this cohort" }, 409);
+      }
+    }
+
+    try {
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds: dispatch failed", err);
+      return c.json({ error: "failed to dispatch build" }, 500);
+    }
+  });
+}
