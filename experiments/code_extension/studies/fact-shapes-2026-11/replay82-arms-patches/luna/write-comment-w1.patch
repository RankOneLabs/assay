index 0000000000000000000000000000000000000000..f9888a8b67e883ff31012a7812eab5e7e3fdb295
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,62 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+
+interface BuildsRouteDeps {
+  dispatcher: Dispatcher;
+  db: Database;
+}
+
+/** Register the explicit, operator-triggered build endpoint. */
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Protect against simultaneous requests in this process while dispatch is
+  // awaiting backend startup and before its session_ref is persisted.
+  const dispatchingCohorts = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief is not approved" }, 409);
+    }
+
+    const cohort = db
+      .prepare<{ id: string; current_session_ref: string | null }, [string]>(
+        "SELECT id, current_session_ref FROM cohorts WHERE id = ?",
+      )
+      .get(brief.cohort_id);
+    if (!cohort) return c.json({ error: "cohort not found" }, 404);
+
+    if (dispatchingCohorts.has(cohort.id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    if (cohort.current_session_ref) {
+      let status: "running" | "completed" | "failed";
+      try {
+        status = dispatcher.status
+          ? await dispatcher.status(cohort.current_session_ref)
+          : "running";
+      } catch (err) {
+        console.error("builds:session status lookup failed", err);
+        return c.json({ error: "could not determine whether a build is already running" }, 503);
+      }
+      if (status === "running") {
+        return c.json({ error: "a build is already running for this cohort" }, 409);
+      }
+    }
+
+    dispatchingCohorts.add(cohort.id);
+    try {
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "build dispatch failed" }, 500);
+    } finally {
+      dispatchingCohorts.delete(cohort.id);
+    }
+  });
+}
