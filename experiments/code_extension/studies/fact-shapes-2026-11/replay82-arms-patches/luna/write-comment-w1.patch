index 0000000000000000000000000000000000000000..f5d61d9f8e8329245edbdbf981d657cabd90aa74
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+
+function setup(status = "approved", currentSessionRef: string | null = null) {
+  const db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES (?, ?, ?)").run("p", "project", "/tmp/project");
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES (?, ?, ?)").run("s", "p", "spec");
+  db.prepare("INSERT INTO plans (id, spec_id, status) VALUES (?, ?, 'approved')").run("pl", "s");
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position, status, current_session_ref) VALUES (?, ?, ?, ?, 'building', ?)")
+    .run("c", "pl", "cohort", 0, currentSessionRef);
+  db.prepare("INSERT INTO briefs (id, cohort_id, status, goal) VALUES (?, ?, ?, ?)")
+    .run("b", "c", status, "goal");
+  const dispatched: [string, string][] = [];
+  let sessionStatus: "running" | "completed" | "failed" = "failed";
+  const dispatcher: Dispatcher = {
+    async dispatch(stage, id) {
+      dispatched.push([stage, id]);
+      db.prepare("UPDATE cohorts SET current_session_ref = 'new-session' WHERE id = 'c'").run();
+      return "new-session";
+    },
+    async status() { return sessionStatus; },
+  };
+  const app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher });
+  return { app, db, dispatched, setSessionStatus: (s: typeof sessionStatus) => { sessionStatus = s; } };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("returns 404 when the brief is missing", async () => {
+    const { app, db } = setup();
+    const res = await app.request("/briefs/missing/build", { method: "POST" });
+    expect(res.status).toBe(404);
+    db.close();
+  });
+
+  test("requires an approved brief", async () => {
+    const { app, db, dispatched } = setup("pending_approval");
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(409);
+    expect(dispatched).toEqual([]);
+    db.close();
+  });
+
+  test("dispatches build and returns the session reference", async () => {
+    const { app, db, dispatched } = setup();
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "new-session" });
+    expect(dispatched).toEqual([["build", "b"]]);
+    db.close();
+  });
+
+  test("rejects when the cohort already has a running build session", async () => {
+    const { app, db, dispatched, setSessionStatus } = setup("approved", "previous-session");
+    setSessionStatus("running");
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(409);
+    expect(dispatched).toEqual([]);
+    db.close();
+  });
+});
