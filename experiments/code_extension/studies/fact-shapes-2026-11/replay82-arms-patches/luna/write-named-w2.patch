+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+let app: Hono;
+let dispatchCalls: string[][];
+let sessionStatus: "running" | "completed" | "failed";
+
+beforeEach(() => {
+  db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES ('p', 'project', '/tmp/project')").run();
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES ('s', 'p', 'spec')").run();
+  db.prepare("INSERT INTO plans (id, spec_id, status) VALUES ('pl', 's', 'approved')").run();
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position, status) VALUES ('c', 'pl', 'cohort', 0, 'building')").run();
+  db.prepare("INSERT INTO briefs (id, cohort_id, status, goal, next_action) VALUES ('b', 'c', 'approved', 'goal', 'next')").run();
+  dispatchCalls = [];
+  sessionStatus = "completed";
+  app = new Hono();
+  mountBuildsRoutes(app, {
+    db,
+    dispatcher: {
+      dispatch: async (stage, id) => { dispatchCalls.push([stage, id]); return "session-1"; },
+      status: async () => sessionStatus,
+    },
+  });
+});
+
+afterEach(() => db.close());
+
+describe("POST /briefs/:id/build", () => {
+  test("dispatches a build for approved briefs and returns the session ref", async () => {
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "session-1" });
+    expect(dispatchCalls).toEqual([["build", "b"]]);
+  });
+
+  test("returns 404 for a missing brief", async () => {
+    const res = await app.request("/briefs/missing/build", { method: "POST" });
+    expect(res.status).toBe(404);
+    expect(dispatchCalls).toHaveLength(0);
+  });
+
+  test("requires an approved brief", async () => {
+    db.prepare("UPDATE briefs SET status = 'pending_approval' WHERE id = 'b'").run();
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(409);
+  });
+
+  test("rejects a cohort with a running build session", async () => {
+    db.prepare("UPDATE cohorts SET current_session_ref = 'already-running' WHERE id = 'c'").run();
+    sessionStatus = "running";
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(409);
+    expect(dispatchCalls).toHaveLength(0);
+  });
+});
