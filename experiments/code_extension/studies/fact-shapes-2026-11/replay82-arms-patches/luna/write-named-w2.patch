+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,66 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+
+export interface BuildDispatcher {
+  dispatch(stageName: string, inputId: string): Promise<string>;
+  /** Optional lifecycle lookup; production dispatchers expose this to distinguish stale refs. */
+  status?(session_ref: string): Promise<"running" | "completed" | "failed">;
+}
+
+interface BuildsRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Serializes concurrent requests while the first one is dispatching, before
+  // current_session_ref is persisted by the dispatcher.
+  const building = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "brief not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    const cohort = db
+      .prepare<{ current_session_ref: string | null }, [string]>(
+        "SELECT current_session_ref FROM cohorts WHERE id = ?",
+      )
+      .get(brief.cohort_id);
+    if (!cohort) return c.json({ error: "cohort not found" }, 404);
+
+    if (building.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+    building.add(brief.cohort_id);
+    try {
+      if (cohort.current_session_ref) {
+        let isRunning = true;
+        if (dispatcher.status) {
+          try {
+            isRunning = (await dispatcher.status(cohort.current_session_ref)) === "running";
+          } catch (err) {
+            // Fail closed: if status cannot be read, don't risk spawning a
+            // second build over a session that may still be active.
+            console.error("builds: failed to check existing session status", err);
+          }
+        }
+        if (isRunning) {
+          return c.json({ error: "a build is already running for this cohort" }, 409);
+        }
+      }
+
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds: dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    } finally {
+      building.delete(brief.cohort_id);
+    }
+  });
+}
