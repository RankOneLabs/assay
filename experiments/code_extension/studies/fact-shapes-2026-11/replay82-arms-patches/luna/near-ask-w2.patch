+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes, type BuildDispatcher } from "./builds";
+
+function seedBrief(db: ReturnType<typeof openTestDb>, status = "approved"): void {
+  db.exec(`
+    INSERT INTO projects (id, name, repo_path) VALUES ('p', 'project', '/tmp/project');
+    INSERT INTO specs (id, project_id, title) VALUES ('s', 'p', 'spec');
+    INSERT INTO plans (id, spec_id, status) VALUES ('pl', 's', 'approved');
+    INSERT INTO cohorts (id, plan_id, title, position) VALUES ('c', 'pl', 'cohort', 1);
+  `);
+  db.prepare("INSERT INTO briefs (id, cohort_id, status, goal) VALUES ('b', 'c', ?, 'goal')").run(status);
+}
+
+function makeApp(db: ReturnType<typeof openTestDb>, dispatcher: BuildDispatcher): Hono {
+  const app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher });
+  return app;
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("404s for a missing brief", async () => {
+    const db = openTestDb();
+    try {
+      const app = makeApp(db, { dispatch: async () => "session" });
+      const response = await app.request("/briefs/missing/build", { method: "POST" });
+      expect(response.status).toBe(404);
+    } finally {
+      db.close();
+    }
+  });
+
+  test("requires approval, then dispatches and returns the session reference", async () => {
+    const db = openTestDb();
+    try {
+      seedBrief(db, "pending_approval");
+      const calls: string[][] = [];
+      const app = makeApp(db, {
+        dispatch: async (stage, id) => {
+          calls.push([stage, id]);
+          db.prepare("UPDATE cohorts SET current_session_ref = 'session-1' WHERE id = 'c'").run();
+          return "session-1";
+        },
+      });
+      const rejected = await app.request("/briefs/b/build", { method: "POST" });
+      expect(rejected.status).toBe(409);
+      db.prepare("UPDATE briefs SET status = 'approved' WHERE id = 'b'").run();
+      const response = await app.request("/briefs/b/build", { method: "POST" });
+      expect(response.status).toBe(200);
+      expect(await response.json()).toEqual({ session_ref: "session-1" });
+      expect(calls).toEqual([["build", "b"]]);
+    } finally {
+      db.close();
+    }
+  });
+
+  test("returns conflict while the cohort build session is running", async () => {
+    const db = openTestDb();
+    try {
+      seedBrief(db);
+      db.prepare("UPDATE cohorts SET current_session_ref = 'session-1' WHERE id = 'c'").run();
+      let dispatched = false;
+      const app = makeApp(db, {
+        dispatch: async () => { dispatched = true; return "session-2"; },
+        status: async () => "running",
+      });
+      const response = await app.request("/briefs/b/build", { method: "POST" });
+      expect(response.status).toBe(409);
+      expect(dispatched).toBe(false);
+    } finally {
+      db.close();
+    }
+  });
+});
