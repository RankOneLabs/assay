index 0000000000000000000000000000000000000000..3c09f3b08cdc6838d8c716543e6a72a2d0a107a7
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,79 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+
+interface BuildRouteDeps {
+  dispatcher: Dispatcher;
+  db: Database;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildRouteDeps): void {
+  const activeBuilds = new Set<string>();
+  const dispatchedBuilds = new Map<string, string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = db
+      .prepare<{ id: string; cohort_id: string; status: string }, [string]>(
+        "SELECT id, cohort_id, status FROM briefs WHERE id = ?",
+      )
+      .get(briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    const cohort = db
+      .prepare<{ current_session_ref: string | null }, [string]>(
+        "SELECT current_session_ref FROM cohorts WHERE id = ?",
+      )
+      .get(brief.cohort_id);
+
+    // The dispatcher exposes lifecycle status when available. This distinguishes
+    // an active build from a completed planner session stored on the same cohort.
+    // Keep a local guard as well, so concurrent requests cannot both start a build
+    // while the first backend dispatch is still resolving.
+    const key = brief.cohort_id;
+    const knownBuild = dispatchedBuilds.get(key);
+    if (knownBuild) {
+      try {
+        const status = dispatcher.status
+          ? await dispatcher.status(knownBuild)
+          : "running";
+        if (status === "running") {
+          return c.json({ error: "a build is already running for this cohort" }, 409);
+        }
+        dispatchedBuilds.delete(key);
+      } catch (err) {
+        console.error("builds:status lookup failed", err);
+        return c.json({ error: "unable to determine whether a build is already running" }, 409);
+      }
+    } else if (cohort?.current_session_ref && dispatcher.status) {
+      // A pre-existing ref may be from planner2, so status alone isn't enough
+      // to confidently identify it as a build. Build refs started by this route
+      // are tracked explicitly above.
+      try {
+        if (await dispatcher.status(cohort.current_session_ref) === "running") {
+          return c.json({ error: "a build is already running for this cohort" }, 409);
+        }
+      } catch (err) {
+        console.error("builds:status lookup failed", err);
+      }
+    }
+
+    if (activeBuilds.has(key)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+    activeBuilds.add(key);
+    try {
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      dispatchedBuilds.set(key, session_ref);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    } finally {
+      activeBuilds.delete(key);
+    }
+  });
+}
