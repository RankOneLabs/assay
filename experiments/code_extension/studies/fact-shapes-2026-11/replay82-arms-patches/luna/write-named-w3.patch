@@ -0,0 +1,71 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+
+function fixture() {
+  const db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES (?, ?, ?)").run(
+    "project-1", "Project", "/tmp/project",
+  );
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES (?, ?, ?)").run(
+    "spec-1", "project-1", "Spec",
+  );
+  db.prepare("INSERT INTO plans (id, spec_id, status) VALUES (?, ?, ?)").run(
+    "plan-1", "spec-1", "approved",
+  );
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position) VALUES (?, ?, ?, ?)").run(
+    "cohort-1", "plan-1", "Cohort", 1,
+  );
+  db.prepare(`INSERT INTO briefs (id, cohort_id, status, goal) VALUES (?, ?, ?, ?)`).run(
+    "brief-1", "cohort-1", "approved", "Build it",
+  );
+  const app = new Hono();
+  return { db, app };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("checks brief status and dispatches an approved brief", async () => {
+    const { db, app } = fixture();
+    const calls: [string, string][] = [];
+    mountBuildsRoutes(app, {
+      db,
+      dispatcher: {
+        dispatch: async (stage, id) => {
+          calls.push([stage, id]);
+          return "session-1";
+        },
+        status: async () => "completed",
+      },
+    });
+
+    const missing = await app.request("/briefs/missing/build", { method: "POST" });
+    expect(missing.status).toBe(404);
+    db.prepare("UPDATE briefs SET status = 'pending_approval' WHERE id = ?").run("brief-1");
+    const pending = await app.request("/briefs/brief-1/build", { method: "POST" });
+    expect(pending.status).toBe(409);
+    db.prepare("UPDATE briefs SET status = 'approved' WHERE id = ?").run("brief-1");
+    const built = await app.request("/briefs/brief-1/build", { method: "POST" });
+    expect(built.status).toBe(200);
+    expect(await built.json()).toEqual({ session_ref: "session-1" });
+    expect(calls).toEqual([["build", "brief-1"]]);
+    db.close();
+  });
+
+  test("rejects dispatch when a build session is already running on its cohort", async () => {
+    const { db, app } = fixture();
+    db.prepare("UPDATE cohorts SET current_session_ref = ? WHERE id = ?").run("existing", "cohort-1");
+    let dispatched = false;
+    mountBuildsRoutes(app, {
+      db,
+      dispatcher: {
+        dispatch: async () => { dispatched = true; return "new"; },
+        status: async () => "running",
+      },
+    });
+    const response = await app.request("/briefs/brief-1/build", { method: "POST" });
+    expect(response.status).toBe(409);
+    expect(dispatched).toBe(false);
+    db.close();
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..85e293714ebe850fe9da85e2c7b1ff873274e5c2
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,79 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+
+export interface BuildDispatcher {
+  dispatch(stageName: string, inputId: string): Promise<string>;
+  status?(session_ref: string): Promise<"running" | "completed" | "failed">;
+}
+
+interface BuildsRouteDeps {
+  db: Database;
+  dispatcher: BuildDispatcher | null;
+}
+
+interface BriefBuildRow {
+  id: string;
+  cohort_id: string;
+  status: string;
+}
+
+interface CohortBuildRow {
+  current_session_ref: string | null;
+}
+
+export function mountBuildsRoutes(app: Hono, { db, dispatcher }: BuildsRouteDeps): void {
+  const dispatchingCohorts = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    if (!dispatcher) return c.json({ error: "build dispatcher unavailable" }, 503);
+
+    const briefId = c.req.param("id");
+    const brief = db
+      .prepare<BriefBuildRow, [string]>(
+        "SELECT id, cohort_id, status FROM briefs WHERE id = ?",
+      )
+      .get(briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    const cohort = db
+      .prepare<CohortBuildRow, [string]>(
+        "SELECT current_session_ref FROM cohorts WHERE id = ?",
+      )
+      .get(brief.cohort_id);
+    if (!cohort) return c.json({ error: "cohort not found" }, 404);
+
+    if (dispatchingCohorts.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+    // Reserve before awaiting status so concurrent requests cannot both pass
+    // the persisted-session check and launch duplicate builds.
+    dispatchingCohorts.add(brief.cohort_id);
+    try {
+      if (cohort.current_session_ref) {
+        // Legacy/custom dispatchers without a status lookup must fail closed,
+        // so a persisted session reference cannot be accidentally duplicated.
+        let running = true;
+        if (dispatcher.status) {
+          try {
+            running = (await dispatcher.status(cohort.current_session_ref)) === "running";
+          } catch (err) {
+            console.error("builds:status lookup failed", err);
+            return c.json({ error: "could not determine existing build status" }, 503);
+          }
+        }
+        if (running) return c.json({ error: "a build is already running for this cohort" }, 409);
+      }
+
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to dispatch build" }, 500);
+    } finally {
+      dispatchingCohorts.delete(brief.cohort_id);
+    }
+  });
+}
