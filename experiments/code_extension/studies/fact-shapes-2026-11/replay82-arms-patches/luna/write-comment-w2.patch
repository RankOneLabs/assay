diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6446fc5bd3e8c7a5c5957bac89b1bface9b9b235
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+
+function fixture() {
+  const db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES (?, ?, ?)").run("p1", "P", "/repo");
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES (?, ?, ?)").run("s1", "p1", "Spec");
+  db.prepare("INSERT INTO plans (id, spec_id, status) VALUES (?, ?, 'approved')").run("pl1", "s1");
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position, status) VALUES (?, ?, ?, ?, 'building')").run("c1", "pl1", "Cohort", 0);
+  db.prepare("INSERT INTO briefs (id, cohort_id, status, goal) VALUES (?, ?, 'approved', ?)").run("b1", "c1", "Goal");
+  const calls: Array<[string, string]> = [];
+  let currentStatus: "running" | "completed" | "failed" = "failed";
+  const app = new Hono();
+  mountBuildsRoutes(app, {
+    db,
+    dispatcher: {
+      dispatch: async (stage, id) => {
+        calls.push([stage, id]);
+        currentStatus = "running";
+        db.prepare("UPDATE cohorts SET current_session_ref = ? WHERE id = 'c1'").run("session-1");
+        return "session-1";
+      },
+      status: async () => currentStatus,
+    },
+  });
+  return { app, db, calls };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("dispatches an approved brief and returns the session_ref", async () => {
+    const { app, db, calls } = fixture();
+    try {
+      const res = await app.request("/briefs/b1/build", { method: "POST" });
+      expect(res.status).toBe(200);
+      expect(await res.json()).toEqual({ session_ref: "session-1" });
+      expect(calls).toEqual([["build", "b1"]]);
+    } finally {
+      db.close();
+    }
+  });
+
+  test("returns 404 when the brief does not exist", async () => {
+    const { app, db, calls } = fixture();
+    try {
+      expect((await app.request("/briefs/missing/build", { method: "POST" })).status).toBe(404);
+      expect(calls).toHaveLength(0);
+    } finally {
+      db.close();
+    }
+  });
+
+  test("returns 409 unless the brief is approved", async () => {
+    const { app, db, calls } = fixture();
+    try {
+      db.prepare("UPDATE briefs SET status = 'pending_approval' WHERE id = 'b1'").run();
+      expect((await app.request("/briefs/b1/build", { method: "POST" })).status).toBe(409);
+      expect(calls).toHaveLength(0);
+    } finally {
+      db.close();
+    }
+  });
+
+  test("prevents a second build while the cohort's session is running", async () => {
+    const { app, db, calls } = fixture();
+    try {
+      const first = await app.request("/briefs/b1/build", { method: "POST" });
+      expect(first.status).toBe(200);
+      const second = await app.request("/briefs/b1/build", { method: "POST" });
+      expect(second.status).toBe(409);
+      expect(calls).toHaveLength(1);
+    } finally {
+      db.close();
+    }
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..41ed6165201d03d0239d02ddfeae56c3de7b1212
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,74 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+
+export interface BuildDispatcher {
+  dispatch(stageName: string, inputId: string): Promise<string>;
+  status?(sessionRef: string): Promise<"running" | "completed" | "failed">;
+}
+
+interface BuildsRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+interface CohortBuildState {
+  current_session_ref: string | null;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Guard the small window between checking the existing session and the
+  // dispatcher persisting a newly-created one. The database ref remains the
+  // durable guard across requests; this set only covers concurrent requests.
+  const dispatchingCohorts = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief is not approved" }, 409);
+    }
+
+    const cohort = db
+      .prepare<CohortBuildState, [string]>(
+        "SELECT current_session_ref FROM cohorts WHERE id = ?",
+      )
+      .get(brief.cohort_id);
+    if (!cohort) return c.json({ error: "cohort not found" }, 404);
+
+    if (dispatchingCohorts.has(brief.cohort_id)) {
+      return c.json({ error: "build is already running for this cohort" }, 409);
+    }
+
+    // Claim before the asynchronous status lookup to ensure simultaneous
+    // requests cannot both pass the durable-ref check.
+    dispatchingCohorts.add(brief.cohort_id);
+    try {
+      if (cohort.current_session_ref) {
+        let alreadyRunning = true;
+        if (dispatcher.status) {
+          try {
+            alreadyRunning = (await dispatcher.status(cohort.current_session_ref)) === "running";
+          } catch (err) {
+            console.error("builds:failed to resolve current session status", err);
+            // If status is unavailable, fail safely rather than accidentally
+            // launch a second builder for the same cohort.
+            alreadyRunning = true;
+          }
+        }
+        if (alreadyRunning) {
+          return c.json({ error: "build is already running for this cohort" }, 409);
+        }
+      }
+
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    } finally {
+      dispatchingCohorts.delete(brief.cohort_id);
+    }
+  });
+}
