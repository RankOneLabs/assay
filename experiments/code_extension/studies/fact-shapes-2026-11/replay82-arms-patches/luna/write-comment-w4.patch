diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c10f754773476b803b1828cc2783993f78568f9c
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+
+function setup(briefStatus = "approved", sessionRef: string | null = null, sessionStatus = "failed") {
+  const db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES ('p', 'project', '/tmp/project')").run();
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES ('s', 'p', 'spec')").run();
+  db.prepare("INSERT INTO plans (id, spec_id, status) VALUES ('pl', 's', 'approved')").run();
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position, status, current_session_ref) VALUES ('c', 'pl', 'cohort', 0, 'building', ?)").run(sessionRef);
+  db.prepare("INSERT INTO briefs (id, cohort_id, status, goal) VALUES ('b', 'c', ?, 'goal')").run(briefStatus);
+  const calls: string[] = [];
+  const app = new Hono();
+  mountBuildsRoutes(app, {
+    db,
+    dispatcher: {
+      dispatch: async (stage: string, id: string) => { calls.push(`${stage}:${id}`); return "build-session"; },
+      status: async () => sessionStatus as "running" | "completed" | "failed",
+    } as never,
+  });
+  return { db, app, calls };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("404 when the brief does not exist", async () => {
+    const { db, app } = setup();
+    try {
+      expect((await app.request("/briefs/missing/build", { method: "POST" })).status).toBe(404);
+    } finally { db.close(); }
+  });
+
+  test("409 unless the brief is approved", async () => {
+    const { db, app, calls } = setup("pending_approval");
+    try {
+      expect((await app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+      expect(calls).toEqual([]);
+    } finally { db.close(); }
+  });
+
+  test("409 when the cohort's current session is still running", async () => {
+    const { db, app, calls } = setup("approved", "planner-session", "running");
+    try {
+      expect((await app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+      expect(calls).toEqual([]);
+    } finally { db.close(); }
+  });
+
+  test("dispatches build and returns the session reference", async () => {
+    const { db, app, calls } = setup();
+    try {
+      const response = await app.request("/briefs/b/build", { method: "POST" });
+      expect(response.status).toBe(200);
+      expect(await response.json()).toEqual({ session_ref: "build-session" });
+      expect(calls).toEqual(["build:b"]);
+    } finally { db.close(); }
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3ad7b7c528265ff5f7b987ea8e23b3bb3b3fddfd
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,68 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import type { createDispatcher } from "../../orchestrator/backends/dispatcher";
+
+type Dispatcher = ReturnType<typeof createDispatcher>;
+
+interface BuildRouteDeps {
+  dispatcher: Dispatcher;
+  db: Database;
+}
+
+interface BriefBuildRow {
+  id: string;
+  status: string;
+  cohort_id: string;
+  current_session_ref: string | null;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildRouteDeps): void {
+  // Protect the interval while backend.dispatch is awaiting session creation;
+  // the persisted session ref handles duplicate requests after dispatch.
+  const dispatchingCohorts = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = db
+      .prepare<BriefBuildRow, [string]>(
+        `SELECT b.id, b.status, b.cohort_id, c.current_session_ref
+           FROM briefs b JOIN cohorts c ON c.id = b.cohort_id
+          WHERE b.id = ?`,
+      )
+      .get(briefId);
+
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+    if (dispatchingCohorts.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    // Reserve synchronously before awaiting status or dispatch, so concurrent
+    // requests cannot both pass the in-process check.
+    dispatchingCohorts.add(brief.cohort_id);
+    try {
+      // current_session_ref is shared with planner2. If the dispatcher can
+      // resolve its lifecycle, only an actually live session blocks a build;
+      // older dispatchers/mocks without status conservatively treat a ref as
+      // an active run.
+      if (brief.current_session_ref) {
+        const status = dispatcher.status
+          ? await dispatcher.status(brief.current_session_ref)
+          : "running";
+        if (status === "running") {
+          return c.json({ error: "a build is already running for this cohort" }, 409);
+        }
+      }
+
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    } finally {
+      dispatchingCohorts.delete(brief.cohort_id);
+    }
+  });
+}
