+import { afterEach, describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+
+afterEach(() => db?.close());
+
+function makeApp(dispatcher: {
+  dispatch: (stage: string, id: string) => Promise<string>;
+  isSessionRunning?: (session_ref: string) => Promise<boolean>;
+}) {
+  const app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher });
+  return app;
+}
+
+function seedBrief(status: string, currentSession: string | null = null): string {
+  db.exec("INSERT INTO projects (id, name, repo_path) VALUES ('p', 'project', '/tmp/project')");
+  db.exec("INSERT INTO specs (id, project_id, title) VALUES ('s', 'p', 'spec')");
+  db.exec("INSERT INTO plans (id, spec_id) VALUES ('pl', 's')");
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position, status, current_session_ref) VALUES ('c', 'pl', 'cohort', 0, 'building', ?) ").run(currentSession);
+  db.prepare("INSERT INTO briefs (id, cohort_id, status, goal) VALUES ('b', 'c', ?, 'goal')").run(status);
+  return "b";
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("404s for a missing brief and conflicts for an unapproved brief", async () => {
+    db = openTestDb();
+    const app = makeApp({ dispatch: async () => "sid" });
+    expect((await app.request("/briefs/missing/build", { method: "POST" })).status).toBe(404);
+    seedBrief("pending_approval");
+    expect((await app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+  });
+
+  test("dispatches approved brief and returns session_ref", async () => {
+    db = openTestDb();
+    seedBrief("approved");
+    const calls: string[][] = [];
+    const app = makeApp({
+      dispatch: async (stage, id) => { calls.push([stage, id]); return "fixed-session-ref"; },
+      isSessionRunning: async () => false,
+    });
+    const response = await app.request("/briefs/b/build", { method: "POST" });
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ session_ref: "fixed-session-ref" });
+    expect(calls).toEqual([["build", "b"]]);
+  });
+
+  test("does not dispatch when a build is running for the cohort", async () => {
+    db = openTestDb();
+    seedBrief("approved", "existing-session");
+    let dispatched = false;
+    const app = makeApp({
+      dispatch: async () => { dispatched = true; return "new-session"; },
+      isSessionRunning: async (ref) => ref === "existing-session",
+    });
+    const response = await app.request("/briefs/b/build", { method: "POST" });
+    expect(response.status).toBe(409);
+    expect(dispatched).toBe(false);
+  });
+});
