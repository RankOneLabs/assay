@@ -0,0 +1,57 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+
+export interface BuildDispatcher {
+  dispatch(stageName: string, inputId: string): Promise<string>;
+  /** Used to distinguish a live build from a stale session reference. */
+  isSessionRunning?(session_ref: string): Promise<boolean>;
+}
+
+interface BuildsRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Protect the check/dispatch interval as well as the already-persisted
+  // session ref; dispatch can take long enough for another request to arrive.
+  const dispatchingCohorts = new Set<string>();
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before running a build" }, 409);
+    }
+
+    const cohort = db
+      .prepare<{ current_session_ref: string | null }, [string]>(
+        "SELECT current_session_ref FROM cohorts WHERE id = ?",
+      )
+      .get(brief.cohort_id);
+
+    if (dispatchingCohorts.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+    if (cohort?.current_session_ref) {
+      // A ref may be left behind after a completed run. If the dispatcher
+      // cannot inspect lifecycle (e.g. a simple test double), fail closed.
+      const running = dispatcher.isSessionRunning
+        ? await dispatcher.isSessionRunning(cohort.current_session_ref)
+        : true;
+      if (running) return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    dispatchingCohorts.add(brief.cohort_id);
+    try {
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    } finally {
+      dispatchingCohorts.delete(brief.cohort_id);
+    }
+  });
+}
