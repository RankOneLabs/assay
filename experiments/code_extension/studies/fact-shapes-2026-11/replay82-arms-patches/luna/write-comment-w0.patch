index 0000000000000000000000000000000000000000..cc97675a99152263580838b20564ceff4e90c998
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,56 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+
+function setup(status: "approved" | "pending_approval" = "approved", currentSession: string | null = null) {
+  const db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES ('p', 'project', '/tmp')").run();
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES ('s', 'p', 'spec')").run();
+  db.prepare("INSERT INTO plans (id, spec_id, status) VALUES ('pl', 's', 'approved')").run();
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position, status, current_session_ref) VALUES ('c', 'pl', 'cohort', 1, 'building', ?)").run(currentSession);
+  db.prepare("INSERT INTO briefs (id, cohort_id, status, goal) VALUES ('b', 'c', ?, 'goal')").run(status);
+  const app = new Hono();
+  const calls: string[] = [];
+  const dispatcher: Dispatcher = {
+    dispatch: async (stage, id) => {
+      calls.push(`${stage}:${id}`);
+      return "new-session";
+    },
+    status: async () => "running",
+  };
+  mountBuildsRoutes(app, { db, dispatcher });
+  return { db, app, calls };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("404s for a missing brief", async () => {
+    const { db, app } = setup();
+    const res = await app.request("/briefs/missing/build", { method: "POST" });
+    expect(res.status).toBe(404);
+    db.close();
+  });
+
+  test("requires an approved brief", async () => {
+    const { db, app, calls } = setup("pending_approval");
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(409);
+    expect(calls).toEqual([]);
+    db.close();
+  });
+
+  test("rejects an already-running build and dispatches when none is recorded", async () => {
+    const { db, app, calls } = setup("approved", "active-session");
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(409);
+    expect(calls).toEqual([]);
+    db.prepare("UPDATE cohorts SET current_session_ref = NULL WHERE id = 'c'").run();
+    const second = await app.request("/briefs/b/build", { method: "POST" });
+    expect(second.status).toBe(200);
+    expect(await second.json()).toEqual({ session_ref: "new-session" });
+    expect(calls).toEqual(["build:b"]);
+    db.close();
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
