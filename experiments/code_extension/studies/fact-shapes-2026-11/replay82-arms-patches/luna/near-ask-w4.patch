diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..efb2a86baa22b13f9766a42b59cbd208de37032b
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,63 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+
+function fixture(briefStatus = "approved", sessionRef: string | null = null) {
+  const db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES (?, ?, ?)").run("p", "project", "/tmp/project");
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES (?, ?, ?)").run("s", "p", "spec");
+  db.prepare("INSERT INTO plans (id, spec_id, status) VALUES (?, ?, 'approved')").run("pl", "s");
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position, status, current_session_ref) VALUES (?, ?, ?, ?, 'building', ?)")
+    .run("c", "pl", "cohort", 0, sessionRef);
+  db.prepare("INSERT INTO briefs (id, cohort_id, status, goal) VALUES (?, ?, ?, ?)").run("b", "c", briefStatus, "goal");
+  const app = new Hono();
+  let dispatched = 0;
+  const dispatcher = {
+    async dispatch(stage: string, id: string) {
+      expect(stage).toBe("build");
+      expect(id).toBe("b");
+      dispatched += 1;
+      return "session-123";
+    },
+    async status() { return "running" as const; },
+  };
+  mountBuildsRoutes(app, { db, dispatcher });
+  return { app, db, get dispatched() { return dispatched; } };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("dispatches an approved brief and returns its session ref", async () => {
+    const f = fixture();
+    try {
+      const response = await f.app.request("/briefs/b/build", { method: "POST" });
+      expect(response.status).toBe(200);
+      expect(await response.json()).toEqual({ session_ref: "session-123" });
+      expect(f.dispatched).toBe(1);
+    } finally { f.db.close(); }
+  });
+
+  test("returns 404 for an unknown brief", async () => {
+    const f = fixture();
+    try {
+      expect((await f.app.request("/briefs/missing/build", { method: "POST" })).status).toBe(404);
+      expect(f.dispatched).toBe(0);
+    } finally { f.db.close(); }
+  });
+
+  test("requires an approved brief", async () => {
+    const f = fixture("pending_approval");
+    try {
+      expect((await f.app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+      expect(f.dispatched).toBe(0);
+    } finally { f.db.close(); }
+  });
+
+  test("rejects a cohort with a running build session", async () => {
+    const f = fixture("approved", "existing-session");
+    try {
+      expect((await f.app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+      expect(f.dispatched).toBe(0);
+    } finally { f.db.close(); }
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b70d42737be8b5e13a3dfe5e190254404a88f833
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,75 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+
+export interface BuildDispatcher {
+  dispatch(stageName: string, inputId: string): Promise<string>;
+  status?(stageName: string, sessionRef: string): Promise<"running" | "completed" | "failed">;
+}
+
+interface BuildsRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+interface BriefBuildRow {
+  id: string;
+  cohort_id: string;
+  status: string;
+  current_session_ref: string | null;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // The DB reference is written by the dispatcher after spawn, so keep a
+  // short-lived reservation too: simultaneous requests must not both spawn.
+  const dispatchingCohorts = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = db
+      .prepare<BriefBuildRow, [string]>(
+        `SELECT b.id, b.cohort_id, b.status, c.current_session_ref
+           FROM briefs b JOIN cohorts c ON c.id = b.cohort_id
+          WHERE b.id = ?`,
+      )
+      .get(briefId);
+
+    if (!brief) return c.json({ error: "brief not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    if (dispatchingCohorts.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    // Reserve before awaiting backend status; otherwise concurrent requests
+    // could both pass the running check and spawn duplicate builds.
+    dispatchingCohorts.add(brief.cohort_id);
+    try {
+      if (brief.current_session_ref) {
+        // The cohort ref is also used by planner2. Only block when it points
+        // to a live session; completed/failed sessions can be retried.
+        // Dispatchers without lifecycle status conservatively treat it as live.
+        let running = true;
+        if (dispatcher.status) {
+          try {
+            running = (await dispatcher.status("build", brief.current_session_ref)) === "running";
+          } catch (err) {
+            console.error("builds:status failed", err);
+          }
+        }
+        if (running) {
+          return c.json({ error: "a build is already running for this cohort" }, 409);
+        }
+      }
+
+      const session_ref = await dispatcher.dispatch("build", brief.id);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to dispatch build" }, 500);
+    } finally {
+      dispatchingCohorts.delete(brief.cohort_id);
+    }
+  });
+}
