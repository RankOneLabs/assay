index 0000000000000000000000000000000000000000..10650d3ca8877ee60fc2321603eb4f0e80b8ba4a
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,62 @@
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+let app: Hono;
+let calls: string[];
+
+beforeEach(() => {
+  db = openTestDb();
+  calls = [];
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES (?, ?, ?)").run("p", "project", "/tmp");
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES (?, ?, ?)").run("s", "p", "spec");
+  db.prepare("INSERT INTO plans (id, spec_id) VALUES (?, ?)").run("pl", "s");
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position, status) VALUES (?, ?, ?, ?, ?)").run("c", "pl", "cohort", 1, "building");
+  db.prepare("INSERT INTO briefs (id, cohort_id, goal, files_in_scope, decisions_made, approaches_rejected, next_action, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?)")
+    .run("b", "c", "goal", "[]", "[]", "[]", "next", "approved");
+  app = new Hono();
+  mountBuildsRoutes(app, {
+    db,
+    dispatcher: {
+      dispatch: async (stage, id) => {
+        calls.push(`${stage}:${id}`);
+        db.prepare("UPDATE cohorts SET current_session_ref = ? WHERE id = ?").run("sid-1", "c");
+        return "sid-1";
+      },
+      status: async () => "running",
+    },
+  });
+});
+
+afterEach(() => db.close());
+
+describe("POST /briefs/:id/build", () => {
+  test("dispatches a build for an approved brief and returns session_ref", async () => {
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "sid-1" });
+    expect(calls).toEqual(["build:b"]);
+  });
+
+  test("returns 404 for a missing brief", async () => {
+    const res = await app.request("/briefs/missing/build", { method: "POST" });
+    expect(res.status).toBe(404);
+  });
+
+  test("rejects a brief that is not approved", async () => {
+    db.prepare("UPDATE briefs SET status = 'pending_approval' WHERE id = 'b'").run();
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(409);
+    expect(calls).toHaveLength(0);
+  });
+
+  test("rejects when the cohort already has a running build session", async () => {
+    db.prepare("UPDATE cohorts SET current_session_ref = 'existing' WHERE id = 'c'").run();
+    const res = await app.request("/briefs/b/build", { method: "POST" });
+    expect(res.status).toBe(409);
+    expect(calls).toHaveLength(0);
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
