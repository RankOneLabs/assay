index 0000000000000000000000000000000000000000..0e2dc3b78865077c692a512f1f5fef893b1a6c35
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,73 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+
+export interface BuildDispatcher {
+  dispatch(stageName: string, inputId: string): Promise<string>;
+  /** Optional for lightweight dispatcher stubs; production dispatchers expose lifecycle status. */
+  status?(sessionRef: string): Promise<"running" | "completed" | "failed">;
+}
+
+interface BuildsRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+interface BriefBuildRow {
+  id: string;
+  cohort_id: string;
+  status: string;
+}
+
+interface CohortBuildRow {
+  current_session_ref: string | null;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Prevent concurrent requests in this process from both passing the DB check
+  // before either has had a chance to persist its new session reference.
+  const dispatchingCohorts = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = db
+      .prepare<BriefBuildRow, [string]>("SELECT id, cohort_id, status FROM briefs WHERE id = ?")
+      .get(briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    const cohort = db
+      .prepare<CohortBuildRow, [string]>("SELECT current_session_ref FROM cohorts WHERE id = ?")
+      .get(brief.cohort_id);
+    if (!cohort) return c.json({ error: "cohort not found" }, 404);
+
+    const existingRef = cohort.current_session_ref;
+    if (existingRef) {
+      let running = true;
+      if (dispatcher.status) {
+        try {
+          running = (await dispatcher.status(existingRef)) === "running";
+        } catch (err) {
+          console.error("builds:failed to inspect existing session", err);
+        }
+      }
+      if (running) return c.json({ error: "build already running for this cohort", session_ref: existingRef }, 409);
+    }
+
+    if (dispatchingCohorts.has(brief.cohort_id)) {
+      return c.json({ error: "build already running for this cohort" }, 409);
+    }
+
+    dispatchingCohorts.add(brief.cohort_id);
+    try {
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    } finally {
+      dispatchingCohorts.delete(brief.cohort_id);
+    }
+  });
+}
