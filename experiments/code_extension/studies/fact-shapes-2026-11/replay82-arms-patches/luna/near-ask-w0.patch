diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..04d788c065698a2ddfd0a81c0413451b7696da1f
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,96 @@
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { insertProject } from "../../db/projects";
+import { insertSpec } from "../../db/specs";
+import { insertPlan } from "../../db/plans";
+import { insertCohort } from "../../db/cohorts";
+import { insertBrief } from "../../db/briefs";
+import { mountBuildsRoutes } from "./builds";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+
+let db: Database;
+let app: Hono;
+let dispatchCalls: string[];
+let status: "running" | "completed" | "failed";
+
+const cohortId = "cohort-build-test";
+const briefId = "brief-build-test";
+
+function setupDispatcher(): Dispatcher {
+  return {
+    dispatch: async (stage, id) => {
+      dispatchCalls.push(`${stage}:${id}`);
+      return "session-build-test";
+    },
+    status: async () => status,
+  };
+}
+
+beforeEach(() => {
+  db = openTestDb();
+  dispatchCalls = [];
+  status = "running";
+  insertProject(db, { id: "project-build-test", name: "P", repo_path: "/tmp" });
+  insertSpec(db, { id: "spec-build-test", project_id: "project-build-test", title: "S" });
+  insertPlan(db, { id: "plan-build-test", spec_id: "spec-build-test" });
+  insertCohort(db, { id: cohortId, plan_id: "plan-build-test", title: "C", position: 1 });
+  insertBrief(db, {
+    id: briefId,
+    cohort_id: cohortId,
+    goal: "Build it",
+    files_in_scope: [],
+    decisions_made: [],
+    approaches_rejected: [],
+    next_action: "Start",
+  });
+  app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher: setupDispatcher() });
+});
+
+afterEach(() => db.close());
+
+async function approveBrief() {
+  db.prepare("UPDATE briefs SET status = 'approved' WHERE id = ?").run(briefId);
+  db.prepare("UPDATE cohorts SET status = 'building' WHERE id = ?").run(cohortId);
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("returns 404 for an unknown brief", async () => {
+    const response = await app.request("/briefs/no-such-brief/build", { method: "POST" });
+    expect(response.status).toBe(404);
+    expect(dispatchCalls).toEqual([]);
+  });
+
+  test("requires an approved brief", async () => {
+    const response = await app.request(`/briefs/${briefId}/build`, { method: "POST" });
+    expect(response.status).toBe(409);
+    expect(dispatchCalls).toEqual([]);
+  });
+
+  test("dispatches an approved brief and returns the session ref", async () => {
+    await approveBrief();
+    const response = await app.request(`/briefs/${briefId}/build`, { method: "POST" });
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ session_ref: "session-build-test" });
+    expect(dispatchCalls).toEqual([`build:${briefId}`]);
+  });
+
+  test("rejects a second build while this cohort's session is running", async () => {
+    await approveBrief();
+    db.prepare("UPDATE cohorts SET current_session_ref = ? WHERE id = ?").run("existing-session", cohortId);
+    const response = await app.request(`/briefs/${briefId}/build`, { method: "POST" });
+    expect(response.status).toBe(409);
+    expect(dispatchCalls).toEqual([]);
+  });
+
+  test("allows a new build after the previous one ended", async () => {
+    await approveBrief();
+    db.prepare("UPDATE cohorts SET current_session_ref = ? WHERE id = ?").run("old-session", cohortId);
+    status = "completed";
+    const response = await app.request(`/briefs/${briefId}/build`, { method: "POST" });
+    expect(response.status).toBe(200);
+    expect(dispatchCalls).toEqual([`build:${briefId}`]);
+  });
+});
