+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,57 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+
+interface BuildRouteDeps {
+  dispatcher: Dispatcher;
+  db: Database;
+}
+
+interface BuildBriefRow {
+  id: string;
+  cohort_id: string;
+  status: string;
+}
+
+interface CohortBuildRow {
+  status: string;
+  current_session_ref: string | null;
+}
+
+/** Mounts the operator-triggered build endpoint for an approved brief. */
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildRouteDeps): void {
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = db.prepare<BuildBriefRow, [string]>(
+      "SELECT id, cohort_id, status FROM briefs WHERE id = ?",
+    ).get(briefId);
+    if (!brief) return c.json({ error: "brief not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before starting a build" }, 409);
+    }
+
+    const cohort = db.prepare<CohortBuildRow, [string]>(
+      "SELECT status, current_session_ref FROM cohorts WHERE id = ?",
+    ).get(brief.cohort_id);
+    if (cohort?.status === "building" && cohort.current_session_ref) {
+      let status: "running" | "completed" | "failed";
+      try {
+        status = await dispatcher.status("build", cohort.current_session_ref);
+      } catch (err) {
+        console.error("builds:status lookup failed", { brief_id: briefId, error: String(err) });
+        return c.json({ error: "failed to check existing build status" }, 500);
+      }
+      if (status === "running") {
+        return c.json({ error: "a build is already running for this cohort" }, 409);
+      }
+    }
+
+    try {
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", { brief_id: briefId, error: String(err) });
+      return c.json({ error: "failed to start build" }, 500);
+    }
+  });
+}
