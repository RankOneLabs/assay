index 0000000000000000000000000000000000000000..77a10b34611f171223b52da06c1a4cae16aa95a5
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,80 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { insertProject } from "../../db/projects";
+import { insertSpec } from "../../db/specs";
+import { insertPlan } from "../../db/plans";
+import { insertCohort } from "../../db/cohorts";
+import { insertBrief } from "../../db/briefs";
+import { mountBuildsRoutes } from "./builds";
+
+function makeFixture() {
+  const db = openTestDb();
+  insertProject(db, { id: "project", name: "project", repo_path: "/tmp/project" });
+  insertSpec(db, { id: "spec", project_id: "project", title: "Spec" });
+  insertPlan(db, { id: "plan", spec_id: "spec" });
+  insertCohort(db, { id: "cohort", plan_id: "plan", title: "Cohort", position: 0 });
+  insertBrief(db, {
+    id: "brief",
+    cohort_id: "cohort",
+    goal: "Build it",
+    files_in_scope: [],
+    decisions_made: [],
+    approaches_rejected: [],
+    next_action: "Start",
+  });
+  const calls: Array<[string, string]> = [];
+  const app = new Hono();
+  mountBuildsRoutes(app, {
+    db,
+    dispatcher: {
+      dispatch: async (stage, id) => {
+        calls.push([stage, id]);
+        return "session-123";
+      },
+      status: async (ref) => ref === "existing-session" ? "running" : "failed",
+    },
+  });
+  return { db, app, calls };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("returns 404 for an unknown brief", async () => {
+    const { db, app } = makeFixture();
+    try {
+      const res = await app.request("/briefs/missing/build", { method: "POST" });
+      expect(res.status).toBe(404);
+    } finally {
+      db.close();
+    }
+  });
+
+  test("requires an approved brief and dispatches the build", async () => {
+    const { db, app, calls } = makeFixture();
+    try {
+      const pending = await app.request("/briefs/brief/build", { method: "POST" });
+      expect(pending.status).toBe(409);
+
+      db.prepare("UPDATE briefs SET status = 'approved' WHERE id = ?").run("brief");
+      const res = await app.request("/briefs/brief/build", { method: "POST" });
+      expect(res.status).toBe(200);
+      expect(await res.json()).toEqual({ session_ref: "session-123" });
+      expect(calls).toEqual([["build", "brief"]]);
+    } finally {
+      db.close();
+    }
+  });
+
+  test("rejects a build when the cohort already has a session ref", async () => {
+    const { db, app, calls } = makeFixture();
+    try {
+      db.prepare("UPDATE briefs SET status = 'approved' WHERE id = ?").run("brief");
+      db.prepare("UPDATE cohorts SET current_session_ref = ? WHERE id = ?").run("existing-session", "cohort");
+      const res = await app.request("/briefs/brief/build", { method: "POST" });
+      expect(res.status).toBe(409);
+      expect(calls).toHaveLength(0);
+    } finally {
+      db.close();
+    }
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
