+    // Claim synchronously in SQLite before yielding to dispatch. The unique
+    // reservation ref serializes concurrent requests; dispatch replaces it
+    // with the actual session ref, while failures release only our claim.
+    const claim = `build-claim:${crypto.randomUUID()}`;
+    const claimResult = db.transaction((): "claimed" | "running" | "missing" => {
+      interface CohortRefRow { current_session_ref: string | null }
+      const cohort = db
+        .prepare<CohortRefRow, [string]>("SELECT current_session_ref FROM cohorts WHERE id = ?")
+        .get(brief.cohort_id);
+      if (!cohort) return "missing";
+
+      const existingRef = cohort.current_session_ref;
+      if (existingRef) {
+        const existingSession = manager.get(existingRef);
+        // Claims are intentionally treated as live even though they have no
+        // Session yet. A known active session cannot be replaced; missing refs
+        // can be stale after restart and are safe to reclaim atomically.
+        if (existingRef.startsWith("build-claim:") || (existingSession && existingSession.status !== "ended")) {
+          return "running";
+        }
       }
+
+      const result = existingRef
+        ? db.prepare(
+            "UPDATE cohorts SET current_session_ref = ? WHERE id = ? AND current_session_ref = ?",
+          ).run(claim, brief.cohort_id, existingRef)
+        : db.prepare(
+            "UPDATE cohorts SET current_session_ref = ? WHERE id = ? AND current_session_ref IS NULL",
+          ).run(claim, brief.cohort_id);
+      return result.changes === 1 ? "claimed" : "running";
+    })();
