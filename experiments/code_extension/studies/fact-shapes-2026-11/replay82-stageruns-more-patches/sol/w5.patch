index 0000000000000000000000000000000000000000..d39e28fc103ac1a7cdf46e1f28e11aa0b5d0614c
--- /dev/null
+++ b/kbbl/core/pwa/review/brief/BriefReviewView.test.tsx
@@ -0,0 +1,116 @@
+import { afterAll, afterEach, beforeEach, describe, expect, mock, test } from "bun:test";
+import { JSDOM } from "jsdom";
+import type { Brief } from "./types";
+
+// Bun is available in the repository's offline test environment; supply the
+// browser DOM that the review view needs without requiring a Vite subprocess.
+const dom = new JSDOM("<!doctype html><html><body></body></html>", { url: "http://localhost" });
+const saved = new Map<string, PropertyDescriptor | undefined>();
+for (const [key, value] of Object.entries({
+  window: dom.window,
+  document: dom.window.document,
+  navigator: dom.window.navigator,
+  HTMLElement: dom.window.HTMLElement,
+  EventSource: class { addEventListener() {} close() {} },
+  IS_REACT_ACT_ENVIRONMENT: true,
+})) {
+  saved.set(key, Object.getOwnPropertyDescriptor(globalThis, key));
+  Object.defineProperty(globalThis, key, { value, configurable: true, writable: true });
+}
+const { render, fireEvent, waitFor, cleanup } = await import("@testing-library/react");
+const { BriefReviewView } = await import("./BriefReviewView");
+const originalFetch = globalThis.fetch;
+let buildResponse: () => Promise<Response>;
+let calls: { url: string; method: string }[];
+let brief: Brief;
+
+beforeEach(() => {
+  brief = {
+    id: "brief/1", cohort_id: "cohort", status: "approved", predecessor_brief_id: null,
+    model: null, goal: "Build it", files_in_scope: [], decisions_made: [], approaches_rejected: [],
+    next_action: "Implement", debrief: null, rejection_reason: null, created_at: "now",
+  };
+  calls = [];
+  buildResponse = async () => Response.json({ session_ref: "build-session" });
+  globalThis.fetch = mock(async (input, init) => {
+    const url = String(input);
+    calls.push({ url, method: init?.method ?? "GET" });
+    if (url.endsWith("/build")) return buildResponse();
+    if (url.startsWith("/briefs/")) return Response.json(brief);
+    if (url.startsWith("/review/frozen")) return Response.json({ frozen: true });
+    return Response.json([]);
+  }) as typeof fetch;
+});
+
+afterEach(() => {
+  cleanup();
+  globalThis.fetch = originalFetch;
+});
+
+afterAll(() => {
+  for (const [key, descriptor] of saved) {
+    if (descriptor) Object.defineProperty(globalThis, key, descriptor);
+    else Reflect.deleteProperty(globalThis, key);
+  }
+  dom.window.close();
+});
+
+function review() {
+  return render(<BriefReviewView id={brief.id} theme="dark" onBack={() => {}} onToggleTheme={() => {}} />);
+}
+
+describe("brief review build action", () => {
+  test("POSTs the encoded brief route and displays the returned session", async () => {
+    const view = review();
+    const button = await view.findByRole("button", { name: "Run build" });
+    expect((button as HTMLButtonElement).disabled).toBe(false);
+    fireEvent.click(button);
+    const status = await view.findByRole("status");
+    expect(status.textContent).toContain("Build started");
+    expect(status.textContent).toContain("build-session");
+    expect(view.getByRole("link").getAttribute("href")).toBe("#sid=build-session");
+    expect(calls.filter((c) => c.method === "POST")).toEqual([{ url: "/briefs/brief%2F1/build", method: "POST" }]);
+  });
+
+  test("disables the action while starting, preventing duplicate requests", async () => {
+    let release!: (response: Response) => void;
+    buildResponse = () => new Promise((resolve) => { release = resolve; });
+    const view = review();
+    fireEvent.click(await view.findByRole("button", { name: "Run build" }));
+    const button = view.getByRole("button", { name: "Starting build…" });
+    expect((button as HTMLButtonElement).disabled).toBe(true);
+    fireEvent.click(button);
+    expect(calls.filter((c) => c.method === "POST")).toHaveLength(1);
+    release(Response.json({ session_ref: "session-2" }));
+    await view.findByRole("status");
+    expect((view.getByRole("button", { name: "Run build again" }) as HTMLButtonElement).disabled).toBe(false);
+  });
+
+  test("shows conflict errors and allows a retry", async () => {
+    buildResponse = async () => Response.json({ error: "a build is already running for this cohort" }, { status: 409 });
+    const view = review();
+    fireEvent.click(await view.findByRole("button", { name: "Run build" }));
+    expect((await view.findByRole("alert")).textContent).toContain("already running");
+    expect(view.queryByRole("status")).toBeNull();
+    buildResponse = async () => Response.json({ session_ref: "retry-session" });
+    fireEvent.click(view.getByRole("button", { name: "Run build" }));
+    expect((await view.findByRole("status")).textContent).toContain("retry-session");
+    expect(view.queryByRole("alert")).toBeNull();
+  });
+
+  test("shows network errors instead of a successful build status", async () => {
+    buildResponse = async () => { throw new Error("network unavailable"); };
+    const view = review();
+    fireEvent.click(await view.findByRole("button", { name: "Run build" }));
+    expect((await view.findByRole("alert")).textContent).toContain("network unavailable");
+    expect(view.queryByRole("status")).toBeNull();
+  });
+
+  test("does not offer a build for an unapproved brief", async () => {
+    brief.status = "pending_approval";
+    const view = review();
+    await view.findByText("Brief review — pending_approval");
+    await waitFor(() => expect(view.queryByRole("button", { name: "Run build" })).toBeNull());
+    expect(calls.filter((c) => c.method === "POST")).toHaveLength(0);
+  });
+});
