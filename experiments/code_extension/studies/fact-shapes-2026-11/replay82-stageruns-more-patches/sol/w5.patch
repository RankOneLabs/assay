new file mode 100644
index 0000000000000000000000000000000000000000..5acef31968cf55d4f6f59d7e1640ec61895983e0
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,150 @@
+import { afterEach, beforeEach, describe, expect, mock, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { insertProject } from "../../db/projects";
+import { insertSpec } from "../../db/specs";
+import { insertPlan } from "../../db/plans";
+import { insertCohort } from "../../db/cohorts";
+import { insertBrief } from "../../db/briefs";
+import { listStageRuns, recordStageRun } from "../../db/stage-runs";
+import { createDispatcher } from "../../orchestrator/backends/dispatcher";
+import type { ExecutionBackend } from "../../orchestrator/backends/interface";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+let app: Hono;
+let backend: ExecutionBackend;
+let dispatch: ReturnType<typeof mock>;
+let states: Map<string, "running" | "completed" | "failed">;
+
+function addBrief(id: string, cohort_id = "cohort-1", status = "approved") {
+  insertBrief(db, { id, cohort_id, goal: "Build it", files_in_scope: [], decisions_made: [], approaches_rejected: [], next_action: "Implement" });
+  db.prepare("UPDATE briefs SET status = ? WHERE id = ?").run(status, id);
+}
+
+function addRun(briefId: string, sessionRef: string) {
+  recordStageRun(db, { stage: "build", input_artifact_type: "brief", input_artifact_id: briefId, session_ref: sessionRef });
+}
+
+function post(id = "brief-1") {
+  return app.request(`/briefs/${id}/build`, { method: "POST" });
+}
+
+beforeEach(() => {
+  db = openTestDb();
+  insertProject(db, { id: "project", name: "P", repo_path: "/repo" });
+  insertSpec(db, { id: "spec", project_id: "project", title: "S" });
+  insertPlan(db, { id: "plan", spec_id: "spec" });
+  for (const id of ["cohort-1", "cohort-2"]) {
+    insertCohort(db, { id, plan_id: "plan", title: id, position: 1 });
+  }
+  addBrief("brief-1");
+  states = new Map();
+  dispatch = mock(async () => {
+    states.set("new-session", "running");
+    return { session_ref: "new-session" };
+  });
+  backend = {
+    id: "kbbl_chat",
+    dispatch,
+    status: async (sid) => states.get(sid) ?? "failed",
+  };
+  app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher: createDispatcher({ db, backends: { kbbl_chat: backend }, kbblUrl: "http://localhost" }) });
+});
+
+afterEach(() => db.close());
+
+describe("POST /briefs/:id/build", () => {
+  test("missing brief is 404 without dispatch", async () => {
+    expect((await post("missing")).status).toBe(404);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  for (const status of ["pending_approval", "rejected", "superseded"]) {
+    test(`${status} brief is 409 without dispatch`, async () => {
+      db.prepare("UPDATE briefs SET status = ? WHERE id = 'brief-1'").run(status);
+      expect((await post()).status).toBe(409);
+      expect(dispatch).not.toHaveBeenCalled();
+    });
+  }
+
+  test("approved brief dispatches build, returns and records the session", async () => {
+    // Approval sets this state BEFORE automatic dispatch, so it alone is not a lock.
+    db.prepare("UPDATE cohorts SET status = 'building' WHERE id = 'cohort-1'").run();
+    const res = await post();
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "new-session" });
+    expect(dispatch).toHaveBeenCalledTimes(1);
+    const [stage, inputRef, prompt] = dispatch.mock.calls[0]!;
+    expect(stage.name).toBe("build");
+    expect(inputRef).toEqual({ type: "brief", id: "brief-1", workdir: "/repo" });
+    expect(prompt).toContain("Build it");
+    expect(listStageRuns(db, "build", "brief-1")[0]?.session_ref).toBe("new-session");
+    expect((await post()).status).toBe(409);
+    expect(dispatch).toHaveBeenCalledTimes(1);
+  });
+
+  test("a running build on an older brief blocks the entire cohort", async () => {
+    addBrief("old-brief", "cohort-1", "superseded");
+    addRun("old-brief", "old-session");
+    states.set("old-session", "running");
+    expect((await post()).status).toBe(409);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  test("running builds on another cohort and planner runs do not block", async () => {
+    addBrief("other-brief", "cohort-2");
+    addRun("other-brief", "other-session");
+    states.set("other-session", "running");
+    recordStageRun(db, { stage: "planner2", input_artifact_type: "cohort", input_artifact_id: "cohort-1", session_ref: "planner-session" });
+    states.set("planner-session", "running");
+    expect((await post()).status).toBe(200);
+  });
+
+  test("completed and failed runs permit a retry", async () => {
+    addRun("brief-1", "completed");
+    addRun("brief-1", "failed");
+    states.set("completed", "completed");
+    states.set("failed", "failed");
+    expect((await post()).status).toBe(200);
+  });
+
+  test("checks every run, not just the latest", async () => {
+    addRun("brief-1", "running");
+    addRun("brief-1", "completed");
+    states.set("running", "running");
+    states.set("completed", "completed");
+    expect((await post()).status).toBe(409);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  test("concurrent requests across briefs of one cohort dispatch only once", async () => {
+    addBrief("brief-2");
+    let release!: (result: { session_ref: string }) => void;
+    backend.dispatch = mock(() => new Promise<{ session_ref: string }>((resolve) => { release = resolve; }));
+    const first = post();
+    const second = await post("brief-2");
+    expect(second.status).toBe(409);
+    release({ session_ref: "held-session" });
+    expect((await first).status).toBe(200);
+    expect(backend.dispatch).toHaveBeenCalledTimes(1);
+  });
+
+  test("dispatch failure returns JSON 500 and releases the lock for retry", async () => {
+    const log = console.error;
+    console.error = () => {};
+    try {
+      backend.dispatch = async () => { throw new Error("spawn failed"); };
+      const failed = await post();
+      expect(failed.status).toBe(500);
+      expect(await failed.json()).toEqual({ error: "failed to start build" });
+      expect(listStageRuns(db, "build", "brief-1")).toHaveLength(0);
+      backend.dispatch = dispatch;
+      expect((await post()).status).toBe(200);
+    } finally {
+      console.error = log;
+    }
+  });
+});
