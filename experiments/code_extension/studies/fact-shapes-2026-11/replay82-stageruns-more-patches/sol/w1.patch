@@ -0,0 +1,148 @@
+import { afterEach, beforeEach, describe, expect, mock, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { insertProject } from "../../db/projects";
+import { insertSpec } from "../../db/specs";
+import { insertPlan } from "../../db/plans";
+import { insertCohort } from "../../db/cohorts";
+import { insertBrief } from "../../db/briefs";
+import { recordStageRun, listStageRuns } from "../../db/stage-runs";
+import { createDispatcher } from "../../orchestrator/backends/dispatcher";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+import type { InputRef, StageRow } from "../../orchestrator/backends/interface";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+const briefPayload = {
+  goal: "Ship it", files_in_scope: [], decisions_made: [],
+  approaches_rejected: [], next_action: "Write code",
+};
+
+function brief(id: string, cohort_id = "c1", status = "approved") {
+  insertBrief(db, { id, cohort_id, ...briefPayload });
+  db.prepare("UPDATE briefs SET status = ? WHERE id = ?").run(status, id);
+}
+function run(id: string, session_ref: string, stage = "build") {
+  recordStageRun(db, { stage, input_artifact_type: "brief", input_artifact_id: id, session_ref });
+}
+function appFor(dispatcher: Dispatcher) {
+  const app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher });
+  return app;
+}
+function post(app: Hono, id = "b1") {
+  return app.request(`/briefs/${id}/build`, { method: "POST" });
+}
+
+beforeEach(() => {
+  db = openTestDb();
+  insertProject(db, { id: "p", name: "Project", repo_path: "/repo" });
+  insertSpec(db, { id: "s", project_id: "p", title: "Spec" });
+  insertPlan(db, { id: "pl", spec_id: "s" });
+  insertCohort(db, { id: "c1", plan_id: "pl", title: "Cohort", position: 1 });
+  insertCohort(db, { id: "c2", plan_id: "pl", title: "Other", position: 2 });
+});
+afterEach(() => db.close());
+
+describe("POST /briefs/:id/build", () => {
+  test("404 for a missing brief without dispatching", async () => {
+    const dispatch = mock(async () => "sid");
+    expect((await post(appFor({ dispatch }))).status).toBe(404);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  for (const status of ["pending_approval", "rejected", "superseded"]) {
+    test(`409 for ${status} without dispatching`, async () => {
+      brief("b1", "c1", status);
+      const dispatch = mock(async () => "sid");
+      expect((await post(appFor({ dispatch }))).status).toBe(409);
+      expect(dispatch).not.toHaveBeenCalled();
+    });
+  }
+
+  test("dispatches approved brief, returns session_ref, and records run", async () => {
+    brief("b1");
+    // Approval sets this before the automatic dispatch: status alone is not
+    // evidence of a live session and must not prevent recovery after failure.
+    db.prepare("UPDATE cohorts SET status = 'building' WHERE id = 'c1'").run();
+    const dispatch = mock(async (_stage: StageRow, _input: InputRef, _prompt: string) => ({ session_ref: "build-session" }));
+    const dispatcher = createDispatcher({ db, kbblUrl: "http://kbbl", backends: {
+      kbbl_chat: { id: "kbbl_chat", dispatch, status: async () => "running" },
+    } });
+    const app = appFor(dispatcher);
+    const res = await post(app);
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "build-session" });
+    expect(dispatch).toHaveBeenCalledTimes(1);
+    expect(dispatch.mock.calls[0]?.[0]).toMatchObject({ name: "build" });
+    expect(dispatch.mock.calls[0]?.[1]).toMatchObject({ type: "brief", id: "b1" });
+    expect(listStageRuns(db, "build", "b1")[0]?.session_ref).toBe("build-session");
+    expect((await post(app)).status).toBe(409);
+    expect(dispatch).toHaveBeenCalledTimes(1);
+  });
+
+  test("checks all runs across briefs of the same cohort, not just newest", async () => {
+    brief("old", "c1", "superseded");
+    brief("b1");
+    run("old", "live");
+    run("b1", "ended");
+    const dispatch = mock(async () => "sid");
+    const status = mock(async (_stage: string, sid: string) => sid === "live" ? "running" as const : "completed" as const);
+    expect((await post(appFor({ dispatch, status }))).status).toBe(409);
+    expect(status).toHaveBeenCalledWith("build", "live");
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  test("completed/failed runs permit retry; other cohorts and stages do not block", async () => {
+    brief("b1");
+    brief("other", "c2");
+    run("b1", "completed");
+    run("b1", "failed");
+    run("other", "live");
+    run("b1", "planner", "planner2");
+    const dispatch = mock(async () => "new-session");
+    const status = mock(async (_stage: string, sid: string) => sid === "completed" ? "completed" as const : "failed" as const);
+    const res = await post(appFor({ dispatch, status }));
+    expect(res.status).toBe(200);
+    expect(dispatch).toHaveBeenCalledWith("build", "b1");
+    expect(status).toHaveBeenCalledTimes(2);
+  });
+
+  test("dispatch-only dependencies conservatively block recorded builds", async () => {
+    brief("b1");
+    run("b1", "sid");
+    const dispatch = mock(async () => "new-session");
+    expect((await post(appFor({ dispatch }))).status).toBe(409);
+    expect(dispatch).not.toHaveBeenCalled();
+  });
+
+  test("simultaneous requests for different briefs of a cohort dispatch once", async () => {
+    brief("b1");
+    brief("b2");
+    let finish!: (sid: string) => void;
+    const dispatch = mock(() => new Promise<string>((resolve) => { finish = resolve; }));
+    const app = appFor({ dispatch });
+    const first = post(app);
+    expect((await post(app, "b2")).status).toBe(409);
+    finish("sid");
+    expect((await first).status).toBe(200);
+    expect(dispatch).toHaveBeenCalledTimes(1);
+  });
+
+  test("dispatch failure returns 500 and releases the pending reservation", async () => {
+    brief("b1");
+    const dispatch = mock(async () => { throw new Error("spawn failed"); });
+    const app = appFor({ dispatch });
+    const log = mock(() => {});
+    const original = console.error;
+    console.error = log;
+    try {
+      expect((await post(app)).status).toBe(500);
+      expect((await post(app)).status).toBe(500);
+      expect(dispatch).toHaveBeenCalledTimes(2);
+    } finally {
+      console.error = original;
+    }
+  });
+});
