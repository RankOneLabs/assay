+import { JSDOM } from "jsdom";
+import { strict as assert } from "node:assert";
+const dom = new JSDOM("<!doctype html><html><body></body></html>", { url: "http://localhost" });
+Object.assign(globalThis, { window: dom.window, document: dom.window.document, navigator: dom.window.navigator, HTMLElement: dom.window.HTMLElement, MutationObserver: dom.window.MutationObserver });
+class EventSourceStub { addEventListener() {} close() {} }
+Object.assign(globalThis, { EventSource: EventSourceStub });
+const { render, screen, fireEvent, cleanup, waitFor } = await import("@testing-library/react");
+const { BriefReviewView } = await import("../core/pwa/review/brief/BriefReviewView");
+const brief = { id: "brief/id", cohort_id: "c", status: "approved", goal: "Goal", files_in_scope: [], decisions_made: [], approaches_rejected: [], next_action: "Build", debrief: null };
+function response(data: unknown, status = 200) { return new Response(JSON.stringify(data), { status }); }
+let builds = 0;
+let outcome: "success" | "conflict" | "network" = "success";
+let finish!: (r: Response) => void;
+globalThis.fetch = (async (url: string, init?: RequestInit) => {
+  if (url.endsWith("/build")) {
+    builds++;
+    assert.equal(url, "/briefs/brief%2Fid/build");
+    assert.equal(init?.method, "POST");
+    if (outcome === "conflict") return response({ error: "Already running" }, 409);
+    if (outcome === "network") throw new Error("Offline");
+    return new Promise<Response>((r) => { finish = r; });
+  }
+  if (url.startsWith("/briefs/")) return response(brief);
+  if (url.startsWith("/review/frozen")) return response({ frozen: true });
+  return response([]);
+}) as typeof fetch;
+function view() { render(<BriefReviewView id={brief.id} theme="dark" onBack={() => {}} onToggleTheme={() => {}} />); }
+view();
+let button = await screen.findByRole("button", { name: "Run build" });
+fireEvent.click(button);
+assert.equal((button as HTMLButtonElement).disabled, true);
+fireEvent.click(button);
+assert.equal(builds, 1);
+finish(response({ session_ref: "smoke-session" }));
+assert.match((await screen.findByRole("status")).textContent!, /smoke-session/);
+cleanup();
+for (const value of ["conflict", "network"] as const) {
+  outcome = value;
+  view();
+  button = await screen.findByRole("button", { name: "Run build" });
+  fireEvent.click(button);
+  assert.match((await screen.findByRole("alert")).textContent!, value === "conflict" ? /Already running/ : /Offline/);
+  await waitFor(() => assert.equal((button as HTMLButtonElement).disabled, false));
+  cleanup();
+}
+console.log("Build button jsdom smoke: success, duplicate click suppression, 409 and network errors passed");
