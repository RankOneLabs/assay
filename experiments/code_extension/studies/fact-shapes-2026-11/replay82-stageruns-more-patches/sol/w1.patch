+  return new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } });
+}
+
+beforeEach(() => {
+  fetchMock.mockReset();
+  vi.stubGlobal("fetch", fetchMock);
+});
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+describe("brief Run build", () => {
+  it("POSTs the encoded route, prevents repeated clicks, and displays the session", async () => {
+    let resolve!: (res: Response) => void;
+    fetchMock.mockResolvedValueOnce(response(brief));
+    fetchMock.mockImplementationOnce(() => new Promise<Response>((r) => { resolve = r; }));
+    render(view());
+    const button = await screen.findByRole("button", { name: "Run build" });
+    fireEvent.click(button);
+    expect(fetchMock).toHaveBeenLastCalledWith("/briefs/brief%2Fid/build", { method: "POST" });
+    expect((button as HTMLButtonElement).disabled).toBe(true);
+    expect(button.textContent).toBe("Starting build…");
+    fireEvent.click(button);
+    expect(fetchMock).toHaveBeenCalledTimes(2);
+    resolve(response({ session_ref: "build-session-123" }));
+    expect((await screen.findByRole("status")).textContent).toContain("build-session-123");
+    expect((button as HTMLButtonElement).disabled).toBe(true);
+  });
+
+  it.each([409, 500])("shows server errors (%s) and allows retry", async (status) => {
+    fetchMock.mockResolvedValueOnce(response(brief));
+    fetchMock.mockResolvedValueOnce(response({ error: "Cannot start build" }, status));
+    fetchMock.mockResolvedValueOnce(response({ session_ref: "retry-session" }));
+    render(view());
+    fireEvent.click(await screen.findByRole("button", { name: "Run build" }));
+    expect((await screen.findByRole("alert")).textContent).toContain("Cannot start build");
+    const button = screen.getByRole("button", { name: "Run build" });
+    expect((button as HTMLButtonElement).disabled).toBe(false);
+    fireEvent.click(button);
+    expect((await screen.findByRole("status")).textContent).toContain("retry-session");
+    expect(screen.queryByRole("alert")).toBeNull();
+  });
+
+  it("shows network errors without leaving the button disabled", async () => {
+    fetchMock.mockResolvedValueOnce(response(brief));
+    fetchMock.mockRejectedValueOnce(new Error("Offline"));
+    render(view());
+    fireEvent.click(await screen.findByRole("button", { name: "Run build" }));
+    expect((await screen.findByRole("alert")).textContent).toContain("Offline");
+    expect((screen.getByRole("button", { name: "Run build" }) as HTMLButtonElement).disabled).toBe(false);
+  });
+
+  it("does not offer Run build for an unapproved brief", async () => {
+    fetchMock.mockResolvedValueOnce(response({ ...brief, status: "pending_approval" }));
+    render(view());
+    await screen.findByRole("button", { name: "Approve" });
+    expect(screen.queryByRole("button", { name: "Run build" })).toBeNull();
+  });
+
+  it("clears session status when navigating to a different brief", async () => {
+    fetchMock.mockResolvedValueOnce(response(brief));
+    fetchMock.mockResolvedValueOnce(response({ session_ref: "old-session" }));
+    const rendered = render(view());
+    fireEvent.click(await screen.findByRole("button", { name: "Run build" }));
+    await screen.findByRole("status");
+    fetchMock.mockResolvedValueOnce(response({ ...brief, id: "other-brief" }));
+    rendered.rerender(view("other-brief"));
+    await waitFor(() => expect(screen.queryByRole("status")).toBeNull());
+    expect((await screen.findByRole("button", { name: "Run build" }) as HTMLButtonElement).disabled).toBe(false);
+  });
+});
