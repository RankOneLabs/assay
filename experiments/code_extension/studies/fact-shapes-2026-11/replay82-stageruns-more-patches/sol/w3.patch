index 0000000000000000000000000000000000000000..991351aad2e5259a945119bb56cf88b6021a5f38
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,156 @@
+import { afterEach, beforeEach, describe, expect, mock, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { insertProject } from "../../db/projects";
+import { insertSpec } from "../../db/specs";
+import { insertPlan } from "../../db/plans";
+import { insertCohort } from "../../db/cohorts";
+import { insertBrief } from "../../db/briefs";
+import { recordStageRun, listStageRuns } from "../../db/stage-runs";
+import { createDispatcher } from "../../orchestrator/backends/dispatcher";
+import type { ExecutionBackend } from "../../orchestrator/backends/interface";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+let app: Hono;
+let states: Map<string, "running" | "completed" | "failed">;
+let backend: ExecutionBackend;
+
+function addBrief(id: string, cohort_id = "cohort", status = "approved") {
+  insertBrief(db, {
+    id, cohort_id, goal: "Ship build routing", files_in_scope: [],
+    decisions_made: [], approaches_rejected: [], next_action: "Implement route",
+  });
+  db.prepare("UPDATE briefs SET status = ? WHERE id = ?").run(status, id);
+}
+
+function addRun(briefId: string, sessionRef: string, state: "running" | "completed" | "failed") {
+  recordStageRun(db, {
+    stage: "build", input_artifact_type: "brief", input_artifact_id: briefId,
+    session_ref: sessionRef,
+  });
+  states.set(sessionRef, state);
+}
+
+function build(id = "brief") {
+  return app.request(`/briefs/${id}/build`, { method: "POST" });
+}
+
+beforeEach(() => {
+  db = openTestDb();
+  insertProject(db, { id: "project", name: "P", repo_path: "/repo" });
+  insertSpec(db, { id: "spec", project_id: "project", title: "S" });
+  insertPlan(db, { id: "plan", spec_id: "spec" });
+  insertCohort(db, { id: "cohort", plan_id: "plan", title: "C", position: 1 });
+  insertCohort(db, { id: "other", plan_id: "plan", title: "Other", position: 2 });
+  addBrief("brief");
+  states = new Map();
+  backend = {
+    id: "kbbl_chat",
+    dispatch: mock(async () => {
+      states.set("new-session", "running");
+      return { session_ref: "new-session" };
+    }),
+    status: mock(async (sid: string) => states.get(sid) ?? "failed"),
+  };
+  app = new Hono();
+  mountBuildsRoutes(app, {
+    db, dispatcher: createDispatcher({ db, backends: { kbbl_chat: backend }, kbblUrl: "http://kbbl.test" }),
+  });
+});
+
+afterEach(() => db.close());
+
+describe("POST /briefs/:id/build", () => {
+  test("missing brief returns 404 without dispatching", async () => {
+    expect((await build("missing")).status).toBe(404);
+    expect(backend.dispatch).not.toHaveBeenCalled();
+  });
+
+  for (const status of ["pending_approval", "rejected", "superseded"]) {
+    test(`${status} brief returns 409 without dispatching`, async () => {
+      db.prepare("UPDATE briefs SET status = ? WHERE id = 'brief'").run(status);
+      expect((await build()).status).toBe(409);
+      expect(backend.dispatch).not.toHaveBeenCalled();
+    });
+  }
+
+  test("dispatches build with the brief as input and returns/records the session", async () => {
+    // Approval already moves the cohort to building; this alone must not block.
+    db.prepare("UPDATE cohorts SET status = 'building' WHERE id = 'cohort'").run();
+    const res = await build();
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "new-session" });
+    expect(backend.dispatch).toHaveBeenCalledTimes(1);
+    const call = (backend.dispatch as ReturnType<typeof mock>).mock.calls[0]!;
+    expect(call[0].name).toBe("build");
+    expect(call[1]).toEqual({ type: "brief", id: "brief", workdir: "/repo" });
+    expect(call[2]).toContain("Ship build routing");
+    expect(listStageRuns(db, "build", "brief")[0]?.session_ref).toBe("new-session");
+    expect((await build()).status).toBe(409);
+  });
+
+  test("a running build on an older superseded brief blocks the whole cohort", async () => {
+    addBrief("old", "cohort", "superseded");
+    addRun("old", "old-session", "running");
+    addRun("brief", "ended-session", "completed");
+    expect((await build()).status).toBe(409);
+    expect(backend.dispatch).not.toHaveBeenCalled();
+  });
+
+  test("completed, failed and unknown sessions allow a retry", async () => {
+    addRun("brief", "completed", "completed");
+    addRun("brief", "failed", "failed");
+    addRun("brief", "unknown", "failed");
+    states.delete("unknown");
+    expect((await build()).status).toBe(200);
+  });
+
+  test("running builds on other cohorts and planner runs do not block", async () => {
+    addBrief("other-brief", "other");
+    addRun("other-brief", "other-session", "running");
+    recordStageRun(db, {
+      stage: "planner2", input_artifact_type: "cohort", input_artifact_id: "cohort",
+      session_ref: "planner-session",
+    });
+    states.set("planner-session", "running");
+    expect((await build()).status).toBe(200);
+  });
+
+  test("concurrent requests for different brief revisions cannot both dispatch", async () => {
+    addBrief("revision");
+    let release!: () => void;
+    const waiting = new Promise<void>((resolve) => { release = resolve; });
+    backend.dispatch = mock(async () => {
+      await waiting;
+      states.set("new-session", "running");
+      return { session_ref: "new-session" };
+    });
+    const first = build();
+    const second = build("revision");
+    expect((await second).status).toBe(409);
+    release();
+    expect((await first).status).toBe(200);
+    expect(backend.dispatch).toHaveBeenCalledTimes(1);
+  });
+
+  test("dispatch failure returns 500 and releases the reservation for retry", async () => {
+    const original = backend.dispatch;
+    backend.dispatch = mock(async () => { throw new Error("spawn failed"); });
+    expect((await build()).status).toBe(500);
+    expect(listStageRuns(db, "build", "brief")).toHaveLength(0);
+    backend.dispatch = original;
+    expect((await build()).status).toBe(200);
+  });
+
+  test("status failure fails closed and releases the reservation", async () => {
+    addRun("brief", "old", "running");
+    const original = backend.status;
+    backend.status = mock(async () => { throw new Error("backend unavailable"); });
+    expect((await build()).status).toBe(500);
+    expect(backend.dispatch).not.toHaveBeenCalled();
+    backend.status = original;
+    expect((await build()).status).toBe(409);
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2de78ea5bc5b569f4be9feae28470694681b53a4
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,54 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+
+interface BuildsRouteDeps {
+  dispatcher: Dispatcher;
+  db: Database;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // A backend dispatch awaits process startup before recording its stage_run.
+  // Reserve the cohort while checking/dispatching so simultaneous HTTP requests
+  // (including requests for different brief revisions) cannot both start a build.
+  const pendingCohorts = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const brief = getBrief(db, c.req.param("id"));
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief is not approved" }, 409);
+    }
+    if (pendingCohorts.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    pendingCohorts.add(brief.cohort_id);
+    try {
+      // Check all revisions of the cohort's brief, not just this input ID.
+      // Cohort status 'building' is set on approval, even if dispatch fails;
+      // only backend lifecycle can tell us whether a build is actually running.
+      const runs = db.prepare<{ session_ref: string }, [string]>(
+        `SELECT sr.session_ref FROM stage_runs sr
+         JOIN briefs b ON b.id = sr.input_artifact_id
+         WHERE sr.stage = 'build' AND sr.input_artifact_type = 'brief'
+           AND b.cohort_id = ?
+         ORDER BY sr.id DESC`,
+      ).all(brief.cohort_id);
+      for (const run of runs) {
+        if (await dispatcher.status("build", run.session_ref) === "running") {
+          return c.json({ error: "a build is already running for this cohort" }, 409);
+        }
+      }
+
+      const session_ref = await dispatcher.dispatch("build", brief.id);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    } finally {
+      pendingCohorts.delete(brief.cohort_id);
+    }
+  });
+}
