@@ -0,0 +1,130 @@
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { JSDOM } from "jsdom";
+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { BriefReviewView } from "./BriefReviewView";
+import type { Brief } from "./types";
+
+let dom: JSDOM;
+let root: Root;
+let container: HTMLDivElement;
+let buildRequests: string[];
+let buildResponse: () => Promise<Response>;
+let brief: Brief;
+let originalGlobals: Map<string, PropertyDescriptor | undefined>;
+
+beforeEach(() => {
+  dom = new JSDOM("<!doctype html><html><body></body></html>", { url: "http://kbbl.test" });
+  originalGlobals = new Map();
+  const globals: Record<string, unknown> = {
+    window: dom.window,
+    document: dom.window.document,
+    navigator: dom.window.navigator,
+    IS_REACT_ACT_ENVIRONMENT: true,
+    EventSource: class {
+      addEventListener() {}
+      close() {}
+    },
+    fetch: async (url: string, options?: RequestInit) => {
+      if (options?.method === "POST" && url.endsWith("/build")) {
+        buildRequests.push(url);
+        return buildResponse();
+      }
+      if (url.startsWith("/briefs/")) return Response.json(brief);
+      if (url.startsWith("/review/frozen")) return Response.json({ frozen: true });
+      return Response.json([]);
+    },
+  };
+  for (const [key, value] of Object.entries(globals)) {
+    originalGlobals.set(key, Object.getOwnPropertyDescriptor(globalThis, key));
+    Object.defineProperty(globalThis, key, { value, configurable: true, writable: true });
+  }
+  brief = {
+    id: "brief/1", cohort_id: "cohort", status: "approved", predecessor_brief_id: null,
+    model: null, goal: "Ship the feature", files_in_scope: [], decisions_made: [],
+    approaches_rejected: [], next_action: "Implement", debrief: null,
+    rejection_reason: null, created_at: "2026-01-01T00:00:00Z",
+  };
+  buildRequests = [];
+  buildResponse = async () => Response.json({ session_ref: "session-123" });
+  container = dom.window.document.createElement("div");
+  dom.window.document.body.append(container);
+  root = createRoot(container);
+});
+
+afterEach(async () => {
+  await act(async () => root.unmount());
+  dom.window.close();
+  for (const [key, descriptor] of originalGlobals) {
+    if (descriptor) Object.defineProperty(globalThis, key, descriptor);
+    else Reflect.deleteProperty(globalThis, key);
+  }
+});
+
+async function renderBrief() {
+  await act(async () => {
+    root.render(<BriefReviewView id={brief.id} theme="dark" onToggleTheme={() => {}} onBack={() => {}} />);
+  });
+}
+
+function buildButton(): HTMLButtonElement | undefined {
+  return [...container.querySelectorAll("button")].find((b) => /Run build|Starting build/.test(b.textContent ?? ""));
+}
+
+async function clickBuild() {
+  await act(async () => buildButton()!.click());
+}
+
+describe("BriefReviewView build action", () => {
+  test("approved brief POSTs its encoded ID and shows returned session link", async () => {
+    await renderBrief();
+    expect(buildButton()?.disabled).toBe(false);
+    await clickBuild();
+    expect(buildRequests).toEqual(["/briefs/brief%2F1/build"]);
+    expect(container.querySelector('[role="status"]')?.textContent).toContain("Build started: session-123");
+    expect(container.querySelector("a")?.getAttribute("href")).toBe("#sid=session-123");
+    expect(buildButton()).toBeUndefined();
+  });
+
+  test("disables the button while starting", async () => {
+    let release!: (response: Response) => void;
+    buildResponse = () => new Promise((resolve) => { release = resolve; });
+    await renderBrief();
+    await clickBuild();
+    expect(buildButton()?.disabled).toBe(true);
+    expect(buildButton()?.textContent).toBe("Starting build…");
+    await clickBuild();
+    expect(buildRequests).toHaveLength(1);
+    await act(async () => release(Response.json({ session_ref: "session-123" })));
+    expect(container.querySelector('[role="status"]')?.textContent).toContain("session-123");
+  });
+
+  test("conflict is shown and allows retry", async () => {
+    buildResponse = async () => Response.json({ error: "a build is already running for this cohort" }, { status: 409 });
+    await renderBrief();
+    await clickBuild();
+    expect(container.querySelector('[role="alert"]')?.textContent).toContain("already running");
+    expect(buildButton()?.disabled).toBe(false);
+    buildResponse = async () => Response.json({ session_ref: "retry-session" });
+    await clickBuild();
+    expect(container.querySelector('[role="alert"]')).toBeNull();
+    expect(container.querySelector('[role="status"]')?.textContent).toContain("retry-session");
+  });
+
+  test("network failure is visible and re-enables the button", async () => {
+    buildResponse = async () => { throw new Error("Network unavailable"); };
+    await renderBrief();
+    await clickBuild();
+    expect(container.querySelector('[role="alert"]')?.textContent).toContain("Network unavailable");
+    expect(buildButton()?.disabled).toBe(false);
+  });
+
+  for (const status of ["pending_approval", "rejected", "superseded"] as const) {
+    test(`${status} brief has no build action`, async () => {
+      brief.status = status;
+      await renderBrief();
+      expect(buildButton()).toBeUndefined();
+      expect(buildRequests).toHaveLength(0);
+    });
+  }
+});
