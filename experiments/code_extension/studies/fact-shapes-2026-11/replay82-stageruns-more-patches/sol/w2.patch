+import { afterEach, beforeEach, describe, expect, mock, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { recordStageRun } from "../../db/stage-runs";
+import { createDispatcher, type Dispatcher } from "../../orchestrator/backends/dispatcher";
+import type { ExecutionBackend } from "../../orchestrator/backends/interface";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+let app: Hono;
+let dispatcher: Dispatcher;
+
+beforeEach(() => {
+  db = openTestDb();
+  db.exec(`
+    INSERT INTO projects (id, name, repo_path) VALUES ('project', 'Project', '/tmp');
+    INSERT INTO specs (id, project_id, title) VALUES ('spec', 'project', 'Spec');
+    INSERT INTO plans (id, spec_id) VALUES ('plan', 'spec');
+    INSERT INTO cohorts (id, plan_id, title, position, status)
+      VALUES ('cohort', 'plan', 'Cohort', 0, 'building'),
+             ('other', 'plan', 'Other', 1, 'building');
+    INSERT INTO briefs (id, cohort_id, status, goal)
+      VALUES ('brief', 'cohort', 'approved', 'Goal'),
+             ('older', 'cohort', 'superseded', 'Old goal'),
+             ('pending', 'cohort', 'pending_approval', 'Pending'),
+             ('rejected', 'cohort', 'rejected', 'Rejected'),
+             ('other-brief', 'other', 'approved', 'Other');
+  `);
+  dispatcher = {
+    dispatch: mock(async () => "new-session"),
+    status: mock(async () => "completed" as const),
+  };
+  app = new Hono();
+  mountBuildsRoutes(app, { dispatcher, db });
+});
+
+afterEach(() => db.close());
+
+const post = (id = "brief") => app.request(`/briefs/${id}/build`, { method: "POST" });
+const record = (id: string, ref: string, stage = "build") => recordStageRun(db, {
+  stage, input_artifact_type: "brief", input_artifact_id: id, session_ref: ref,
+});
+
+describe("POST /briefs/:id/build", () => {
+  test("404 for a missing brief without dispatching", async () => {
+    expect((await post("missing")).status).toBe(404);
+    expect(dispatcher.dispatch).not.toHaveBeenCalled();
+  });
+
+  test("409 for every non-approved status without dispatching", async () => {
+    for (const id of ["pending", "rejected", "older"]) {
+      expect((await post(id)).status).toBe(409);
+    }
+    expect(dispatcher.dispatch).not.toHaveBeenCalled();
+  });
+
+  test("dispatches an approved brief and returns its session ref", async () => {
+    const res = await post();
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "new-session" });
+    expect(dispatcher.dispatch).toHaveBeenCalledWith("build", "brief");
+  });
+
+  test("blocks a running build on this brief", async () => {
+    record("brief", "live");
+    dispatcher.status = mock(async () => "running" as const);
+    expect((await post()).status).toBe(409);
+    expect(dispatcher.status).toHaveBeenCalledWith("live");
+    expect(dispatcher.dispatch).not.toHaveBeenCalled();
+  });
+
+  test("blocks running builds on predecessor briefs even if a newer run ended", async () => {
+    record("older", "old-live");
+    record("brief", "ended");
+    dispatcher.status = mock(async (ref) => ref === "old-live" ? "running" : "completed");
+    expect((await post()).status).toBe(409);
+    expect(dispatcher.dispatch).not.toHaveBeenCalled();
+  });
+
+  test("completed and failed builds do not block retries", async () => {
+    record("brief", "complete");
+    record("older", "failed");
+    dispatcher.status = mock(async (ref) => ref === "failed" ? "failed" : "completed");
+    expect((await post()).status).toBe(200);
+  });
+
+  test("ignores other cohorts and non-build stages", async () => {
+    record("other-brief", "other-live");
+    record("brief", "planner-live", "planner2");
+    dispatcher.status = mock(async () => "running" as const);
+    expect((await post()).status).toBe(200);
+    expect(dispatcher.status).not.toHaveBeenCalled();
+  });
+
+  test("reserves the cohort while dispatch is pending and allows other cohorts", async () => {
+    let finish!: (ref: string) => void;
+    dispatcher.dispatch = mock(async (_stage, id) => {
+      if (id === "other-brief") return "other-session";
+      return new Promise<string>((resolve) => { finish = resolve; });
+    });
+    const first = post();
+    await Promise.resolve();
+    // An approved sibling brief must be guarded by cohort, not brief ID.
+    db.exec("UPDATE briefs SET status = 'approved' WHERE id = 'older'");
+    expect((await post("older")).status).toBe(409);
+    expect((await post("other-brief")).status).toBe(200);
+    finish("first-session");
+    expect(await (await first).json()).toEqual({ session_ref: "first-session" });
+  });
+
+  test("dispatch errors return JSON and release the pending reservation", async () => {
+    dispatcher.dispatch = mock(async () => { throw new Error("spawn failed"); });
+    const res = await post();
+    expect(res.status).toBe(500);
+    expect(await res.json()).toEqual({ error: "failed to dispatch build" });
+    dispatcher.dispatch = mock(async () => "retry-session");
+    expect((await post()).status).toBe(200);
+  });
+
+  test("status lookup errors fail closed and release the reservation", async () => {
+    record("brief", "live");
+    dispatcher.status = mock(async () => { throw new Error("backend unavailable"); });
+    expect((await post()).status).toBe(500);
+    expect(dispatcher.dispatch).not.toHaveBeenCalled();
+    dispatcher.status = mock(async () => "completed" as const);
+    expect((await post()).status).toBe(200);
+  });
+
+  test("real dispatcher records runs and consults the configured backend on retry", async () => {
+    let state: "running" | "completed" | "failed" = "running";
+    const backend: ExecutionBackend = {
+      id: "kbbl_chat",
+      dispatch: mock(async () => ({ session_ref: "real-recorded-session" })),
+      status: mock(async () => state),
+    };
+    dispatcher = createDispatcher({ db, backends: { kbbl_chat: backend }, kbblUrl: "http://kbbl.test" });
+    app = new Hono();
+    mountBuildsRoutes(app, { dispatcher, db });
+    expect((await post()).status).toBe(200);
+    expect(db.query("SELECT input_artifact_id FROM stage_runs").get()).toEqual({ input_artifact_id: "brief" });
+    expect((await post()).status).toBe(409);
+    expect(backend.status).toHaveBeenCalledWith("real-recorded-session");
+    state = "completed";
+    expect((await post()).status).toBe(200);
+    expect(await dispatcher.status("unknown-session")).toBe("failed");
+  });
+});
