diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b297fec3ea37f268827fdd3ccfc349e51167264b
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,172 @@
+import { afterEach, beforeEach, describe, expect, mock, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { insertProject } from "../../db/projects";
+import { insertSpec } from "../../db/specs";
+import { insertPlan } from "../../db/plans";
+import { insertCohort } from "../../db/cohorts";
+import { insertBrief } from "../../db/briefs";
+import { listStageRuns, recordStageRun } from "../../db/stage-runs";
+import { createDispatcher } from "../../orchestrator/backends/dispatcher";
+import type { ExecutionBackend } from "../../orchestrator/backends/interface";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+let app: Hono;
+let backend: ExecutionBackend;
+let states: Map<string, "running" | "completed" | "failed">;
+
+function brief(id: string, cohort_id = "cohort", status = "approved") {
+  insertBrief(db, {
+    id, cohort_id, goal: "Build something", files_in_scope: [],
+    decisions_made: [], approaches_rejected: [], next_action: "Start",
+  });
+  db.prepare("UPDATE briefs SET status = ? WHERE id = ?").run(status, id);
+}
+
+function run(id: string, session_ref: string, state: "running" | "completed" | "failed") {
+  recordStageRun(db, { stage: "build", input_artifact_type: "brief", input_artifact_id: id, session_ref });
+  states.set(session_ref, state);
+}
+
+function post(id = "brief") {
+  return app.request(`/briefs/${id}/build`, { method: "POST" });
+}
+
+beforeEach(() => {
+  db = openTestDb();
+  insertProject(db, { id: "project", name: "Project", repo_path: "/tmp/repo" });
+  insertSpec(db, { id: "spec", project_id: "project", title: "Spec" });
+  insertPlan(db, { id: "plan", spec_id: "spec" });
+  insertCohort(db, { id: "cohort", plan_id: "plan", title: "Cohort", position: 0 });
+  // This is the state set by approval, not proof a backend session is running.
+  db.prepare("UPDATE cohorts SET status = 'building' WHERE id = 'cohort'").run();
+  brief("brief");
+  states = new Map();
+  backend = {
+    id: "kbbl_chat",
+    dispatch: mock(async () => {
+      states.set("new-session", "running");
+      return { session_ref: "new-session" };
+    }),
+    status: mock(async (sid) => states.get(sid) ?? "failed"),
+  };
+  app = new Hono();
+  mountBuildsRoutes(app, {
+    db,
+    dispatcher: createDispatcher({ db, backends: { kbbl_chat: backend }, kbblUrl: "http://localhost:8788" }),
+  });
+});
+
+afterEach(() => db.close());
+
+describe("POST /briefs/:id/build", () => {
+  test("404 for a missing brief, without dispatching", async () => {
+    expect((await post("missing")).status).toBe(404);
+    expect(backend.dispatch).not.toHaveBeenCalled();
+  });
+
+  for (const status of ["pending_approval", "rejected", "superseded"]) {
+    test(`409 for ${status}, without dispatching`, async () => {
+      db.prepare("UPDATE briefs SET status = ? WHERE id = 'brief'").run(status);
+      expect((await post()).status).toBe(409);
+      expect(backend.dispatch).not.toHaveBeenCalled();
+    });
+  }
+
+  test("dispatches an approved brief, returns the session and records the run", async () => {
+    const res = await post();
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "new-session" });
+    expect(backend.dispatch).toHaveBeenCalledTimes(1);
+    expect(backend.dispatch).toHaveBeenCalledWith(
+      expect.objectContaining({ name: "build" }),
+      { type: "brief", id: "brief", workdir: "/tmp/repo" },
+      expect.stringContaining("Build something"),
+    );
+    expect(listStageRuns(db, "build", "brief")[0]?.session_ref).toBe("new-session");
+    expect((await post()).status).toBe(409);
+    expect(backend.dispatch).toHaveBeenCalledTimes(1);
+  });
+
+  test("blocks a live run on an older brief for the same cohort", async () => {
+    brief("older", "cohort", "superseded");
+    run("older", "older-session", "running");
+    expect((await post()).status).toBe(409);
+    expect(backend.dispatch).not.toHaveBeenCalled();
+  });
+
+  test("checks older runs even when the newest run has completed", async () => {
+    run("brief", "old-live", "running");
+    run("brief", "new-ended", "completed");
+    expect((await post()).status).toBe(409);
+    expect(backend.dispatch).not.toHaveBeenCalled();
+  });
+
+  test("allows a retry after completed, failed or unknown sessions", async () => {
+    run("brief", "completed", "completed");
+    run("brief", "failed", "failed");
+    run("brief", "unknown", "failed");
+    states.delete("unknown");
+    expect((await post()).status).toBe(200);
+  });
+
+  test("does not block on a different cohort or a non-build stage", async () => {
+    insertCohort(db, { id: "other", plan_id: "plan", title: "Other", position: 1 });
+    brief("other-brief", "other");
+    run("other-brief", "other-session", "running");
+    recordStageRun(db, { stage: "planner2", input_artifact_type: "cohort", input_artifact_id: "cohort", session_ref: "planner-session" });
+    states.set("planner-session", "running");
+    expect((await post()).status).toBe(200);
+  });
+
+  test("blocks overlapping requests across brief versions while dispatch is pending", async () => {
+    brief("second");
+    let finish!: (result: { session_ref: string }) => void;
+    let started!: () => void;
+    const entered = new Promise<void>((resolve) => { started = resolve; });
+    backend.dispatch = mock(() => {
+      started();
+      return new Promise<{ session_ref: string }>((resolve) => { finish = resolve; });
+    });
+    const first = post();
+    await entered;
+    expect((await post("second")).status).toBe(409);
+    finish({ session_ref: "pending-session" });
+    expect((await first).status).toBe(200);
+    expect(backend.dispatch).toHaveBeenCalledTimes(1);
+  });
+
+  test("dispatch failure is a JSON error, and releases the pending reservation", async () => {
+    backend.dispatch = mock(async () => { throw new Error("spawn failed"); });
+    const log = mock(() => {});
+    const original = console.error;
+    console.error = log;
+    try {
+      const res = await post();
+      expect(res.status).toBe(500);
+      expect(await res.json()).toEqual({ error: "build dispatch failed" });
+      expect(listStageRuns(db, "build", "brief")).toEqual([]);
+      backend.dispatch = mock(async () => ({ session_ref: "retry" }));
+      expect((await post()).status).toBe(200);
+    } finally {
+      console.error = original;
+    }
+  });
+
+  test("lifecycle lookup errors fail closed instead of starting another builder", async () => {
+    run("brief", "session", "running");
+    backend.status = mock(async () => { throw new Error("backend unavailable"); });
+    const original = console.error;
+    console.error = () => {};
+    try {
+      expect((await post()).status).toBe(500);
+      expect(backend.dispatch).not.toHaveBeenCalled();
+      backend.status = mock(async () => "completed" as const);
+      expect((await post()).status).toBe(200);
+    } finally {
+      console.error = original;
+    }
+  });
+});
