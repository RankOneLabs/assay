+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+
+interface BuildsRouteDeps {
+  dispatcher: Dispatcher;
+  db: Database;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Reserve the cohort while lifecycle checks and dispatch are awaiting I/O.
+  // Without this, two clicks could both see no recorded run and spawn builders.
+  const pendingCohorts = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const brief = getBrief(db, c.req.param("id"));
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved" }, 409);
+    }
+    if (pendingCohorts.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    pendingCohorts.add(brief.cohort_id);
+    try {
+      // Check every brief version for the cohort, not just the requested brief.
+      // Approval sets cohort.status to building even before a session exists,
+      // so the cohort's state alone is not evidence of a running build.
+      const runs = db.prepare<{ session_ref: string }, [string]>(
+        `SELECT r.session_ref FROM stage_runs r
+         JOIN briefs b ON b.id = r.input_artifact_id
+         WHERE r.stage = 'build' AND r.input_artifact_type = 'brief'
+           AND b.cohort_id = ? ORDER BY r.id DESC`,
+      ).all(brief.cohort_id);
+      for (const run of runs) {
+        if (await dispatcher.status(run.session_ref) === "running") {
+          return c.json({ error: "a build is already running for this cohort" }, 409);
+        }
+      }
+
+      const session_ref = await dispatcher.dispatch("build", brief.id);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "build dispatch failed" }, 500);
+    } finally {
+      pendingCohorts.delete(brief.cohort_id);
+    }
+  });
+}
