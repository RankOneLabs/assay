new file mode 100644
index 0000000000000000000000000000000000000000..9fbd666e74fda941d0b71941d40b654cba321581
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,148 @@
+import { afterEach, beforeEach, expect, test, mock, spyOn } from "bun:test";
+import type { Database } from "bun:sqlite";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { insertProject } from "../../db/projects";
+import { insertSpec } from "../../db/specs";
+import { insertPlan } from "../../db/plans";
+import { insertCohort } from "../../db/cohorts";
+import { insertBrief } from "../../db/briefs";
+import { recordStageRun } from "../../db/stage-runs";
+import { createDispatcher, type Dispatcher } from "../../orchestrator/backends/dispatcher";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+let app: Hono;
+let dispatcher: Dispatcher;
+
+function addBrief(id: string, cohort_id = "cohort", status = "approved") {
+  insertBrief(db, {
+    id, cohort_id, goal: "Build it", files_in_scope: [],
+    decisions_made: [], approaches_rejected: [], next_action: "Start",
+  });
+  db.prepare("UPDATE briefs SET status = ? WHERE id = ?").run(status, id);
+}
+
+function addRun(inputId: string, sessionRef: string, stage = "build") {
+  recordStageRun(db, { stage, input_artifact_type: "brief", input_artifact_id: inputId, session_ref: sessionRef });
+}
+
+function post(id = "brief") {
+  return app.request(`/briefs/${id}/build`, { method: "POST" });
+}
+
+beforeEach(() => {
+  db = openTestDb();
+  insertProject(db, { id: "project", name: "P", repo_path: "/tmp" });
+  insertSpec(db, { id: "spec", project_id: "project", title: "S" });
+  insertPlan(db, { id: "plan", spec_id: "spec" });
+  insertCohort(db, { id: "cohort", plan_id: "plan", title: "C", position: 1 });
+  insertCohort(db, { id: "other-cohort", plan_id: "plan", title: "Other", position: 2 });
+  addBrief("brief");
+  dispatcher = {
+    dispatch: mock(async () => "new-session"),
+    status: mock(async () => "completed" as const),
+  };
+  app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher });
+});
+
+afterEach(() => db.close());
+
+test("missing brief returns 404 without dispatch", async () => {
+  expect((await post("missing")).status).toBe(404);
+  expect(dispatcher.dispatch).not.toHaveBeenCalled();
+});
+
+test("every non-approved status returns 409 without dispatch", async () => {
+  for (const status of ["pending_approval", "rejected", "superseded"]) {
+    db.prepare("UPDATE briefs SET status = ? WHERE id = 'brief'").run(status);
+    expect((await post()).status).toBe(409);
+  }
+  expect(dispatcher.dispatch).not.toHaveBeenCalled();
+});
+
+test("dispatches the brief and returns the session even when cohort workflow is building", async () => {
+  db.prepare("UPDATE cohorts SET status = 'building' WHERE id = 'cohort'").run();
+  const res = await post();
+  expect(res.status).toBe(200);
+  expect(await res.json()).toEqual({ session_ref: "new-session" });
+  expect(dispatcher.dispatch).toHaveBeenCalledWith("build", "brief");
+});
+
+test("blocks an active run on any brief revision in this cohort", async () => {
+  addBrief("old-brief", "cohort", "superseded");
+  addRun("old-brief", "running-session");
+  addRun("brief", "completed-session");
+  dispatcher.status = mock(async (_stage, sid) => sid === "running-session" ? "running" : "completed");
+  expect((await post()).status).toBe(409);
+  expect(dispatcher.dispatch).not.toHaveBeenCalled();
+  expect(dispatcher.status).toHaveBeenCalledWith("build", "running-session");
+});
+
+test("completed and failed runs allow retry", async () => {
+  addRun("brief", "completed");
+  addRun("brief", "failed");
+  dispatcher.status = mock(async (_stage, sid) => sid === "failed" ? "failed" : "completed");
+  expect((await post()).status).toBe(200);
+});
+
+test("runs on another cohort or another stage do not block", async () => {
+  addBrief("other-brief", "other-cohort");
+  addRun("other-brief", "running");
+  addRun("brief", "running", "planner2");
+  dispatcher.status = mock(async () => "running" as const);
+  expect((await post()).status).toBe(200);
+  expect(dispatcher.status).not.toHaveBeenCalled();
+});
+
+test("concurrent requests for the same cohort cannot dispatch twice", async () => {
+  addBrief("revision");
+  let release!: (sid: string) => void;
+  dispatcher.dispatch = mock(() => new Promise<string>((resolve) => { release = resolve; }));
+  const first = post();
+  await Promise.resolve();
+  expect((await post("revision")).status).toBe(409);
+  expect(dispatcher.dispatch).toHaveBeenCalledTimes(1);
+  release("session");
+  expect((await first).status).toBe(200);
+});
+
+test("dispatch errors return 500 and release the pending cohort for retry", async () => {
+  const log = spyOn(console, "error").mockImplementation(() => {});
+  try {
+    dispatcher.dispatch = mock(async () => { throw new Error("backend offline"); });
+    expect((await post()).status).toBe(500);
+    dispatcher.dispatch = mock(async () => "retry-session");
+    expect((await post()).status).toBe(200);
+  } finally { log.mockRestore(); }
+});
+
+test("status lookup errors fail closed and release the pending cohort", async () => {
+  const log = spyOn(console, "error").mockImplementation(() => {});
+  try {
+    addRun("brief", "session");
+    dispatcher.status = mock(async () => { throw new Error("status unavailable"); });
