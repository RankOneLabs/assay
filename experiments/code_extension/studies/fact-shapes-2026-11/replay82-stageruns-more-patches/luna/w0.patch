diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4b712a668bfa9e8e146f5fe651ac5bf4fc676212
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,57 @@
+import { afterEach, describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+
+let db: Database;
+
+function seedBrief(status: string): string {
+  db.exec(`
+    INSERT INTO projects (id, name, repo_path) VALUES ('p', 'project', '/repo');
+    INSERT INTO specs (id, project_id, title) VALUES ('s', 'p', 'spec');
+    INSERT INTO plans (id, spec_id, status) VALUES ('pl', 's', 'approved');
+    INSERT INTO cohorts (id, plan_id, title, position, status) VALUES ('c', 'pl', 'cohort', 0, 'building');
+    INSERT INTO briefs (id, cohort_id, status, goal) VALUES ('b', 'c', '${status}', 'goal');
+  `);
+  return "b";
+}
+
+function buildApp(dispatcher: Dispatcher): Hono {
+  const app = new Hono();
+  mountBuildsRoutes(app, { dispatcher, db });
+  return app;
+}
+
+afterEach(() => db?.close());
+
+describe("POST /briefs/:id/build", () => {
+  test("returns 404 for a missing brief and 409 unless approved", async () => {
+    db = openTestDb();
+    const app = buildApp({ dispatch: async () => "sid" } as Dispatcher);
+    expect((await app.request("/briefs/missing/build", { method: "POST" })).status).toBe(404);
+    seedBrief("pending_approval");
+    expect((await app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+  });
+
+  test("dispatches approved brief, returns session ref, and rejects another running cohort build", async () => {
+    db = openTestDb();
+    seedBrief("approved");
+    const calls: string[] = [];
+    const app = buildApp({
+      dispatch: async (stage, id) => { calls.push(`${stage}:${id}`); return "sid-1"; },
+      status: async () => "running",
+    });
+
+    const first = await app.request("/briefs/b/build", { method: "POST" });
+    expect(first.status).toBe(200);
+    expect(await first.json()).toEqual({ session_ref: "sid-1" });
+    expect(calls).toEqual(["build:b"]);
+
+    db.prepare("INSERT INTO stage_runs (stage, input_artifact_type, input_artifact_id, session_ref) VALUES ('build', 'brief', 'b', 'sid-1')").run();
+    const second = await app.request("/briefs/b/build", { method: "POST" });
+    expect(second.status).toBe(409);
+    expect(calls).toHaveLength(1);
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b5b47184233888c87208965ae7c9ee0ddcc40d67
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,60 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+
+interface BuildRouteDeps {
+  dispatcher: Dispatcher;
+  db: Database;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildRouteDeps): void {
+  const dispatchingCohorts = new Set<string>();
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief is not approved" }, 409);
+    }
+
+    // Stage runs are keyed by the brief input, while the one-build-at-a-time
+    // rule is for the cohort. Inspect all its briefs' build runs and ask the
+    // configured backend for their current lifecycle state.
+    if (dispatchingCohorts.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+    const runs = db.prepare<{ session_ref: string }, [string]>(
+      `SELECT sr.session_ref
+         FROM stage_runs sr
+         JOIN briefs b ON b.id = sr.input_artifact_id
+        WHERE sr.stage = 'build' AND b.cohort_id = ?`,
+    ).all(brief.cohort_id);
+    for (const run of runs) {
+      try {
+        const status = dispatcher.status
+          ? await dispatcher.status("build", run.session_ref)
+          : "running";
+        if (status === "running") {
+          return c.json({ error: "a build is already running for this cohort" }, 409);
+        }
+      } catch (err) {
+        // An inability to verify an existing build should fail closed rather
+        // than launch a second builder against the same cohort.
+        console.error("builds:status check failed", err);
+        return c.json({ error: "unable to verify existing build status" }, 503);
+      }
+    }
+
+    dispatchingCohorts.add(brief.cohort_id);
+    try {
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to dispatch build" }, 500);
+    } finally {
+      dispatchingCohorts.delete(brief.cohort_id);
+    }
+  });
+}
