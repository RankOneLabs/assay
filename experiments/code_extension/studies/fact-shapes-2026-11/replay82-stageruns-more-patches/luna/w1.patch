diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2b9fc2a17f1d45c065aba955a4f14475b9ac0a92
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,73 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+
+function setup(status = "approved") {
+  const db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES ('p', 'project', '/tmp')").run();
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES ('s', 'p', 'spec')").run();
+  db.prepare("INSERT INTO plans (id, spec_id, status) VALUES ('pl', 's', 'approved')").run();
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position, status) VALUES ('c', 'pl', 'cohort', 0, 'building')").run();
+  db.prepare("INSERT INTO briefs (id, cohort_id, status, goal) VALUES ('b', 'c', ?, 'goal')").run(status);
+  const app = new Hono();
+  let dispatchCount = 0;
+  let nextStatus: "running" | "completed" | "failed" = "failed";
+  mountBuildsRoutes(app, {
+    db,
+    dispatcher: {
+      dispatch: async (stage, id) => {
+        expect(stage).toBe("build");
+        expect(id).toBe("b");
+        dispatchCount++;
+        const session_ref = `session-${dispatchCount}`;
+        db.prepare("INSERT INTO stage_runs (stage, input_artifact_type, input_artifact_id, session_ref) VALUES ('build', 'brief', ?, ?)").run(id, session_ref);
+        return session_ref;
+      },
+      status: async () => nextStatus,
+    },
+  });
+  return { db, app, dispatchCount: () => dispatchCount, setStatus: (s: typeof nextStatus) => { nextStatus = s; } };
+}
+
+async function postBuild(app: Hono, id = "b") {
+  return app.request(`/briefs/${id}/build`, { method: "POST" });
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("dispatches a build for an approved brief and returns the session ref", async () => {
+    const { db, app, dispatchCount } = setup();
+    try {
+      const res = await postBuild(app);
+      expect(res.status).toBe(200);
+      expect(await res.json()).toEqual({ session_ref: "session-1" });
+      expect(dispatchCount()).toBe(1);
+    } finally { db.close(); }
+  });
+
+  test("returns 404 for an unknown brief", async () => {
+    const { db, app, dispatchCount } = setup();
+    try {
+      expect((await postBuild(app, "missing")).status).toBe(404);
+      expect(dispatchCount()).toBe(0);
+    } finally { db.close(); }
+  });
+
+  test("returns 409 unless the brief is approved", async () => {
+    const { db, app, dispatchCount } = setup("pending_approval");
+    try {
+      expect((await postBuild(app)).status).toBe(409);
+      expect(dispatchCount()).toBe(0);
+    } finally { db.close(); }
+  });
+
+  test("returns 409 when a build session for the cohort is running", async () => {
+    const { db, app, dispatchCount, setStatus } = setup();
+    try {
+      db.prepare("INSERT INTO stage_runs (stage, input_artifact_type, input_artifact_id, session_ref) VALUES ('build', 'brief', 'b', 'old-session')").run();
+      setStatus("running");
+      expect((await postBuild(app)).status).toBe(409);
+      expect(dispatchCount()).toBe(0);
+    } finally { db.close(); }
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..51396238c0954a39502365ece480ff49d26f79e8
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,45 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+import { createDispatcher } from "../../orchestrator/backends/dispatcher";
+
+interface BuildsRouteDeps {
+  dispatcher: Pick<ReturnType<typeof createDispatcher>, "dispatch" | "status">;
+  db: Database;
+}
+
+/** Routes for explicitly starting a build from an approved brief. */
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    // Build runs are recorded against briefs, while duplicate build prevention
+    // is cohort-scoped (a reopened/revised brief must not start a concurrent build).
+    const priorRuns = db
+      .prepare<{ session_ref: string }, [string]>(
+        `SELECT sr.session_ref
+           FROM stage_runs sr
+           JOIN briefs b ON b.id = sr.input_artifact_id
+          WHERE sr.stage = 'build' AND b.cohort_id = ?`,
+      )
+      .all(brief.cohort_id);
+    for (const run of priorRuns) {
+      if (dispatcher.status && await dispatcher.status(run.session_ref) === "running") {
+        return c.json({ error: "a build is already running for this cohort" }, 409);
+      }
+    }
+
+    try {
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to dispatch build" }, 500);
+    }
+  });
+}
