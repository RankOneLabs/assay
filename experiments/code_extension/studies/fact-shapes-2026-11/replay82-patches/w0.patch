diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1aab54e94357c6b8db02d8ab152f73d813f05db7
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,54 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+
+function setup() {
+  const db: Database = openTestDb();
+  db.exec(`
+    INSERT INTO projects (id, name, repo_path) VALUES ('project-1', 'test', '/tmp');
+    INSERT INTO specs (id, project_id, title) VALUES ('spec-1', 'project-1', 'spec');
+    INSERT INTO plans (id, spec_id) VALUES ('plan-1', 'spec-1');
+    INSERT INTO cohorts (id, plan_id, title, position) VALUES ('cohort-1', 'plan-1', 'cohort', 1);
+    INSERT INTO briefs (id, cohort_id, status, goal) VALUES ('brief-pending', 'cohort-1', 'pending_approval', 'goal');
+    INSERT INTO briefs (id, cohort_id, status, goal) VALUES ('brief-approved', 'cohort-1', 'approved', 'goal');
+  `);
+  const dispatched: [string, string][] = [];
+  let status: "running" | "completed" | "failed" = "failed";
+  const dispatcher = {
+    async dispatch(stage: string, id: string) {
+      dispatched.push([stage, id]);
+      db.prepare("UPDATE cohorts SET current_session_ref = ? WHERE id = ?").run("session-1", "cohort-1");
+      status = "running";
+      return "session-1";
+    },
+    async status() { return status; },
+  };
+  const app = new Hono();
+  mountBuildsRoutes(app, { db, dispatcher });
+  return { app, db, dispatched };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("validates existence and approved status before dispatching", async () => {
+    const { app, db, dispatched } = setup();
+    try {
+      expect((await app.request("/briefs/missing/build", { method: "POST" })).status).toBe(404);
+      expect((await app.request("/briefs/brief-pending/build", { method: "POST" })).status).toBe(409);
+      expect(dispatched).toEqual([]);
+    } finally { db.close(); }
+  });
+
+  test("dispatches the approved brief and blocks a second active build for its cohort", async () => {
+    const { app, db, dispatched } = setup();
+    try {
+      const first = await app.request("/briefs/brief-approved/build", { method: "POST" });
+      expect(first.status).toBe(200);
+      expect(await first.json()).toEqual({ session_ref: "session-1" });
+      expect(dispatched).toEqual([["build", "brief-approved"]]);
+      expect((await app.request("/briefs/brief-approved/build", { method: "POST" })).status).toBe(409);
+      expect(dispatched).toHaveLength(1);
+    } finally { db.close(); }
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e308a36d087efc738ffdc0ea3f731bfd365a92dd
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,71 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+
+type BuildStatus = "running" | "completed" | "failed";
+
+interface BuildDispatcher {
+  dispatch(stageName: string, inputId: string): Promise<string>;
+  status(session_ref: string): Promise<BuildStatus>;
+}
+
+interface BuildsRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+interface CohortBuildState {
+  current_session_ref: string | null;
+}
+
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Prevent overlapping requests in the interval before dispatch persists the
+  // new reference to the cohort row.
+  const dispatchingCohorts = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    const cohort = db
+      .prepare<CohortBuildState, [string]>(
+        "SELECT current_session_ref FROM cohorts WHERE id = ?",
+      )
+      .get(brief.cohort_id);
+    if (!cohort) return c.json({ error: "cohort not found" }, 404);
+
+    if (dispatchingCohorts.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+    // Set before the first await to make this check effective for concurrent
+    // requests handled by the same server process.
+    dispatchingCohorts.add(brief.cohort_id);
+
+    try {
+      if (cohort.current_session_ref) {
+        let status: BuildStatus;
+        try {
+          status = await dispatcher.status(cohort.current_session_ref);
+        } catch (err) {
+          console.error("builds:status failed", err);
+          return c.json({ error: "could not determine existing build status" }, 500);
+        }
+        if (status === "running") {
+          return c.json({ error: "a build is already running for this cohort" }, 409);
+        }
+      }
+
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    } finally {
+      dispatchingCohorts.delete(brief.cohort_id);
+    }
+  });
+}
