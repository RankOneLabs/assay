index 0000000000000000000000000000000000000000..1512b49b1b7291e11748559eb62a29651596d99c
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,81 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { insertProject } from "../../db/projects";
+import { insertSpec } from "../../db/specs";
+import { insertPlan } from "../../db/plans";
+import { insertCohort } from "../../db/cohorts";
+import { insertBrief } from "../../db/briefs";
+import { mountBuildsRoutes } from "./builds";
+
+function fixture(status: "pending_approval" | "approved" = "approved") {
+  const db = openTestDb();
+  insertProject(db, { id: "project", name: "Project", repo_path: "/tmp/project" });
+  insertSpec(db, { id: "spec", project_id: "project", title: "Spec", notes: null });
+  insertPlan(db, { id: "plan", spec_id: "spec" });
+  insertCohort(db, { id: "cohort", plan_id: "plan", title: "Cohort", position: 1 });
+  db.prepare("UPDATE cohorts SET status = 'building' WHERE id = 'cohort'").run();
+  insertBrief(db, {
+    id: "brief", cohort_id: "cohort", goal: "Goal", files_in_scope: [],
+    decisions_made: [], approaches_rejected: [], next_action: "Next",
+  });
+  if (status === "approved") db.prepare("UPDATE briefs SET status = 'approved' WHERE id = 'brief'").run();
+  const app = new Hono();
+  const calls: string[] = [];
+  const dispatcher = {
+    dispatch: async (stage: string, id: string) => {
+      calls.push(`${stage}:${id}`);
+      return "session-fixed";
+    },
+    status: async () => "completed" as const,
+  };
+  mountBuildsRoutes(app, { db, dispatcher });
+  return { db, app, calls };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("returns 404 for an unknown brief", async () => {
+    const { db, app } = fixture();
+    try {
+      expect((await app.request("/briefs/missing/build", { method: "POST" })).status).toBe(404);
+    } finally { db.close(); }
+  });
+
+  test("requires approved status", async () => {
+    const { db, app } = fixture("pending_approval");
+    try {
+      expect((await app.request("/briefs/brief/build", { method: "POST" })).status).toBe(409);
+    } finally { db.close(); }
+  });
+
+  test("dispatches an approved brief and returns its session ref", async () => {
+    const { db, app, calls } = fixture();
+    try {
+      const response = await app.request("/briefs/brief/build", { method: "POST" });
+      expect(response.status).toBe(200);
+      expect(await response.json()).toEqual({ session_ref: "session-fixed" });
+      expect(calls).toEqual(["build:brief"]);
+    } finally { db.close(); }
+  });
+
+  test("rejects when this cohort already has a live build session", async () => {
+    const { db, calls } = fixture();
+    db.prepare("UPDATE cohorts SET current_session_ref = 'live-ref' WHERE id = 'cohort'").run();
+    // Replace status behavior via route's opaque dispatcher reference.
+    // This fixture is completed by default; a live session status is covered
+    // by a dedicated app below.
+    const liveApp = new Hono();
+    mountBuildsRoutes(liveApp, {
+      db,
+      dispatcher: {
+        dispatch: async () => { calls.push("unexpected"); return "new"; },
+        status: async () => "running",
+      },
+    });
+    try {
+      const response = await liveApp.request("/briefs/brief/build", { method: "POST" });
+      expect(response.status).toBe(409);
+      expect(calls).toEqual([]);
+    } finally { db.close(); }
+  });
+});
