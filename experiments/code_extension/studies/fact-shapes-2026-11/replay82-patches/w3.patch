index 0000000000000000000000000000000000000000..7b7930c5ca9069df94d4b7320762eb58f9e56bea
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,88 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import type { createDispatcher } from "../../orchestrator/backends/dispatcher";
+import { getBrief } from "../../db/briefs";
+
+export type BuildDispatcher = Pick<ReturnType<typeof createDispatcher>, "dispatch"> & {
+  /** Optional for simple test dispatchers; production dispatchers expose lifecycle status. */
+  status?: (stageName: string, sessionRef: string) => Promise<"running" | "completed" | "failed">;
+};
+
+interface BuildsRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+interface CohortBuildRow {
+  id: string;
+  current_session_ref: string | null;
+}
+
+/** Mounts the explicit operator endpoint for starting an approved brief's build. */
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Avoid duplicate launches if multiple requests arrive while dispatch() is
+  // still creating the session (before the dispatcher persists its ref).
+  const dispatching = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief is not approved" }, 409);
+    }
+
+    const cohort = db
+      .prepare<CohortBuildRow, [string]>(
+        "SELECT id, current_session_ref FROM cohorts WHERE id = ?",
+      )
+      .get(brief.cohort_id);
+    if (!cohort) return c.json({ error: "cohort not found" }, 404);
+
+    if (dispatching.has(cohort.id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    // The cohort's ref may refer to planner-2 or an earlier build. Use the
+    // backend lifecycle status, when available, rather than treating every
+    // historical ref as a live build.
+    if (cohort.current_session_ref && dispatcher.status) {
+      try {
+        const status = await dispatcher.status("build", cohort.current_session_ref);
+        if (status === "running") {
+          return c.json(
+            { error: "a build is already running for this cohort", session_ref: cohort.current_session_ref },
+            409,
+          );
+        }
+      } catch (err) {
+        // A stale/unknown ref should not prevent the operator from launching
+        // a build. The new dispatch will replace it with the current ref.
+        console.warn("builds:failed to check existing session", err);
+      }
+    }
+
+    dispatching.add(cohort.id);
+    try {
+      // brief.approved normally launches the same stage asynchronously. If
+      // that hook has already saved a live build ref in the meantime, return
+      // it rather than treating the operator's explicit request as an error.
+      const latestRef = db
+        .prepare<{ current_session_ref: string | null }, [string]>(
+          "SELECT current_session_ref FROM cohorts WHERE id = ?",
+        )
+        .get(cohort.id)?.current_session_ref;
+      if (latestRef && dispatcher.status) {
+        const status = await dispatcher.status("build", latestRef);
+        if (status === "running") return c.json({ session_ref: latestRef });
+      }
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to dispatch build" }, 500);
+    } finally {
+      dispatching.delete(cohort.id);
+    }
+  });
+}
