diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1376b11781b2fa06b1a32ef8bc14c2ebc37aeb62
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,55 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+
+function fixture(status = "approved") {
+  const db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES (?, ?, ?)").run("p", "project", "/repo");
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES (?, ?, ?)").run("s", "p", "spec");
+  db.prepare("INSERT INTO plans (id, spec_id) VALUES (?, ?)").run("pl", "s");
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position) VALUES (?, ?, ?, ?)").run("c", "pl", "cohort", 0);
+  db.prepare("INSERT INTO briefs (id, cohort_id, goal, status) VALUES (?, ?, ?, ?)").run("b", "c", "goal", status);
+  return db;
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("returns 404 when the brief is missing", async () => {
+    const db = fixture();
+    const app = new Hono();
+    mountBuildsRoutes(app, { db, dispatcher: { dispatch: async () => "sid" } });
+    const response = await app.request("/briefs/missing/build", { method: "POST" });
+    expect(response.status).toBe(404);
+    db.close();
+  });
+
+  test("requires an approved brief", async () => {
+    const db = fixture("pending_approval");
+    const app = new Hono();
+    mountBuildsRoutes(app, { db, dispatcher: { dispatch: async () => "sid" } });
+    const response = await app.request("/briefs/b/build", { method: "POST" });
+    expect(response.status).toBe(409);
+    db.close();
+  });
+
+  test("dispatches an approved brief and returns its session reference", async () => {
+    const db = fixture();
+    const calls: string[][] = [];
+    const app = new Hono();
+    mountBuildsRoutes(app, { db, dispatcher: { dispatch: async (stage, id) => { calls.push([stage, id]); return "session-1"; } } });
+    const response = await app.request("/briefs/b/build", { method: "POST" });
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ session_ref: "session-1" });
+    expect(calls).toEqual([["build", "b"]]);
+    db.close();
+  });
+
+  test("rejects a cohort that already has a running build", async () => {
+    const db = fixture();
+    const app = new Hono();
+    mountBuildsRoutes(app, { db, dispatcher: { dispatch: async () => "sid", isBuildRunning: async () => true } });
+    const response = await app.request("/briefs/b/build", { method: "POST" });
+    expect(response.status).toBe(409);
+    db.close();
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..963f1d0eb1f7e6142ee3de7c73cf44a54dad5ef9
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,53 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import { getBrief } from "../../db/briefs";
+
+export interface BuildDispatcher {
+  dispatch(stageName: string, inputId: string): Promise<string>;
+  /** True only when a build session tracked for this cohort is still live. */
+  isBuildRunning?(cohortId: string): Promise<boolean>;
+}
+
+interface BuildsRouteDeps {
+  dispatcher: BuildDispatcher;
+  db: Database;
+}
+
+/** Mounts the explicit operator-triggered build endpoint. */
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildsRouteDeps): void {
+  // Also protects concurrent requests while the dispatcher is spawning a session.
+  const dispatching = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "brief not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    const cohort = db
+      .prepare<{ id: string }, [string]>("SELECT id FROM cohorts WHERE id = ?")
+      .get(brief.cohort_id);
+    if (!cohort) return c.json({ error: "cohort not found" }, 404);
+
+    // Reserve synchronously before the first await, so simultaneous requests
+    // cannot both pass the in-process concurrency guard.
+    if (dispatching.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+    dispatching.add(brief.cohort_id);
+    try {
+      if (dispatcher.isBuildRunning && await dispatcher.isBuildRunning(brief.cohort_id)) {
+        return c.json({ error: "a build is already running for this cohort" }, 409);
+      }
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "failed to start build" }, 500);
+    } finally {
+      dispatching.delete(brief.cohort_id);
+    }
+  });
+}
