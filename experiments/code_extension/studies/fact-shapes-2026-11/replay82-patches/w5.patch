diff --git a/kbbl/core/server/handlers/builds.test.ts b/kbbl/core/server/handlers/builds.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3941515f46a00ddfe6a29decb7be46d9e580f216
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.test.ts
@@ -0,0 +1,56 @@
+import { describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import { mountBuildsRoutes } from "./builds";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+
+function fixture(dispatcher: Dispatcher) {
+  const db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES (?, ?, ?)").run("p", "P", "/tmp/p");
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES (?, ?, ?)").run("s", "p", "S");
+  db.prepare("INSERT INTO plans (id, spec_id, status) VALUES (?, ?, 'approved')").run("pl", "s");
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position, status) VALUES (?, ?, ?, ?, 'building')").run("c", "pl", "C", 0);
+  db.prepare("INSERT INTO briefs (id, cohort_id, status, goal) VALUES (?, ?, 'approved', ?)").run("b", "c", "Goal");
+  const app = new Hono();
+  mountBuildsRoutes(app, { dispatcher, db });
+  return { app, db };
+}
+
+describe("POST /briefs/:id/build", () => {
+  test("404s missing briefs and rejects unapproved briefs", async () => {
+    const dispatcher: Dispatcher = { dispatch: async () => "sid" };
+    const { app, db } = fixture(dispatcher);
+    try {
+      expect((await app.request("/briefs/missing/build", { method: "POST" })).status).toBe(404);
+      db.prepare("UPDATE briefs SET status = 'pending_approval' WHERE id = 'b'").run();
+      expect((await app.request("/briefs/b/build", { method: "POST" })).status).toBe(409);
+    } finally {
+      db.close();
+    }
+  });
+
+  test("dispatches an approved brief, returns its session ref, and blocks an active cohort build", async () => {
+    let dispatches = 0;
+    const dispatcher: Dispatcher = {
+      dispatch: async (stage, id) => {
+        expect(stage).toBe("build");
+        expect(id).toBe("b");
+        dispatches += 1;
+        return "build-session";
+      },
+      status: async () => "running",
+    };
+    const { app, db } = fixture(dispatcher);
+    try {
+      const response = await app.request("/briefs/b/build", { method: "POST" });
+      expect(response.status).toBe(200);
+      expect(await response.json()).toEqual({ session_ref: "build-session" });
+      db.prepare("UPDATE cohorts SET current_session_ref = 'build-session' WHERE id = 'c'").run();
+      const duplicate = await app.request("/briefs/b/build", { method: "POST" });
+      expect(duplicate.status).toBe(409);
+      expect(dispatches).toBe(1);
+    } finally {
+      db.close();
+    }
+  });
+});
diff --git a/kbbl/core/server/handlers/builds.ts b/kbbl/core/server/handlers/builds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b66839ea8999711de38adee1ccf163373eaf847a
--- /dev/null
+++ b/kbbl/core/server/handlers/builds.ts
@@ -0,0 +1,64 @@
+import type { Hono } from "hono";
+import type { Database } from "bun:sqlite";
+import type { Dispatcher } from "../../orchestrator/backends/dispatcher";
+import { getBrief } from "../../db/briefs";
+
+interface BuildRoutesDeps {
+  dispatcher: Dispatcher;
+  db: Database;
+}
+
+/** Registers the explicit build trigger for an approved brief. */
+export function mountBuildsRoutes(app: Hono, { dispatcher, db }: BuildRoutesDeps): void {
+  // Prevent two requests in this process from both passing the persisted
+  // session-ref check while the backend is still starting its session.
+  const dispatchingCohorts = new Set<string>();
+
+  app.post("/briefs/:id/build", async (c) => {
+    const briefId = c.req.param("id");
+    const brief = getBrief(db, briefId);
+    if (!brief) return c.json({ error: "not found" }, 404);
+    if (brief.status !== "approved") {
+      return c.json({ error: "brief must be approved before building" }, 409);
+    }
+
+    const cohort = db
+      .prepare<{ current_session_ref: string | null }, [string]>(
+        "SELECT current_session_ref FROM cohorts WHERE id = ?",
+      )
+      .get(brief.cohort_id);
+    if (!cohort) return c.json({ error: "cohort not found" }, 404);
+
+    if (dispatchingCohorts.has(brief.cohort_id)) {
+      return c.json({ error: "a build is already running for this cohort" }, 409);
+    }
+
+    if (cohort.current_session_ref) {
+      // A persisted reference may point to a completed or archived session.
+      // Ask the configured backend when possible; older/custom dispatchers
+      // without status support conservatively treat a ref as active.
+      let running = true;
+      if (dispatcher.status) {
+        try {
+          running = (await dispatcher.status(cohort.current_session_ref)) === "running";
+        } catch (err) {
+          console.error("builds:session status lookup failed", err);
+        }
+      }
+      if (running) {
+        return c.json({ error: "a build is already running for this cohort" }, 409);
+      }
+    }
+
+    dispatchingCohorts.add(brief.cohort_id);
+    try {
+      const session_ref = await dispatcher.dispatch("build", briefId);
+      return c.json({ session_ref });
+    } catch (err) {
+      console.error("builds:dispatch failed", err);
+      return c.json({ error: "build dispatch failed" }, 500);
+    } finally {
+      dispatchingCohorts.delete(brief.cohort_id);
+    }
+  });
+}
