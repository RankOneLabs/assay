@@ -0,0 +1,65 @@
+import { afterEach, describe, expect, test } from "bun:test";
+import { Hono } from "hono";
+import { openTestDb } from "../../db/test-db";
+import type { Database } from "bun:sqlite";
+import { mountBuildsRoutes } from "./builds";
+
+let db: Database;
+const cohortId = "cohort-build-route";
+const briefId = "brief-build-route";
+
+function setup({ status = "approved", currentSessionRef = null }: { status?: string; currentSessionRef?: string | null } = {}) {
+  db = openTestDb();
+  db.prepare("INSERT INTO projects (id, name, repo_path) VALUES (?, ?, ?)").run("project", "Project", "/tmp/project");
+  db.prepare("INSERT INTO specs (id, project_id, title) VALUES (?, ?, ?)").run("spec", "project", "Spec");
+  db.prepare("INSERT INTO plans (id, spec_id, status) VALUES (?, ?, 'approved')").run("plan", "spec");
+  db.prepare("INSERT INTO cohorts (id, plan_id, title, position, status, current_session_ref) VALUES (?, ?, ?, 0, 'building', ?)")
+    .run(cohortId, "plan", "Cohort", currentSessionRef);
+  db.prepare("INSERT INTO briefs (id, cohort_id, status, goal) VALUES (?, ?, ?, ?)")
+    .run(briefId, cohortId, status, "Goal");
+  const calls: string[][] = [];
+  const app = new Hono();
+  mountBuildsRoutes(app, {
+    db,
+    dispatcher: {
+      dispatch: async (stage, input) => {
+        calls.push([stage, input]);
+        return "new-session-ref";
+      },
+      status: async () => "running",
+    },
+  });
+  return { app, calls };
+}
+
+afterEach(() => db?.close());
+
+describe("POST /briefs/:id/build", () => {
+  test("404 when the brief is missing", async () => {
+    const { app } = setup();
+    const res = await app.request("/briefs/missing/build", { method: "POST" });
+    expect(res.status).toBe(404);
+  });
+
+  test("409 unless the brief is approved", async () => {
+    const { app, calls } = setup({ status: "pending_approval" });
+    const res = await app.request(`/briefs/${briefId}/build`, { method: "POST" });
+    expect(res.status).toBe(409);
+    expect(calls).toHaveLength(0);
+  });
+
+  test("409 while a build session is running for the cohort", async () => {
+    const { app, calls } = setup({ currentSessionRef: "existing-session" });
+    const res = await app.request(`/briefs/${briefId}/build`, { method: "POST" });
+    expect(res.status).toBe(409);
+    expect(calls).toHaveLength(0);
+  });
+
+  test("dispatches build and returns the session reference", async () => {
+    const { app, calls } = setup();
+    const res = await app.request(`/briefs/${briefId}/build`, { method: "POST" });
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ session_ref: "new-session-ref" });
+    expect(calls).toEqual([["build", briefId]]);
+  });
+});
