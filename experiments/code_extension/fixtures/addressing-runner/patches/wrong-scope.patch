+/** The addressing view, like the coverage view, has its own digest and precedes the captured
+ * source references in the package. */
+function addressingLinkReference(subject: CapturedItem, links: AddressingInput): Result<EvidenceReference, EvidencePackageError> {
+  const digest = canonicalDigest(links);
+  if (!digest.ok) return err({ operation: "evidence_packages", entity_id: subject.occurrence_id,
+    detail: digest.error.detail });
+  return ok({ ref: `addressing_links:${subject.occurrence_id}`, kind: "internal",
+    content: links as unknown as JsonValue, digest: digest.value });
+}
+
+/** The link view a window question's code runner decodes, chosen by the item kind the pinned
+ * inward relation reaches: proposed spec updates for addressing, assessment findings for coverage. */
+function windowLinkReference(subject: CapturedItem, relation: LinkRelation, found: readonly CapturedItem[])
+  : Result<EvidenceReference, EvidencePackageError> {
+  if (relation.item_kind === "proposed_spec_update") {
+    const view = addressingInput(subject, found);
+    return view.ok ? addressingLinkReference(subject, view.value)
+      : err({ operation: "evidence_packages", entity_id: subject.occurrence_id, detail: view.error.detail });
+  }
+  const links = coverageInput(subject, found);
+  return links.ok ? coverageLinkReference(subject, links.value)
+    : err({ operation: "evidence_packages", entity_id: subject.occurrence_id, detail: links.error.detail });
+}
