diff --git a/src/http/operations.ts b/src/http/operations.ts
new file mode 100644
--- /dev/null
+++ b/src/http/operations.ts
@@ -0,0 +1,15 @@
+import type { TypeExpression } from "../core-client/core-types";
+import { OPERATION_REGISTRY } from "../operations/registry";
+
+/** One code operation a workflow may name, as the definition view reads it. */
+export interface OperationView {
+  readonly key: string;
+  readonly input_schema: TypeExpression;
+  readonly output_schema: TypeExpression;
+}
+export interface OperationList { readonly operations: readonly OperationView[] }
+
+/** The body of `GET /api/operations`: the registry, in its own order. */
+export const selectOperationList = (): OperationList => ({
+  operations: OPERATION_REGISTRY.map(({ key, input_schema, output_schema }): OperationView => ({ key, input_schema, output_schema })),
+});
