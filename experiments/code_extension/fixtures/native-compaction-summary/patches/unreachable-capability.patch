diff --git a/src/acp/session-summary.ts b/src/acp/session-summary.ts
--- a/src/acp/session-summary.ts
+++ b/src/acp/session-summary.ts
@@ -23,6 +23,48 @@
 export interface SessionSummaryGenerator {
   readonly method: TerminalSessionSummary["method"];
   generate(request: SessionSummaryRequest): Promise<Result<TerminalSessionSummaryDraft, SessionSummaryFailure>>;
+}
+
+/**
+ * The agent's own context compaction (ACP `compaction_update`). The latest
+ * compaction completed in the final turn is the handoff: the summary on its
+ * completed update is authoritative, and without one its own streamed
+ * chunks are. Unfinished or failed compactions never count.
+ */
+export class NativeCompactionSummaryGenerator implements SessionSummaryGenerator {
+  readonly method = "native_compaction" as const;
+
+  async generate(request: SessionSummaryRequest): Promise<Result<TerminalSessionSummaryDraft, SessionSummaryFailure>> {
+    const finalTurn = request.events.slice(
+      request.events.reduce((found, event, index) => event.kind === "user_message" ? index : found, -1) + 1,
+    );
+    const completed = [...finalTurn].reverse().find(
+      (event): event is Extract<AcpUiEvent, { kind: "compaction" }> => event.kind === "compaction",
+    );
+    if (!completed) {
+      return { ok: false, error: summaryFailure(this.method, request.session_id, "the final turn completed no compaction") };
+    }
+    const content = completed.summary !== null && completed.summary.length > 0
+      ? completed.summary
+      : finalTurn
+        .filter((event): event is Extract<AcpUiEvent, { kind: "compaction_chunk" }> =>
+          event.kind === "compaction_chunk" && event.compactionId === completed.compactionId)
+        .flatMap((event) => event.content);
+    const markdown = content.map((part) => part.text).join("").trim();
+    if (!markdown) {
+      return { ok: false, error: summaryFailure(this.method, request.session_id, "the completed compaction retained no summary") };
+    }
+    return {
+      ok: true,
+      value: {
+        schema_version: 1,
+        session_id: request.session_id,
+        method: this.method,
+        produced_at: request.produced_at,
+        markdown,
+      },
+    };
+  }
 }
 
