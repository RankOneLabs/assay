+/** Package each supported subject item on its own, from the subject slots alone. Nothing is
+ * walked, so a subject that declares no links is packaged like any other. */
+function subjectOnlyPackages({ subjects, question, recipe }: BuilderInput): Result<PackageBatch, RunPackageError> {
+  const packages: PilotPackage[] = [];
+  const own = slotsFrom(recipeSlots(recipe), "subject");
+  for (const host of subjects) {
+    for (const subject of host.items.filter((item) => item.item_kind === recipe.subject.item_kind)) {
+      const references = collectReferences(own.map((slot) => reference(slot.role, host.artifact_kind, subject)));
+      if (!references.ok) return references;
+      const evidence = packagedEvidenceSet(question.question_id, references.value, null);
+      if (!evidence.ok) return evidence;
+      packages.push({ question_id: question.question_id, subject, revision_id: host.revision_id, evidence: evidence.value });
+    }
+  }
+  return ok({ packages, exclusions: [], eligibility: [] });
+}
