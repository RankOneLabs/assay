@@ -105,10 +105,26 @@ const repositoryProvisioningStageTypeCompiler: StageTypeCompiler = {
   },
 };
 
+// Pass-through has no executor options: reject every JSON object key rather
+// than stripping unknown options and accepting a configuration with no meaning.
+const passThroughStageTypeCompiler: StageTypeCompiler = {
+  compile(stageKey, rawConfig) {
+    if (rawConfig === null || typeof rawConfig !== "object" || Array.isArray(rawConfig) || Object.keys(rawConfig).length !== 0) {
+      return err({ operation: "compile_workflow", stage_key: stageKey, detail: "pass_through config must be an empty JSON object" });
+    }
+    return ok({
+      definition_config: rawConfig,
+      materialization: { kind: "scalar" },
+      output_release: () => ({ kind: "immediate" }),
+    });
+  },
+};
+
 export type StageTypeCompilerRegistry = Readonly<Record<string, StageTypeCompiler>>;
 
 const availableCompilers: StageTypeCompilerRegistry = {
   delegated_session: delegatedSessionStageTypeCompiler,
+  pass_through: passThroughStageTypeCompiler,
   [PROVISION_REPOSITORY_REFS_STAGE_TYPE]: repositoryProvisioningStageTypeCompiler,
 };
 const builtInStageTypeCompilers: StageTypeCompilerRegistry = configureStagePlugins(stagePluginConfig, availableCompilers);
