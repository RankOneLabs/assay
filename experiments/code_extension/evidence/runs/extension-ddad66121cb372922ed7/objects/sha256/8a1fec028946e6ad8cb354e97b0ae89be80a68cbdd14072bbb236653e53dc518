index 0000000000000000000000000000000000000000..0abba262038593fb585eecbf0f960049989cd9ae
--- /dev/null
+++ b/src/compiler/pass-through.ts
@@ -0,0 +1,20 @@
+import { z } from "zod";
+
+import { err, ok } from "../domain/primitives";
+import type { StageTypeCompiler } from "./compile-workflow";
+
+// No executor options are meaningful for this stage. Reject unknown keys
+// rather than stripping them and silently accepting a different contract.
+const passThroughDefinitionSchema = z.strictObject({});
+
+export const passThroughCompiler: StageTypeCompiler = {
+  compile(stageKey, rawConfig) {
+    const parsed = passThroughDefinitionSchema.safeParse(rawConfig);
+    if (!parsed.success) return err({ operation: "compile_workflow", stage_key: stageKey, detail: parsed.error.message });
+    return ok({
+      definition_config: parsed.data,
+      materialization: { kind: "scalar" },
+      output_release: () => ({ kind: "immediate" }),
+    });
+  },
+};
