{
  "$defs": {
    "ArchitectureDeltasV2": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "$ref": "#/$defs/SystemArchitectureDeltas"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ComponentDelta"
          },
          "title": "Components",
          "type": "array"
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/ModuleCouplingDeltaV2"
          },
          "title": "Modules",
          "type": "array"
        },
        "boundaries": {
          "items": {
            "$ref": "#/$defs/BoundaryPairDelta"
          },
          "title": "Boundaries",
          "type": "array"
        }
      },
      "required": [
        "system",
        "components",
        "modules",
        "boundaries"
      ],
      "title": "ArchitectureDeltasV2",
      "type": "object"
    },
    "ArchitectureReportV4": {
      "additionalProperties": false,
      "description": "The 0.3.0 architecture shape over a graph whose modules name their language.",
      "properties": {
        "graph": {
          "$ref": "#/$defs/ModuleGraphV2"
        },
        "module_count": {
          "title": "Module Count",
          "type": "integer"
        },
        "first_party_edge_count": {
          "title": "First Party Edge Count",
          "type": "integer"
        },
        "cross_component_edge_count": {
          "title": "Cross Component Edge Count",
          "type": "integer"
        },
        "module_coupling": {
          "items": {
            "$ref": "#/$defs/ModuleCouplingV4"
          },
          "title": "Module Coupling",
          "type": "array"
        },
        "component_coupling": {
          "items": {
            "$ref": "#/$defs/ComponentCouplingV4"
          },
          "title": "Component Coupling",
          "type": "array"
        },
        "module_components": {
          "items": {
            "$ref": "#/$defs/ModuleComponentV2"
          },
          "title": "Module Components",
          "type": "array"
        },
        "boundaries": {
          "items": {
            "$ref": "#/$defs/BoundaryPair"
          },
          "title": "Boundaries",
          "type": "array"
        },
        "cycles": {
          "$ref": "#/$defs/CycleReportV4"
        },
        "propagation": {
          "$ref": "#/$defs/PropagationReportV4"
        }
      },
      "required": [
        "graph",
        "module_count",
        "first_party_edge_count",
        "cross_component_edge_count",
        "module_coupling",
        "component_coupling",
        "module_components",
        "boundaries",
        "cycles",
        "propagation"
      ],
      "title": "ArchitectureReportV4",
      "type": "object"
    },
    "BoundaryPair": {
      "additionalProperties": false,
      "properties": {
        "importer_component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Importer Component",
          "type": "string"
        },
        "imported_component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Imported Component",
          "type": "string"
        },
        "edge_count": {
          "title": "Edge Count",
          "type": "integer"
        }
      },
      "required": [
        "importer_component",
        "imported_component",
        "edge_count"
      ],
      "title": "BoundaryPair",
      "type": "object"
    },
    "BoundaryPairDelta": {
      "additionalProperties": false,
      "properties": {
        "importer_component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Importer Component",
          "type": "string"
        },
        "imported_component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Imported Component",
          "type": "string"
        },
        "before": {
          "title": "Before",
          "type": "integer"
        },
        "after": {
          "title": "After",
          "type": "integer"
        },
        "delta": {
          "title": "Delta",
          "type": "integer"
        }
      },
      "required": [
        "importer_component",
        "imported_component",
        "before",
        "after",
        "delta"
      ],
      "title": "BoundaryPairDelta",
      "type": "object"
    },
    "CodeMetricsReportV4": {
      "additionalProperties": false,
      "description": "Absolute snapshot report whose graph and coverage name each module's language.",
      "properties": {
        "schema_version": {
          "const": "assay-code-metrics-report/0.4.0",
          "default": "assay-code-metrics-report/0.4.0",
          "title": "Schema Version",
          "type": "string"
        },
        "existing_metrics": {
          "$ref": "#/$defs/ExistingMetricsV2"
        },
        "architecture": {
          "$ref": "#/$defs/ArchitectureReportV4"
        },
        "coverage": {
          "$ref": "#/$defs/SnapshotCoverageV2"
        },
        "configuration": {
          "$ref": "#/$defs/ResolvedConfiguration"
        },
        "versions": {
          "$ref": "#/$defs/ToolVersions"
        }
      },
      "required": [
        "existing_metrics",
        "architecture",
        "coverage",
        "configuration",
        "versions"
      ],
      "title": "CodeMetricsReportV4",
      "type": "object"
    },
    "ComponentCouplingV4": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Component",
          "type": "string"
        },
        "modules": {
          "items": {
            "pattern": "^[^\\x00-\\x1F\\x7F]+$",
            "type": "string"
          },
          "title": "Modules",
          "type": "array"
        },
        "afferent": {
          "description": "Ca: distinct modules outside the component that directly import one in it.",
          "title": "Afferent",
          "type": "integer"
        },
        "efferent": {
          "description": "Ce: distinct modules outside the component that a module in it directly imports (the imported modules, not the importing members).",
          "title": "Efferent",
          "type": "integer"
        },
        "instability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Ce / (Ca + Ce); null when Ca + Ce is 0.",
          "title": "Instability"
        },
        "internal_edges": {
          "title": "Internal Edges",
          "type": "integer"
        },
        "incoming_edges": {
          "title": "Incoming Edges",
          "type": "integer"
        },
        "outgoing_edges": {
          "title": "Outgoing Edges",
          "type": "integer"
        },
        "module_count": {
          "title": "Module Count",
          "type": "integer"
        },
        "relational_cohesion": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relational Cohesion"
        },
        "internal_dependency_density": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Internal Dependency Density"
        },
        "internal_edge_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Internal Edge Share"
        }
      },
      "required": [
        "component",
        "modules",
        "afferent",
        "efferent",
        "instability",
        "internal_edges",
        "incoming_edges",
        "outgoing_edges",
        "module_count",
        "relational_cohesion",
        "internal_dependency_density",
        "internal_edge_share"
      ],
      "title": "ComponentCouplingV4",
      "type": "object"
    },
    "ComponentDelta": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Component",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/ComponentMetricDeltas"
        }
      },
      "required": [
        "component",
        "metrics"
      ],
      "title": "ComponentDelta",
      "type": "object"
    },
    "ComponentMetricDeltas": {
      "additionalProperties": false,
      "properties": {
        "afferent": {
          "$ref": "#/$defs/CountDelta"
        },
        "efferent": {
          "$ref": "#/$defs/CountDelta"
        },
        "instability": {
          "$ref": "#/$defs/RatioDelta"
        },
        "internal_edges": {
          "$ref": "#/$defs/CountDelta"
        },
        "incoming_edges": {
          "$ref": "#/$defs/CountDelta"
        },
        "outgoing_edges": {
          "$ref": "#/$defs/CountDelta"
        },
        "relational_cohesion": {
          "$ref": "#/$defs/RatioDelta"
        },
        "internal_dependency_density": {
          "$ref": "#/$defs/RatioDelta"
        },
        "internal_edge_share": {
          "$ref": "#/$defs/RatioDelta"
        }
      },
      "required": [
        "afferent",
        "efferent",
        "instability",
        "internal_edges",
        "incoming_edges",
        "outgoing_edges",
        "relational_cohesion",
        "internal_dependency_density",
        "internal_edge_share"
      ],
      "title": "ComponentMetricDeltas",
      "type": "object"
    },
    "CountDelta": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "title": "Before",
          "type": "integer"
        },
        "after": {
          "title": "After",
          "type": "integer"
        },
        "delta": {
          "title": "Delta",
          "type": "integer"
        }
      },
      "required": [
        "before",
        "after",
        "delta"
      ],
      "title": "CountDelta",
      "type": "object"
    },
    "CrossComponentEdgeV2": {
      "additionalProperties": false,
      "properties": {
        "importer": {
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Importer",
          "type": "string"
        },
        "imported": {
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Imported",
          "type": "string"
        },
        "importer_component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Importer Component",
          "type": "string"
        },
        "imported_component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Imported Component",
          "type": "string"
        }
      },
      "required": [
        "importer",
        "imported",
        "importer_component",
        "imported_component"
      ],
      "title": "CrossComponentEdgeV2",
      "type": "object"
    },
    "CycleReportV4": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/StronglyConnectedComponentV2"
          },
          "title": "Components",
          "type": "array"
        },
        "cyclic_component_count": {
          "title": "Cyclic Component Count",
          "type": "integer"
        },
        "modules_in_cycles": {
          "items": {
            "pattern": "^[^\\x00-\\x1F\\x7F]+$",
            "type": "string"
          },
          "title": "Modules In Cycles",
          "type": "array"
        },
        "scc_count": {
          "title": "Scc Count",
          "type": "integer"
        },
        "cyclic_scc_count": {
          "title": "Cyclic Scc Count",
          "type": "integer"
        },
        "cyclic_module_count": {
          "title": "Cyclic Module Count",
          "type": "integer"
        },
        "largest_cyclic_scc_size": {
          "title": "Largest Cyclic Scc Size",
          "type": "integer"
        }
      },
      "required": [
        "components",
        "cyclic_component_count",
        "modules_in_cycles",
        "scc_count",
        "cyclic_scc_count",
        "cyclic_module_count",
        "largest_cyclic_scc_size"
      ],
      "title": "CycleReportV4",
      "type": "object"
    },
    "DetailedMetricDelta": {
      "additionalProperties": false,
      "description": "A metric delta with an explicit shared-file count for legacy MI.",
      "properties": {
        "metric": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Metric",
          "type": "string"
        },
        "before": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "after": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "After"
        },
        "delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delta"
        },
        "provenance": {
          "enum": [
            "absolute_difference",
            "shared_file_mean"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "shared_files": {
          "default": [],
          "items": {
            "pattern": "^[^/\\\\][^\\\\]*$",
            "type": "string"
          },
          "title": "Shared Files",
          "type": "array"
        },
        "shared_file_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shared File Count"
        }
      },
      "required": [
        "metric",
        "before",
        "after",
        "delta",
        "provenance"
      ],
      "title": "DetailedMetricDelta",
      "type": "object"
    },
    "ExistingMetricsV2": {
      "additionalProperties": false,
      "description": "The Python analyzers' metrics over the snapshot's Python files.\n\nEvery analyzer here reads Python only, so each value is null, and the\nmaintainability index map empty, when the snapshot has no Python file.",
      "properties": {
        "radon_sloc": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Radon Sloc"
        },
        "radon_lloc": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Radon Lloc"
        },
        "radon_cc": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Radon Cc"
        },
        "radon_halstead_volume": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Radon Halstead Volume"
        },
        "complexipy_cognitive": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Complexipy Cognitive"
        },
        "grimp_imports": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Grimp Imports"
        },
        "ruff_violations": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ruff Violations"
        },
        "ruff_magic_values": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ruff Magic Values"
        },
        "mypy_errors": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mypy Errors"
        },
        "jscpd_clones": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Jscpd Clones"
        },
        "jscpd_duplicated_lines": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Jscpd Duplicated Lines"
        },
        "maintainability_index": {
          "additionalProperties": false,
          "patternProperties": {
            "^[^/\\\\][^\\\\]*$": {
              "type": "number"
            }
          },
          "title": "Maintainability Index",
          "type": "object"
        },
        "maintainability_index_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maintainability Index Mean"
        }
      },
      "required": [
        "radon_sloc",
        "radon_lloc",
        "radon_cc",
        "radon_halstead_volume",
        "complexipy_cognitive",
        "grimp_imports",
        "ruff_violations",
        "ruff_magic_values",
        "mypy_errors",
        "jscpd_clones",
        "jscpd_duplicated_lines",
        "maintainability_index",
        "maintainability_index_mean"
      ],
      "title": "ExistingMetricsV2",
      "type": "object"
    },
    "ExternalDependencyV2": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Module",
          "type": "string"
        },
        "package": {
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Package",
          "type": "string"
        }
      },
      "required": [
        "module",
        "package"
      ],
      "title": "ExternalDependencyV2",
      "type": "object"
    },
    "ImportEdgeV2": {
      "additionalProperties": false,
      "properties": {
        "importer": {
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Importer",
          "type": "string"
        },
        "imported": {
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Imported",
          "type": "string"
        }
      },
      "required": [
        "importer",
        "imported"
      ],
      "title": "ImportEdgeV2",
      "type": "object"
    },
    "LanguageCoverage": {
      "additionalProperties": false,
      "description": "How much of one language's source the graph extraction reached.\n\n``files_seen`` counts snapshot files with the language's extensions and\n``files_analyzed`` those an analyzer read. A language without a graph\nextractor analyzes none, so every file it sees is without a module.",
      "properties": {
        "language": {
          "enum": [
            "python",
            "rust",
            "typescript"
          ],
          "title": "Language",
          "type": "string"
        },
        "files_seen": {
          "title": "Files Seen",
          "type": "integer"
        },
        "files_analyzed": {
          "title": "Files Analyzed",
          "type": "integer"
        },
        "modules_discovered": {
          "title": "Modules Discovered",
          "type": "integer"
        },
        "files_without_module": {
          "items": {
            "pattern": "^[^/\\\\][^\\\\]*$",
            "type": "string"
          },
          "title": "Files Without Module",
          "type": "array"
        }
      },
      "required": [
        "language",
        "files_seen",
        "files_analyzed",
        "modules_discovered",
        "files_without_module"
      ],
      "title": "LanguageCoverage",
      "type": "object"
    },
    "ModuleComponentV2": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Module",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "pattern": "^[^/\\\\][^\\\\]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Component",
          "type": "string"
        }
      },
      "required": [
        "module",
        "path",
        "component"
      ],
      "title": "ModuleComponentV2",
      "type": "object"
    },
    "ModuleCouplingDeltaV2": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Module",
          "type": "string"
        },
        "fan_in": {
          "$ref": "#/$defs/CountDelta"
        },
        "fan_out": {
          "$ref": "#/$defs/CountDelta"
        }
      },
      "required": [
        "module",
        "fan_in",
        "fan_out"
      ],
      "title": "ModuleCouplingDeltaV2",
      "type": "object"
    },
    "ModuleCouplingV4": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Module",
          "type": "string"
        },
        "fan_in": {
          "description": "Distinct first-party modules that directly import this one.",
          "title": "Fan In",
          "type": "integer"
        },
        "fan_out": {
          "description": "Distinct first-party modules this one directly imports.",
          "title": "Fan Out",
          "type": "integer"
        }
      },
      "required": [
        "module",
        "fan_in",
        "fan_out"
      ],
      "title": "ModuleCouplingV4",
      "type": "object"
    },
    "ModuleEntryV2": {
      "additionalProperties": false,
      "description": "A first-party module, its source path, and the language it is written in.",
      "properties": {
        "module": {
          "pattern": "^[^\\x00-\\x1F\\x7F]+$",
          "title": "Module",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "pattern": "^[^/\\\\][^\\\\]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "language": {
          "enum": [
            "python",
            "rust",
            "typescript"
          ],
          "title": "Language",
          "type": "string"
        }
      },
      "required": [
        "module",
        "path",
        "language"
      ],
      "title": "ModuleEntryV2",
      "type": "object"
    },
    "ModuleGraphV2": {
      "additionalProperties": false,
      "properties": {
        "modules": {
          "items": {
            "$ref": "#/$defs/ModuleEntryV2"
          },
          "title": "Modules",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/ImportEdgeV2"
          },
          "title": "Edges",
          "type": "array"
        },
        "external_dependencies": {
          "items": {
            "$ref": "#/$defs/ExternalDependencyV2"
          },
          "title": "External Dependencies",
          "type": "array"
        }
      },
      "required": [
        "modules",
        "edges",
        "external_dependencies"
      ],
      "title": "ModuleGraphV2",
      "type": "object"
    },
    "ModuleVisibilityV4": {
      "additionalProperties": false,
