{
  "$defs": {
    "Arm": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "worker": {
          "additionalProperties": true,
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "id",
            "version"
          ],
          "title": "Worker",
          "type": "object"
        },
        "intervention": {
          "additionalProperties": true,
          "title": "Intervention",
          "type": "object"
        },
        "conditions": {
          "additionalProperties": true,
          "title": "Conditions",
          "type": "object"
        }
      },
      "required": [
        "id",
        "worker",
        "intervention"
      ],
      "title": "Arm",
      "type": "object"
    },
    "EvaluatorDeclaration": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "identity": {
          "additionalProperties": false,
          "properties": {
            "property": {
              "minLength": 1,
              "title": "Property",
              "type": "string"
            },
            "target": {
              "enum": [
                "input",
                "process",
                "output",
                "outcome"
              ],
              "title": "Target",
              "type": "string"
            },
            "technique": {
              "enum": [
                "deterministic",
                "classifier",
                "llm_judge",
                "human"
              ],
              "title": "Technique",
              "type": "string"
            },
            "evaluation_basis": {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "invariant",
                    "reference_label",
                    "rubric",
                    "human_gold",
                    "downstream_result"
                  ],
                  "title": "Kind",
                  "type": "string"
                },
                "ref": {
                  "minLength": 1,
                  "title": "Ref",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "ref"
              ],
              "title": "EvaluationBasis",
              "type": "object"
            },
            "epistemic_status": {
              "enum": [
                "proxy",
                "ground_truth"
              ],
              "title": "Epistemic Status",
              "type": "string"
            },
            "version": {
              "minLength": 1,
              "title": "Version",
              "type": "string"
            },
            "authority": {
              "enum": [
                "advisory",
                "blocking"
              ],
              "title": "Authority",
              "type": "string"
            }
          },
          "required": [
            "property",
            "target",
            "technique",
            "evaluation_basis",
            "epistemic_status",
            "version",
            "authority"
          ],
          "title": "EvaluatorIdentity",
          "type": "object"
        },
        "payload_schema": {
          "minLength": 1,
          "title": "Payload Schema",
          "type": "string"
        },
        "payload_schema_ref": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Schema Ref",
          "type": "string"
        },
        "basis_ref": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Basis Ref",
          "type": "string"
        },
        "configuration": {
          "additionalProperties": true,
          "title": "Configuration",
          "type": "object"
        },
        "repeats": {
          "minimum": 1,
          "title": "Repeats",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "identity",
        "payload_schema",
        "payload_schema_ref",
        "basis_ref",
        "repeats"
      ],
      "title": "EvaluatorDeclaration",
      "type": "object"
    },
    "Realization": {
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Subject Id",
          "type": "string"
        },
        "arm_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Arm Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "artifact_ref": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Ref",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "arm_id",
        "digest",
        "artifact_ref"
      ],
      "title": "Realization",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "partition": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Partition",
          "type": "string"
        },
        "payload_ref": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Ref",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "digest",
        "partition",
        "payload_ref"
      ],
      "title": "Subject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "assay-study-snapshot/0.1.0",
      "default": "assay-study-snapshot/0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "subjects": {
      "items": {
        "$ref": "#/$defs/Subject"
      },
      "minItems": 1,
      "title": "Subjects",
      "type": "array"
    },
    "arms": {
      "items": {
        "$ref": "#/$defs/Arm"
      },
      "minItems": 1,
      "title": "Arms",
      "type": "array"
    },
    "realizations": {
      "items": {
        "$ref": "#/$defs/Realization"
      },
      "title": "Realizations",
      "type": "array"
    },
    "evaluators": {
      "items": {
        "$ref": "#/$defs/EvaluatorDeclaration"
      },
      "minItems": 1,
      "title": "Evaluators",
      "type": "array"
    },
    "paa_task_ref": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Paa Task Ref",
      "type": "string"
    },
    "paa_scope": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Paa Scope"
    },
    "task_schema_ref": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Task Schema Ref",
      "type": "string"
    },
    "evidence_schema_ref": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Schema Ref",
      "type": "string"
    },
    "operating_schema_ref": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operating Schema Ref",
      "type": "string"
    },
    "pricing_catalog_ref": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Pricing Catalog Ref",
      "type": "string"
    },
    "pricing_assumptions": {
      "additionalProperties": true,
      "title": "Pricing Assumptions",
      "type": "object"
    }
  },
  "required": [
    "subjects",
    "arms",
    "realizations",
    "evaluators",
    "paa_task_ref",
    "task_schema_ref",
    "evidence_schema_ref",
    "operating_schema_ref",
    "pricing_catalog_ref"
  ],
  "title": "StudySnapshot",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assay.dev/schemas/assay-study-snapshot.schema.json"
}
