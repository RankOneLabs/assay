{
  "$defs": {
    "ArchitectureDeltas": {
      "additionalProperties": false,
      "description": "Before, after, and difference for architecture scalars, without interpretation.\n\nComponents and modules appear only when both sides have them; a boundary\npair appears when either side has it, its edge count zero on the other.",
      "properties": {
        "system": {
          "$ref": "#/$defs/SystemArchitectureDeltas"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ComponentDelta"
          },
          "title": "Components",
          "type": "array"
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/ModuleCouplingDelta"
          },
          "title": "Modules",
          "type": "array"
        },
        "boundaries": {
          "items": {
            "$ref": "#/$defs/BoundaryPairDelta"
          },
          "title": "Boundaries",
          "type": "array"
        }
      },
      "required": [
        "system",
        "components",
        "modules",
        "boundaries"
      ],
      "title": "ArchitectureDeltas",
      "type": "object"
    },
    "ArchitectureReportV3": {
      "additionalProperties": false,
      "description": "The 0.3.0 architecture shape with graph-level counts.\n\n``first_party_edge_count`` counts every first-party module-to-module edge;\n``cross_component_edge_count`` counts those whose two ends have different\nowning components (``unassigned`` included as an owner).",
      "properties": {
        "graph": {
          "$ref": "#/$defs/ModuleGraph"
        },
        "module_count": {
          "title": "Module Count",
          "type": "integer"
        },
        "first_party_edge_count": {
          "title": "First Party Edge Count",
          "type": "integer"
        },
        "cross_component_edge_count": {
          "title": "Cross Component Edge Count",
          "type": "integer"
        },
        "module_coupling": {
          "items": {
            "$ref": "#/$defs/ModuleCouplingV3"
          },
          "title": "Module Coupling",
          "type": "array"
        },
        "component_coupling": {
          "items": {
            "$ref": "#/$defs/ComponentCouplingV3"
          },
          "title": "Component Coupling",
          "type": "array"
        },
        "module_components": {
          "items": {
            "$ref": "#/$defs/ModuleComponent"
          },
          "title": "Module Components",
          "type": "array"
        },
        "boundaries": {
          "items": {
            "$ref": "#/$defs/BoundaryPair"
          },
          "title": "Boundaries",
          "type": "array"
        },
        "cycles": {
          "$ref": "#/$defs/CycleReportV3"
        },
        "propagation": {
          "$ref": "#/$defs/PropagationReportV3"
        }
      },
      "required": [
        "graph",
        "module_count",
        "first_party_edge_count",
        "cross_component_edge_count",
        "module_coupling",
        "component_coupling",
        "module_components",
        "boundaries",
        "cycles",
        "propagation"
      ],
      "title": "ArchitectureReportV3",
      "type": "object"
    },
    "BoundaryPair": {
      "additionalProperties": false,
