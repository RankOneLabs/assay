      "title": "CodeMetricsReportV3",
      "type": "object"
    },
    "ComponentCouplingV3": {
      "additionalProperties": false,
      "description": "Coupling and cohesion of one component, with the coupling semantics stated.",
      "properties": {
        "component": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Component",
          "type": "string"
        },
        "modules": {
          "items": {
            "pattern": "^[^\\x00-\\x40\\x5B-\\x5E\\x60\\x7B-\\x7F][^\\x00-\\x2F\\x3A-\\x40\\x5B-\\x5E\\x60\\x7B-\\x7F]*(\\.[^\\x00-\\x40\\x5B-\\x5E\\x60\\x7B-\\x7F][^\\x00-\\x2F\\x3A-\\x40\\x5B-\\x5E\\x60\\x7B-\\x7F]*)*$",
            "type": "string"
          },
          "title": "Modules",
          "type": "array"
        },
        "afferent": {
          "description": "Ca: distinct modules outside the component that directly import one in it.",
          "title": "Afferent",
          "type": "integer"
        },
        "efferent": {
          "description": "Ce: distinct modules outside the component that a module in it directly imports (the imported modules, not the importing members).",
          "title": "Efferent",
          "type": "integer"
        },
        "instability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Ce / (Ca + Ce); null when Ca + Ce is 0.",
          "title": "Instability"
        },
        "internal_edges": {
          "title": "Internal Edges",
          "type": "integer"
        },
        "incoming_edges": {
          "title": "Incoming Edges",
          "type": "integer"
        },
        "outgoing_edges": {
          "title": "Outgoing Edges",
          "type": "integer"
        },
        "module_count": {
          "title": "Module Count",
          "type": "integer"
        },
        "relational_cohesion": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relational Cohesion"
        },
        "internal_dependency_density": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Internal Dependency Density"
        },
        "internal_edge_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Internal Edge Share"
        }
      },
      "required": [
        "component",
        "modules",
        "afferent",
        "efferent",
        "instability",
        "internal_edges",
        "incoming_edges",
        "outgoing_edges",
        "module_count",
        "relational_cohesion",
        "internal_dependency_density",
        "internal_edge_share"
      ],
      "title": "ComponentCouplingV3",
      "type": "object"
    },
