    "DetailedMetricDelta": {
      "additionalProperties": false,
      "description": "A metric delta with an explicit shared-file count for legacy MI.",
      "properties": {
        "metric": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Metric",
          "type": "string"
        },
        "before": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "after": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "After"
        },
        "delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delta"
        },
        "provenance": {
          "enum": [
            "absolute_difference",
            "shared_file_mean"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "shared_files": {
          "default": [],
          "items": {
            "pattern": "^[^/\\\\][^\\\\]*$",
            "type": "string"
          },
          "title": "Shared Files",
          "type": "array"
        },
        "shared_file_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shared File Count"
        }
      },
      "required": [
        "metric",
        "before",
        "after",
        "delta",
        "provenance"
      ],
      "title": "DetailedMetricDelta",
      "type": "object"
    },
