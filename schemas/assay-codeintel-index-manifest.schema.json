{
  "$defs": {
    "AstStructure": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "file_path": {
          "minLength": 1,
          "title": "File Path",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "parent_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Kind"
        }
      },
      "required": [
        "kind",
        "file_path",
        "start_line",
        "end_line"
      ],
      "title": "AstStructure",
      "type": "object"
    },
    "ContextItem": {
      "additionalProperties": false,
      "description": "Source provenance required to audit what a session could retrieve.",
      "properties": {
        "repo_revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repo Revision",
          "type": "string"
        },
        "file_path": {
          "minLength": 1,
          "title": "File Path",
          "type": "string"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "retrieval_method": {
          "minLength": 1,
          "title": "Retrieval Method",
          "type": "string"
        },
        "rank": {
          "minimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "approximate_tokens": {
          "minimum": 0,
          "title": "Approximate Tokens",
          "type": "integer"
        },
        "raw_source_ref": {
          "minLength": 1,
          "title": "Raw Source Ref",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        }
      },
      "required": [
        "repo_revision",
        "file_path",
        "retrieval_method",
        "rank",
        "content_hash",
        "approximate_tokens",
        "raw_source_ref"
      ],
      "title": "ContextItem",
      "type": "object"
    },
    "SymbolDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "file_path": {
          "minLength": 1,
          "title": "File Path",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature"
        }
      },
      "required": [
        "name",
        "kind",
        "file_path",
        "start_line",
        "end_line"
      ],
      "title": "SymbolDefinition",
      "type": "object"
    },
    "SymbolReference": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "file_path": {
          "minLength": 1,
          "title": "File Path",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "column": {
          "minimum": 1,
          "title": "Column",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "file_path",
        "line",
        "column"
      ],
      "title": "SymbolReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One index for one subject tree, including its cache-key inputs.\n\n``snapshot_digest`` hashes the ``dict[str, str]`` returned by\n``Rung.subject_tree`` (ladder.py:32) with ``canonical_json`` and\n``digest_bytes`` (assay/canonical.py:35-44). ``indexed_paths`` excludes\n``Rung.hidden_test`` (ladder.py:36); coverage consumes\n``Rung.omission_paths`` (ladder.py:34).",
  "properties": {
    "schema_version": {
      "const": "assay-codeintel-index-manifest/0.1.0",
      "default": "assay-codeintel-index-manifest/0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "repo_revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repo Revision",
      "type": "string"
    },
    "snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Snapshot Digest",
      "type": "string"
    },
    "image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Image Digest",
      "type": "string"
    },
    "indexer_version": {
      "minLength": 1,
      "title": "Indexer Version",
      "type": "string"
    },
    "cache_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Cache Key",
      "type": "string"
    },
    "indexed_paths": {
      "items": {
        "type": "string"
      },
      "title": "Indexed Paths",
      "type": "array"
    },
    "items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContextItem"
      },
      "title": "Items",
      "type": "array"
    },
    "definitions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SymbolDefinition"
      },
      "title": "Definitions",
      "type": "array"
    },
    "references": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SymbolReference"
      },
      "title": "References",
      "type": "array"
    },
    "structures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AstStructure"
      },
      "title": "Structures",
      "type": "array"
    },
    "tool_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tool Versions",
      "type": "object"
    },
    "build_time_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Build Time Ms",
      "type": "number"
    }
  },
  "required": [
    "repo_revision",
    "snapshot_digest",
    "image_digest",
    "indexer_version",
    "cache_key",
    "indexed_paths"
  ],
  "title": "IndexManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assay.dev/schemas/assay-codeintel-index-manifest.schema.json"
}
