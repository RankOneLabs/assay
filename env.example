# Copy to .env and supply your OpenRouter key locally. Never commit real keys.
# The runtime reads process environment variables; .env is not loaded automatically.
OPENROUTER_API_KEY=

# Both of these are required, together with a real qualification inventory_ref
# and an explicit allow_paid=True on the specific run_pier_* call being
# authorized, before any paid Pier profile runs. Setting either one alone
# authorizes nothing. See docs/pier-integration.md. Never set these in CI.
ASSAY_ALLOW_PAID_PIER=
